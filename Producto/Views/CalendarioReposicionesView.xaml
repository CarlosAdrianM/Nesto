<UserControl x:Class="Nesto.Modules.Producto.Views.CalendarioReposicionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:CalendarioReposicionesViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- NestoAPI#577: el calendario de reposiciones de tiendas. Lo ve cualquiera; lo cambian quienes deja la API. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Vuelve a leer el calendario (se pierde lo que no se haya guardado)" />
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="16,2" Margin="12,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding PuedeEditar, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Guarda las filas cambiadas o nuevas (en negrita)" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8">
            <Run Text="Cada fila es una ruta en un día de llegada: a la hora de cierre se rellena sola la reposición, y llega al destino a la hora de llegada. Para quitar un día, desmarca «Activa» (no se borra)." />
            <LineBreak />
            <Run Text="{Binding Ayuda, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding PuedeEditar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Añadir día:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="de" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="70" ItemsSource="{x:Static viewmodels:CalendarioReposicionesViewModel.Almacenes}" SelectedItem="{Binding NuevoOrigen}" />
            <TextBlock Text="a" VerticalAlignment="Center" Margin="6,0,4,0" />
            <ComboBox Width="70" ItemsSource="{x:Static viewmodels:CalendarioReposicionesViewModel.Almacenes}" SelectedItem="{Binding NuevoDestino}" />
            <TextBlock Text="que llega el" VerticalAlignment="Center" Margin="6,0,4,0" />
            <ComboBox Width="110" ItemsSource="{x:Static viewmodels:CalendarioReposicionesViewModel.Dias}"
                      DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding NuevoDia}" />
            <Button Content="Añadir" Command="{Binding AnadirCommand}" Padding="12,2" Margin="8,0,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="{Binding SoloLectura}" SelectionUnit="CellOrRowHeader">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Activo}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="ToolTip" Value="Desactivada: ese día no hay reposición" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Modificada}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ruta" Binding="{Binding Ruta, Mode=OneWay}" IsReadOnly="True" />
                <DataGridComboBoxColumn Header="Día de llegada" Width="110"
                                        ItemsSource="{x:Static viewmodels:CalendarioReposicionesViewModel.Dias}"
                                        DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                        SelectedValueBinding="{Binding DiaSemana, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridComboBoxColumn Header="Se cierra" Width="150"
                                        ItemsSource="{x:Static viewmodels:CalendarioReposicionesViewModel.Antelaciones}"
                                        DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                        SelectedValueBinding="{Binding Antelacion, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Hora de cierre" Width="100" Binding="{Binding HoraCierre, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Hora de llegada" Width="110" Binding="{Binding HoraLlegada, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Último cambio" Binding="{Binding Usuario, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaModificacion, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
