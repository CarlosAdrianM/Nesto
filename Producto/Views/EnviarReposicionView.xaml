<UserControl x:Class="Nesto.Modules.Producto.Views.EnviarReposicionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:escaner="clr-namespace:ControlesUsuario.EscanerRemoto;assembly=ControlesUsuario"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:EnviarReposicionViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <!-- Sugerencia 581: Esc sale de la reposición puntual (pregunta si hay algo puesto) -->
        <KeyBinding Key="Escape" Command="{Binding CancelarPuntualCommand}" />
    </UserControl.InputBindings>
    <!-- NestoAPI#553: la tienda prepara la reposición que manda a Algete (la propone el servidor) y la termina. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Enviar reposición a Algete" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Almacen, StringFormat=' desde {0}'}" FontSize="20" />
                <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Content="Preparar reposición" Command="{Binding PrepararCommand}" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding PuedePreparar, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="El servidor propone lo que hay que mandar a Algete (stock máximo, pendientes y stock de los dos almacenes)" />
                <!-- Sugerencia 564: la lista en papel para prepararla a mano -->
                <Button Content="Imprimir" Command="{Binding ImprimirCommand}" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HayReposicion, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Abre un PDF con la reposición para prepararla a mano: ubicación (si la hay), referencia, código de barras, descripción, cantidad y una casilla para marcar" />
                <!-- Sugerencia 581: una reposición aparte con solo lo que piden mandar (la del calendario no cambia) -->
                <!-- Sugerencia 581 (Carlos, 13/10/26): solo los días con viaje, con la de hoy rellena y enviada, y hasta que se marca
                     que el repartidor se la ha llevado; si no, se ve desactivado y dice por qué (al lado y en el tooltip) -->
                <Button Content="Reposición _puntual…" Command="{Binding EmpezarPuntualCommand}" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding MostrarBotonPuntual, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{Binding ToolTipPuntual}" />
                <!-- Sugerencia 581 (Carlos, 13/10/26): el repartidor no pasa siempre a la misma hora: la tienda marca cuándo se la ha llevado -->
                <Button Content="El repartidor ya se la ha llevado" Command="{Binding MarcarRecogidaCommand}" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding MostrarBotonRecogida, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Púlsalo cuando el repartidor se haya llevado la reposición de hoy: desde ese momento ya no se puede hacer otra reposición puntual hoy (lo que quede va en la siguiente)" />
                <!-- Nesto#530: los bultos están creados pero sus etiquetas no han salido (la impresora ha fallado) -->
                <Button Content="Reimprimir etiquetas" Command="{Binding ReimprimirEtiquetasCommand}" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding PuedeReimprimirEtiquetas, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Vuelve a imprimir las etiquetas de los bultos de la última reposición enviada en su impresora de etiquetas" />
                <TextBlock Text="{Binding AvisoPuntual}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420"
                           Visibility="{Binding MostrarBotonPuntual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="Reposición puntual a Algete" FontSize="20" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding EnModoPuntual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <!-- NestoAPI#622: lo que ha hecho hoy la API con la de la tienda (no se ha rellenado y por qué, o se ha sumado a una sin
                 enviar). Sin colores fijos: modo claro y oscuro -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Padding="0,6" Margin="0,8,0,0"
                    Visibility="{Binding HayAvisoAutomatica, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding AvisoAutomatica}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- El lector: si el código está en la lista, el foco va a su cantidad -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="{Binding MostrarLector, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Leer código:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="txtLectura" Width="220" Text="{Binding Lectura, UpdateSourceTrigger=PropertyChanged}"
                     escaner:LectorCodigoBarras.AceptaCodigoBarras="True"
                     ToolTip="Lee el código de barras (o escribe la referencia) y pulsa Intro: el foco va a su cantidad">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding LeerLecturaCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="La cantidad solo se puede bajar (0 para no mandarlo). Intro o salir del campo la guarda." VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"
                       Visibility="{Binding HayReposicion, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="Cada lectura suma (la cantidad también se cambia en la rejilla); Supr quita la línea; Esc sale sin mandar." VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"
                       Visibility="{Binding EnModoPuntual, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Sugerencia 581: las líneas de la reposición puntual (solo en la pantalla hasta mandarla) -->
        <DataGrid x:Name="grdPuntual" Grid.Row="2" ItemsSource="{Binding LineasPuntual}" SelectedItem="{Binding SeleccionadaPuntual}"
                  PreviewKeyDown="GrdPuntual_PreviewKeyDown"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Visibility="{Binding EnModoPuntual, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.RowStyle>
                <!-- Más de lo que hay en la tienda: en negrita y con el aviso (sin colores fijos: modo claro y oscuro) -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FaltaStock}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="ToolTip" Value="No se puede mandar tanto (lo que hay en la tienda menos lo que necesitan sus pedidos): baja la cantidad" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- Sugerencia 599 (Paloma): doble clic en la referencia abre la ficha del producto -->
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doble clic: abre la ficha del producto" />
                            <EventSetter Event="MouseDoubleClick" Handler="Referencia_MouseDoubleClick" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Código de barras" Binding="{Binding CodigoBarras}" IsReadOnly="True" />
                <DataGridTextColumn x:Name="colCantidadPuntual" Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Stock en la tienda" Binding="{Binding StockOrigen}" IsReadOnly="True" />
                <!-- Sugerencia 581 (Carlos, 13/10/26): lo que necesitan los pedidos de la tienda no se manda -->
                <DataGridTextColumn Header="Para sus pedidos" Binding="{Binding Comprometido}" IsReadOnly="True" />
                <DataGridTextColumn Header="Se puede mandar" Binding="{Binding Disponible, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar" Padding="8,0" Focusable="False"
                                    Command="{Binding DataContext.QuitarLineaPuntualCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" ToolTip="Quitar esta línea (Supr)" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding EnModoPuntual, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                <Run Text="Total: " /><Run Text="{Binding UnidadesPuntual, Mode=OneWay}" /><Run Text=" unidades de " /><Run Text="{Binding ProductosPuntual, Mode=OneWay}" /><Run Text=" productos" />
            </TextBlock>
            <Button Content="_Mandar a Algete" Command="{Binding EnviarPuntualCommand}" Padding="16,2" Margin="16,0,0,0"
                    ToolTip="Se crea y se termina de una vez: sale de la tienda y queda pendiente de recibir en Algete, aparte de la del calendario. Alt+M" />
            <Button Content="_Cancelar" Command="{Binding CancelarPuntualCommand}" Padding="16,2" Margin="12,0,0,0"
                    ToolTip="Salir sin mandar nada (Esc)" />
        </StackPanel>

        <DataGrid x:Name="grdLineas" Grid.Row="2" ItemsSource="{Binding Lineas}" SelectedItem="{Binding Seleccionada}"
                  PreviewKeyDown="GrdLineas_PreviewKeyDown"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Visibility="{Binding HayReposicion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.RowStyle>
                <!-- A 0: se queda en gris y se borra al terminar -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstaACero}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="ToolTip" Value="No se manda: se borrará al terminar" />
                        </DataTrigger>
                        <!-- NestoAPI#762: sin código de barras y sin etiquetas: en negrita (sin colores fijos) -->
                        <DataTrigger Binding="{Binding FaltanEtiquetas}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="ToolTip" Value="Este producto no tiene código de barras: imprima sus etiquetas y péguelas en cada unidad antes de enviar (en Algete solo se recibe escaneando)" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- Sugerencia 599 (Paloma): doble clic en la referencia abre la ficha del producto -->
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doble clic: abre la ficha del producto" />
                            <EventSetter Event="MouseDoubleClick" Handler="Referencia_MouseDoubleClick" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Código de barras" Binding="{Binding CodigoBarras}" IsReadOnly="True" />
                <DataGridTextColumn x:Name="colCantidad" Header="Cantidad" Binding="{Binding Cantidad}" />
                <DataGridTextColumn Header="Stock en la tienda" Binding="{Binding StockOrigen}" IsReadOnly="True" />
                <!-- NestoAPI#762: el origen etiqueta lo que no tiene código de barras (EAN-13; si no tiene, el interno 290…) -->
                <DataGridTextColumn Header="Etiquetas" Binding="{Binding CopiasEtiqueta}" />
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Imprimir etiquetas" Padding="8,0" Margin="2,1" Focusable="False"
                                        Command="{Binding DataContext.ImprimirEtiquetasLineaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Imprime en su impresora de etiquetas las etiquetas de código de barras del producto (las de la columna «Etiquetas»; por defecto, una por unidad). Si no tiene código, se le da uno interno" />
                                <TextBlock Text="{Binding AvisoEtiquetas}" VerticalAlignment="Center" Margin="8,0,4,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding HayReposicion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                <Run Text="Total: " /><Run Text="{Binding Unidades, Mode=OneWay}" /><Run Text=" unidades de " /><Run Text="{Binding Productos, Mode=OneWay}" /><Run Text=" productos" />
            </TextBlock>
            <Button Content="Terminar y mandar a Algete" Command="{Binding TerminarCommand}" Padding="16,2" Margin="16,0,0,0"
                    ToolTip="Se pone número de traspaso, sale de la tienda y queda pendiente de recibir en Algete" />
            <!-- NestoAPI#762: lo que no tiene código de barras se etiqueta aquí, en el origen (sin colores fijos) -->
            <Button Content="Imprimir etiquetas de lo que no tiene código" Command="{Binding ImprimirEtiquetasSinCodigoCommand}" Padding="12,2" Margin="16,0,0,0"
                    Visibility="{Binding HayLineasSinEtiquetas, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Imprime de una vez las etiquetas de todos los productos sin código de barras (por defecto, una por unidad que se manda)" />
            <TextBlock Text="{Binding AvisoSinCodigo}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                       Visibility="{Binding HayLineasSinEtiquetas, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
        <!-- Sugerencia 733: las etiquetas de bulto de CUALQUIER reposición por su número (recibida o no, de la tienda o de
             Algete), p. ej. si la impresora se atasca aunque la API las haya mandado bien. Alt+R pone el foco en el número e
             Intro las reimprime. Sin colores fijos: modo claro y oscuro -->
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="0,8,0,0" Margin="0,12,0,0"
                Visibility="{Binding MostrarReimprimirPorNumero, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Label Content="_Reimprimir etiquetas de bulto de la reposición nº" Target="{Binding ElementName=NumeroReimprimirBultosTextBox}"
                       VerticalAlignment="Center" Padding="0,0,6,0" />
                <TextBox x:Name="NumeroReimprimirBultosTextBox" Width="90" VerticalContentAlignment="Center"
                         Text="{Binding NumeroReimprimirBultos, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Número de la reposición (traspaso), p. ej. 81198. También vale la etiqueta de un bulto sin el guion (R81198).">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ReimprimirBultosPorNumeroCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Reimprimir etiquetas de bulto" Command="{Binding ReimprimirBultosPorNumeroCommand}" Padding="12,2" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Vuelve a imprimir en su impresora de etiquetas todas las etiquetas de bulto de esa reposición, aunque ya se haya recibido" />
            </StackPanel>
        </Border>

        <!-- NestoAPI#685: las que han salido de la tienda y aún no se han recibido, para reimprimir los bultos y el impreso en
             cualquier momento (no solo justo después de enviarla). Sin colores fijos: modo claro y oscuro -->
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="0,8,0,0" Margin="0,12,0,0"
                Visibility="{Binding HayEnviadas, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Enviadas, pendientes de recibir" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Enviadas}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Traspaso" Binding="{Binding Traspaso}" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Destino" Binding="{Binding NombreDestino}" />
                        <DataGridTextColumn Header="Productos" Binding="{Binding Lineas}" />
                        <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" />
                        <DataGridTextColumn Header="Bultos" Binding="{Binding Bultos}" />
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Reimprimir bultos" Padding="8,0" Focusable="False"
                                                Command="{Binding DataContext.ReimprimirBultosEnviadaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Vuelve a imprimir las etiquetas de los bultos en su impresora de etiquetas. Si se mandó sin bultos, pregunta cuántos lleva y las imprime." />
                                        <Button Content="Reimprimir impreso" Padding="8,0" Margin="6,0,0,0" Focusable="False"
                                                Command="{Binding DataContext.ReimprimirImpresoEnviadaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Abre el PDF de la reposición (el mismo papel que se imprime para prepararla) para volver a imprimirlo" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
