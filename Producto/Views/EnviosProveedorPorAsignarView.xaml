<UserControl x:Class="Nesto.Modules.Producto.Views.EnviosProveedorPorAsignarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:EnviosProveedorPorAsignarViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1300"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Dato" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- «Sugerido» en verde y negrita -->
        <Style x:Key="Sugerido" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1E7B34" />
        </Style>
        <!-- Un resto (pedido ya recibido en parte) en naranja -->
        <Style x:Key="Lineas" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsResto}" Value="True">
                    <Setter Property="Foreground" Value="#B85C00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Nesto#636 (NestoAPI#857, fase 3): los avisos de agencias que la API no ha sabido asignar a un pedido de compra -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Ayuda}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left" />
            <Border Background="#FFF4E5" BorderBrush="#E0A040" BorderThickness="1" Padding="8,4" Margin="0,0,0,8" HorizontalAlignment="Left"
                    Visibility="{Binding HayAviso, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" MaxWidth="880" />
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Content="Actualizar" Command="{Binding CargarCommand}" Style="{StaticResource Boton}" />
                <TextBlock Text="Correos de los últimos" VerticalAlignment="Center" Margin="12,0,6,6" />
                <ComboBox ItemsSource="{Binding DiasPosibles}" SelectedItem="{Binding Dias}" Width="55" Margin="0,0,6,6" />
                <TextBlock Text="días" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="16,0,0,6"
                           Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left" FontWeight="SemiBold" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding PestanaSeleccionada}">
            <TabItem Header="Por asignar">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" MinWidth="420" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TextoEnvios}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding Envios}" SelectedItem="{Binding EnvioSeleccionado}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Primer correo" Binding="{Binding PrimerCorreo, StringFormat='dd/MM/yy HH:mm'}" Width="95" />
                                <DataGridTextColumn Header="Agencia" Binding="{Binding AgenciaTexto}" Width="*" />
                                <DataGridTextColumn Header="Códigos" Binding="{Binding CodigosTexto}" Width="1.5*" />
                                <DataGridTextColumn Header="Proveedor propuesto" Binding="{Binding ProveedorPropuesto}" Width="*" />
                                <DataGridTextColumn Header="Candidatos" Binding="{Binding CandidatosTexto}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- El envío elegido: sus datos, sus correos y a qué pedido se asigna -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HayEnvioSeleccionado, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                                <Run Text="{Binding EnvioSeleccionado.AgenciaTexto, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding EnvioSeleccionado.CodigosTexto, Mode=OneWay}" />
                            </TextBlock>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Remitente del paquete" Style="{StaticResource Etiqueta}" />
                                    <TextBlock Text="{Binding EnvioSeleccionado.RemitentePaquete}" Style="{StaticResource Dato}" />
                                    <TextBlock Text="Proveedor propuesto" Style="{StaticResource Etiqueta}" />
                                    <TextBlock Text="{Binding EnvioSeleccionado.ProveedorPropuesto}" Style="{StaticResource Dato}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Entrega estimada (según el correo)" Style="{StaticResource Etiqueta}" />
                                    <TextBlock Text="{Binding EnvioSeleccionado.EntregaEstimadaTexto}" Style="{StaticResource Dato}" />
                                    <TextBlock Text="Fecha de recepción que se pondría" Style="{StaticResource Etiqueta}" />
                                    <TextBlock Text="{Binding EnvioSeleccionado.FechaRecepcionPropuestaTexto}" Style="{StaticResource Dato}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Correos del envío" Style="{StaticResource Etiqueta}" Margin="0,10,0,2" />
                            <ItemsControl ItemsSource="{Binding EnvioSeleccionado.Correos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,4">
                                            <StackPanel>
                                                <TextBlock Opacity="0.8" TextWrapping="Wrap">
                                                    <Run Text="{Binding Recibido, StringFormat='dd/MM/yy HH:mm', Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Remitente, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Asunto}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Extracto}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Extracto}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding TextoCandidatos}" Style="{StaticResource Etiqueta}" Margin="0,10,0,2" />
                            <DataGrid ItemsSource="{Binding Candidatos}" SelectedItem="{Binding CandidatoSeleccionado}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" MaxHeight="220"
                                      Visibility="{Binding HayCandidatos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SugeridoTexto}" Style="{StaticResource Sugerido}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Pedido" Binding="{Binding Pedido}" Width="65" />
                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorTexto}" Width="1.5*" />
                                    <DataGridTextColumn Header="Enviado" Binding="{Binding FechaEnvioTexto}" Width="95" />
                                    <DataGridTemplateColumn Header="Líneas" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LineasTexto}" Style="{StaticResource Lineas}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Por qué" Binding="{Binding Motivo}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Expander Header="Otros pedidos en el aire (por si no es ninguno de los candidatos)" IsExpanded="{Binding OtrosDesplegados}" Margin="0,8,0,0">
                                <DataGrid ItemsSource="{Binding OtrosPedidos}" SelectedItem="{Binding OtroPedidoSeleccionado}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" MaxHeight="260" Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pedido" Binding="{Binding Pedido}" Width="65" />
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorTexto}" Width="1.5*" />
                                        <DataGridTextColumn Header="Enviado" Binding="{Binding FechaEnvioTexto}" Width="95" />
                                        <DataGridTemplateColumn Header="Líneas" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LineasTexto}" Style="{StaticResource Lineas}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>

                            <TextBlock Text="{Binding TextoPedidoElegido}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <CheckBox IsChecked="{Binding RecordarRemitente}" Margin="0,6,0,0"
                                      Visibility="{Binding HayRemitentePaquete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="La próxima vez, los avisos de este remitente del paquete se asignarán solos a los pedidos de este proveedor">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Recordar este remitente para este proveedor («" /><Run Text="{Binding EnvioSeleccionado.RemitentePaquete, Mode=OneWay}" /><Run Text="»)" />
                                </TextBlock>
                            </CheckBox>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Asignar a este pedido" Command="{Binding AsignarCommand}" Style="{StaticResource Boton}" FontWeight="SemiBold"
                                        ToolTip="Pone la fecha de recepción en las líneas pendientes del pedido elegido (también para los demás correos del envío)" />
                                <Button Content="No es una compra…" Command="{Binding DescartarCommand}" Style="{StaticResource Boton}"
                                        ToolTip="Descarta el envío (todos sus correos): no se toca ningún pedido" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- La memoria de «quién expide el paquete → de qué proveedor es» -->
            <TabItem Header="Remitentes recordados">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding TextoRemitentes}" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <Button Content="Borrar…" Command="{Binding BorrarRemitenteCommand}" Style="{StaticResource Boton}"
                                ToolTip="Olvida el remitente elegido: sus próximos avisos ya no se asignarán por él" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Remitentes}" SelectedItem="{Binding RemitenteSeleccionado}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Remitente del paquete" Binding="{Binding RemitentePaquete}" Width="2*" />
                            <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="60" />
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="80" />
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaModificacionTexto}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
