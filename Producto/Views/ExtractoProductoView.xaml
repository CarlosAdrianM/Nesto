<UserControl x:Class="Nesto.Modules.Producto.Views.ExtractoProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
             Background="White">
    <!-- Sugerencia 1482 (Manuel, Compras): el extracto del producto, en una ventana aparte. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
        <controles:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" FontWeight="Bold" FontSize="14" Margin="3"/>
        <WrapPanel DockPanel.Dock="Top" Margin="3">
            <TextBlock Text="Referencia:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Producto, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalAlignment="Center"
                     ToolTip="Teclee la referencia y pulse Intro o «Ver»">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CargarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="Almacén:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox ItemsSource="{Binding AlmacenesPropuestos}" Text="{Binding Almacen, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="80"
                      IsEnabled="{Binding PuedeCambiarAlmacen}" ToolTip="Vacío = todos los almacenes"/>
            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <DatePicker SelectedDate="{Binding Desde}" Width="120"/>
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding Hasta}" Width="120"/>
            <Button Content="Ver" Command="{Binding CargarCommand}" MinWidth="70" Margin="12,0,0,0"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="3">
            <TextBlock Text="Saldo inicial: " FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SaldoInicial, StringFormat={}{0:N0}}" Margin="0,0,16,0"/>
            <TextBlock Text="Saldo final: " FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SaldoFinal, StringFormat={}{0:N0}}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding TextoCuantos}" Foreground="DimGray"/>
        </WrapPanel>
        <!-- Quien solo es de Tiendas: la API le devuelve siempre su almacén -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding TextoAlmacenFijado}" FontSize="11" Foreground="DimGray" Margin="3,0,3,3"
                   Visibility="{Binding AlmacenFijadoPorLaApi, Converter={StaticResource BoolAVisibilidad}}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="3">
            <Button Content="Cargar más" Command="{Binding CargarMasCommand}" MinWidth="100"
                    Visibility="{Binding HayMas, Converter={StaticResource BoolAVisibilidad}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="3"/>
        <DataGrid ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" Margin="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}"/>
                <DataGridTextColumn Header="Almacén" Binding="{Binding Almacen}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:N0}}"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat={}{0:N0}}"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=c}"
                                    Visibility="{Binding Data.MostrarImporte, Source={StaticResource Proxy}, Converter={StaticResource BoolAVisibilidad}}"/>
                <DataGridTextColumn Header="Texto" Binding="{Binding Texto}" Width="2*"/>
                <DataGridTextColumn Header="Diario" Binding="{Binding Diario}"/>
                <DataGridTextColumn Header="Albarán" Binding="{Binding Albaran}"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding TextoCliente}" Width="*"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding TextoProveedor}" Width="*"
                                    Visibility="{Binding Data.MostrarProveedor, Source={StaticResource Proxy}, Converter={StaticResource BoolAVisibilidad}}"/>
                <DataGridTextColumn Header="Pedido" Binding="{Binding Pedido}"/>
                <DataGridTextColumn Header="Traspaso" Binding="{Binding Traspaso}"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
