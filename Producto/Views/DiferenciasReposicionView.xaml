<UserControl x:Class="Nesto.Modules.Producto.Views.DiferenciasReposicionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:DiferenciasReposicionViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Nesto#526 (NestoAPI#634): lo recibido que no coincide con lo enviado, pendiente de comprobar en el origen. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Vuelve a leer las diferencias" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Ayuda}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Ver:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" ItemsSource="{x:Static viewmodels:DiferenciasReposicionViewModel.Estados}"
                      DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding Estado}" />
            <TextBlock Text="Almacén de origen:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox Width="160" ItemsSource="{Binding Almacenes}" IsEnabled="{Binding PuedeElegirAlmacen}"
                      DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding Almacen}"
                      ToolTip="Donde hay que comprobarlo: el almacén del que salió la reposición" />
            <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Diferencias}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstaPendiente}" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reposición" Binding="{Binding Traspaso}" />
                <DataGridTextColumn Header="Ruta" Binding="{Binding Ruta}" />
                <!-- Sugerencia 790 (Paloma): doble clic en el producto o en su descripción abre la ficha del producto,
                     como en «Recibir reposición» (sugerencia 599) -->
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doble clic: abre la ficha del producto" />
                            <EventSetter Event="MouseDoubleClick" Handler="Producto_MouseDoubleClick" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doble clic: abre la ficha del producto" />
                            <EventSetter Event="MouseDoubleClick" Handler="Producto_MouseDoubleClick" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Enviado" Binding="{Binding Enviado}" />
                <DataGridTextColumn Header="Leído" Binding="{Binding Leido}" />
                <DataGridTextColumn Header="Diferencia" Binding="{Binding TextoDiferencia}" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
                <DataGridTextColumn Header="Recibida" Binding="{Binding Recepcion}" />
                <DataGridTextColumn Header="Preparó" Binding="{Binding Preparador}" />
                <DataGridTextColumn Header="Ajuste en el origen" Binding="{Binding TextoAjuste}" Width="*" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                <DataGridTextColumn Header="Resolución" Binding="{Binding Resuelta}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- La diferencia elegida: qué pasó, qué comprobar, dónde mirar y cómo resolverla -->
        <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="12" Margin="0,8,0,0"
                Visibility="{Binding HaySeleccionada, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Qué pasó:" FontWeight="SemiBold" Margin="0,0,8,4" />
                <TextBlock Grid.Column="1" Text="{Binding Seleccionada.QuePaso}" TextWrapping="Wrap" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Text="Qué comprobar:" FontWeight="SemiBold" Margin="0,0,8,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Seleccionada.QueComprobar}" TextWrapping="Wrap" Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Text="Salió del hueco:" FontWeight="SemiBold" Margin="0,0,8,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Seleccionada.HuecoSalida, TargetNullValue='—'}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="3" Text="Huecos con stock:" FontWeight="SemiBold" Margin="0,0,8,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Seleccionada.Huecos}" TextWrapping="Wrap" Margin="0,0,0,4" />

                <TextBlock Grid.Row="4" Text="Comentario:" FontWeight="SemiBold" Margin="0,0,8,4"
                           Visibility="{Binding Seleccionada.EstaPendiente, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Comentario, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500" TextWrapping="Wrap" AcceptsReturn="False" Margin="0,0,0,8"
                         ToolTip="Opcional: lo que ha visto al comprobarlo (máximo 500 caracteres)"
                         Visibility="{Binding Seleccionada.EstaPendiente, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                <TextBlock Grid.Row="5" Text="Resolver:" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                           Visibility="{Binding Seleccionada.PuedeResolverse, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Seleccionada.Opciones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Texto}" Padding="12,2" Margin="0,0,8,0"
                                    CommandParameter="{Binding Valor}"
                                    Command="{Binding DataContext.ResolverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="6" Text="Comentario:" FontWeight="SemiBold" Margin="0,4,8,0"
                           Visibility="{Binding Seleccionada.MostrarComentarioResuelto, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Seleccionada.Comentario}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding Seleccionada.MostrarComentarioResuelto, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
