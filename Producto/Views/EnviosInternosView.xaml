<UserControl x:Class="Nesto.Modules.Producto.Views.EnviosInternosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:EnviosInternosViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </UserControl.Resources>
    <!-- Sugerencia 1277 (Carlos 20/11/26): envíos entre sedes que no son reposiciones, con etiqueta EI por bulto -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Ayuda}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left" />
            <Border Background="#FFF4E5" BorderBrush="#E0A040" BorderThickness="1" Padding="8,4" Margin="0,0,0,8" HorizontalAlignment="Left"
                    Visibility="{Binding HayAviso, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" MaxWidth="880" />
            </Border>
        </StackPanel>

        <!-- El alta -->
        <GroupBox Grid.Row="1" Header="Nuevo envío interno" Padding="8" Margin="0,0,0,8" IsEnabled="{Binding PuedeUsar}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Origen:" Style="{StaticResource Etiqueta}" />
                    <ComboBox ItemsSource="{Binding Sedes}" DisplayMemberPath="Nombre" SelectedValuePath="Codigo" SelectedValue="{Binding Origen}"
                              Width="120" Margin="0,0,16,6" />
                    <TextBlock Text="Destino:" Style="{StaticResource Etiqueta}" />
                    <ComboBox ItemsSource="{Binding Sedes}" DisplayMemberPath="Nombre" SelectedValuePath="Codigo" SelectedValue="{Binding Destino}"
                              Width="120" Margin="0,0,16,6" />
                    <TextBlock Text="Bultos:" Style="{StaticResource Etiqueta}" />
                    <TextBox Text="{Binding BultosTexto, UpdateSourceTrigger=PropertyChanged}" Width="50" MaxLength="2" Margin="0,0,16,6"
                             VerticalContentAlignment="Center" ToolTip="De 1 a 50: una etiqueta EI por bulto" />
                </WrapPanel>
                <TextBlock Text="Qué va (por ejemplo, «papel higiénico y café» o el aparato y su número de serie):" Margin="0,0,0,4" />
                <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="44" MaxWidth="700" HorizontalAlignment="Left" Width="700" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="Crear e imprimir etiquetas" Command="{Binding CrearCommand}" Style="{StaticResource Boton}" FontWeight="SemiBold" />
                    <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="10,0,0,6"
                               Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" FontWeight="SemiBold" />
            </StackPanel>
        </GroupBox>

        <!-- La lista y dónde está cada bulto -->
        <DockPanel Grid.Row="2" IsEnabled="{Binding PuedeUsar}">
            <WrapPanel DockPanel.Dock="Top">
                <Button Content="Actualizar" Command="{Binding CargarCommand}" Style="{StaticResource Boton}" />
                <CheckBox Content="Ver también los terminados" IsChecked="{Binding VerTerminados}" VerticalAlignment="Center" Margin="12,0,24,6"
                          ToolTip="Los entregados y anulados de los últimos días" />
                <Button Content="Reimprimir etiquetas" Command="{Binding ReimprimirCommand}" Style="{StaticResource Boton}" />
                <Button Content="Anular…" Command="{Binding AnularCommand}" Style="{StaticResource Boton}"
                        ToolTip="Se le pedirá el motivo. No se puede si algún bulto ya está en una furgoneta." />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TextoLista}" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Trayecto" Binding="{Binding Trayecto}" Width="150" />
                    <DataGridTextColumn Header="Qué va" Binding="{Binding Descripcion}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Bultos" Binding="{Binding Bultos}" Width="50" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="85" />
                    <DataGridTextColumn Header="Dónde está cada bulto" Binding="{Binding DondeEstan}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Alta" Binding="{Binding Alta}" Width="1.2*" />
                    <DataGridTextColumn Header="Entrega" Binding="{Binding Entrega}" Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
