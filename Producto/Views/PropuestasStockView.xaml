<UserControl x:Class="Nesto.Modules.Producto.Views.PropuestasStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PropuestasStockViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Nesto#529 (NestoAPI#631): Compras decide cada propuesta mensual de máximo y mínimo del motor de tendencias. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="Mes:" VerticalAlignment="Center" Margin="24,0,6,0" />
            <ComboBox Width="170" ItemsSource="{Binding Meses}" DisplayMemberPath="Texto" SelectedItem="{Binding MesSeleccionado}" />
            <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox Width="130" ItemsSource="{Binding Estados}" DisplayMemberPath="Texto" SelectedItem="{Binding EstadoSeleccionado}" />
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Vuelve a leer las propuestas y el resumen" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Sugerencia 644: filtros por familia, grupo, acción y texto (los filtra la API; el contador cuenta lo filtrado) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Familia:" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Width="150" ItemsSource="{Binding Familias}" DisplayMemberPath="Texto" SelectedItem="{Binding FamiliaSeleccionada}" Margin="0,0,0,4"
                      IsTextSearchEnabled="True" TextSearch.TextPath="Texto" />
            <TextBlock Text="Grupo:" VerticalAlignment="Center" Margin="16,0,6,4" />
            <ComboBox Width="90" ItemsSource="{Binding Grupos}" DisplayMemberPath="Texto" SelectedItem="{Binding GrupoSeleccionado}" Margin="0,0,0,4" />
            <TextBlock Text="Acción:" VerticalAlignment="Center" Margin="16,0,6,4" />
            <ComboBox Width="180" ItemsSource="{Binding Acciones}" DisplayMemberPath="Texto" SelectedItem="{Binding AccionSeleccionada}" Margin="0,0,0,4" />
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="16,0,6,4" />
            <TextBox Width="180" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,0,4"
                     ToolTip="Parte del código o del nombre del producto. Pulse Intro para buscar">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CargarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Quitar filtros" Command="{Binding LimpiarFiltrosCommand}" Padding="12,2" Margin="16,0,0,4" VerticalAlignment="Center"
                    ToolTip="Quita la familia, el grupo, la acción y el texto (no el mes ni el estado)" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding TextoResumen}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Propuestas}" SelectedItem="{Binding PropuestaSeleccionada}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200" />
                    <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" />
                    <DataGridTextColumn Header="Grupo" Binding="{Binding Grupo}" />
                    <DataGridTextColumn Header="Alm." Binding="{Binding Almacen}" />
                    <DataGridTextColumn Header="Fase" Binding="{Binding Fase}" />
                    <DataGridTemplateColumn Header="Acción" SortMemberPath="Accion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Sugerencia 644: al pasar el ratón, qué pasa al aplicarla -->
                                <TextBlock Text="{Binding Accion}" ToolTip="{Binding Consecuencia}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Máx/mín actual" Binding="{Binding MaxMinActual}" />
                    <DataGridTextColumn Header="Máx/mín propuesto" Binding="{Binding MaxMinPropuesto}" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" />
                    <DataGridTextColumn Header="Exceso" Binding="{Binding ExcesoValorado, StringFormat='{}{0:C0}', ConverterCulture=es-ES}" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding NombreEstado}" SortMemberPath="Estado" />
                    <!-- Nesto#535: si está en potenciación, el objetivo y la fecha de revisión -->
                    <DataGridTextColumn Header="Objetivo" Binding="{Binding ObjetivoYFechaPotenciacion}" />
                    <DataGridTemplateColumn Header="Explicación" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Explicacion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Explicacion}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Detalle: la explicación entera (trazabilidad de cada máximo y mínimo) y la decisión -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HayPropuestaSeleccionada, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{Binding PropuestaSeleccionada.ProductoYNombre}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Acción propuesta:" />
                        <Run Text="{Binding PropuestaSeleccionada.Accion, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="· Estado:" />
                        <Run Text="{Binding PropuestaSeleccionada.NombreEstado, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Máximo/mínimo actual:" />
                        <Run Text="{Binding PropuestaSeleccionada.MaxMinActual, Mode=OneWay}" />
                        <Run Text="· propuesto:" />
                        <Run Text="{Binding PropuestaSeleccionada.MaxMinPropuesto, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{Binding PropuestaSeleccionada.TextoDecision}" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic" />

                    <!-- Nesto#535 (NestoAPI#655): cómo va la potenciación (objetivo, fecha de revisión y venta media) -->
                    <Border Background="#FFF3F9F1" BorderBrush="#FFA9CFA0" BorderThickness="1" Padding="8,6" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PropuestaSeleccionada.TextoPotenciacion}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Potenciación de ventas" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PropuestaSeleccionada.TextoPotenciacion}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sugerencia 644: qué pasa exactamente al aplicar la propuesta (lo calcula la API) -->
                    <Border Background="#FFF4F7FB" BorderBrush="#FFB8C7DA" BorderThickness="1" Padding="8,6" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PropuestaSeleccionada.Consecuencia}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Si se aplica" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PropuestaSeleccionada.Consecuencia}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Explicación" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBox Text="{Binding PropuestaSeleccionada.Explicacion, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto" />

                    <StackPanel IsEnabled="{Binding PuedeDecidir}" Margin="0,12,0,0">
                        <TextBlock Text="Decisión" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding PropuestaSeleccionada.EsAjuste, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Máximo:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="70" Text="{Binding StockMaximo, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Mínimo:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <TextBox Width="70" Text="{Binding StockMinimo, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Text="Motivo (obligatorio al rechazar o si cambia el máximo o el mínimo):" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" MaxLength="500" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Aplicar" Command="{Binding AplicarCommand}" Padding="14,2" Margin="0,0,8,4"
                                    ToolTip="Escribe el máximo y el mínimo (o el estado) que se propone" />
                            <Button Content="Rechazar" Command="{Binding RechazarCommand}" Padding="14,2" Margin="0,0,8,4"
                                    ToolTip="No se aplica; el motivo sirve para ajustar las fórmulas" />
                            <Button Content="Posponer" Command="{Binding PosponerCommand}" Padding="14,2" Margin="0,0,8,4"
                                    ToolTip="No se hace nada: vuelve a salir el mes que viene" />
                        </WrapPanel>

                        <TextBlock Text="Silenciar" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <WrapPanel>
                            <ComboBox Width="130" ItemsSource="{Binding MotivosSilencio}" SelectedItem="{Binding MotivoSilencio}" Margin="0,0,8,4"
                                      ToolTip="Por qué se silencia" />
                            <TextBlock Text="hasta" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <DatePicker SelectedDate="{Binding SilenciarHasta}" Width="120" Margin="0,0,8,4"
                                        ToolTip="Como mucho 24 meses" />
                            <Button Content="Silenciar" Command="{Binding SilenciarCommand}" Padding="14,2" Margin="0,0,0,4"
                                    ToolTip="No vuelve a salir como pendiente hasta esa fecha" />
                        </WrapPanel>

                        <!-- Nesto#535 (NestoAPI#655): en vez de liquidar, un plazo para vender más -->
                        <TextBlock Text="Potenciar ventas" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <WrapPanel>
                            <TextBlock Text="Objetivo" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Width="60" Text="{Binding ObjetivoVentaMensual, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,4"
                                     VerticalContentAlignment="Center" ToolTip="Venta que se quiere conseguir, en unidades al mes (obligatorio). Intro para potenciar">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PotenciarCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="uds/mes, revisión el" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <DatePicker SelectedDate="{Binding PotenciarHasta}" Width="120" Margin="0,0,8,4"
                                        ToolTip="Fecha de revisión: por defecto, dentro de 6 meses; como mucho 24" />
                            <Button Content="Potenciar" Command="{Binding PotenciarCommand}" Padding="14,2" Margin="0,0,0,4"
                                    ToolTip="No cambia el stock: hasta la fecha de revisión sale «En potenciación» con la venta media frente al objetivo" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding PropuestaSeleccionada.EsLiquidar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Liquidar" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <WrapPanel>
                                <ComboBox Width="130" ItemsSource="{Binding CanalesLiquidacion}" SelectedItem="{Binding CanalLiquidacion}" Margin="0,0,8,4"
                                          ToolTip="Dónde se liquida" />
                                <Button Content="Liquidar" Command="{Binding LiquidarCommand}" Padding="14,2" Margin="0,0,0,4"
                                        ToolTip="Acepta la liquidación: el máximo pasa a 0; la liquidación la hace usted" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding UltimosCambios}" Margin="12,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
