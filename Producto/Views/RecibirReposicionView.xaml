<UserControl x:Class="Nesto.Modules.Producto.Views.RecibirReposicionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:ControlesUsuario.Behaviors;assembly=ControlesUsuario"
             d:DataContext="{d:DesignInstance Type=viewmodels:RecibirReposicionViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- NestoAPI#553: la tienda recibe la reposición con la misma API que Ariadna. Entra lo leído. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Recibir reposición" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Almacen, StringFormat=' en {0}'}" FontSize="20" />
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Las reposiciones pendientes de entrar en el almacén del usuario -->
        <TextBlock Grid.Row="1" Text="Pendientes de recibir (doble clic para abrir):" Margin="0,0,0,4" />
        <ListBox x:Name="lstPendientes" Grid.Row="2" ItemsSource="{Binding Pendientes}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                        <!-- Sugerencia 581: la que la tienda manda aparte con solo unos productos (sin colores fijos) -->
                        <TextBlock Text="Puntual: la tienda la ha mandado aparte de la del calendario" FontStyle="Italic"
                                   Visibility="{Binding EsPuntual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock>
                            <Run Text="{Binding Lineas, Mode=OneWay}" /><Run Text=" líneas · " /><Run Text="{Binding Unidades, Mode=OneWay}" /><Run Text=" uds" />
                        </TextBlock>
                        <!-- NestoAPI#673: ya se ha dado de alta una parte; más de 2 días así, el aviso en negrita (sin colores fijos) -->
                        <TextBlock Text="{Binding TextoRecibidaEnParte}" FontStyle="Italic"
                                   Visibility="{Binding RecibidaEnParte, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding AvisoRecibidaEnParte}" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="240"
                                   Visibility="{Binding AvisarRecibidaEnParte, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ElegirCommand}"
                              CommandParameter="{Binding ElementName=lstPendientes, Path=SelectedItem}" />
                <KeyBinding Key="Return" Command="{Binding ElegirCommand}"
                            CommandParameter="{Binding ElementName=lstPendientes, Path=SelectedItem}" />
            </ListBox.InputBindings>
        </ListBox>

        <!-- Lo que llega: el lector suma una unidad; los productos sin código se teclean en «Leído» -->
        <WrapPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding Seleccionada.Titulo}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- Nesto#530: la reposición se envió con bultos: lo primero es leer la etiqueta de uno (sin colores fijos) -->
            <TextBlock Text="Lea la etiqueta del bulto (Rxxxxx-n) en el lector" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding EsperandoEtiqueta, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding TextoBultos}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- NestoAPI#673: lo que ya se ha dado de alta de esta reposición -->
            <TextBlock Text="{Binding TextoRecibidaEnParte}" FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- Ariadna#51: lo leído está en el servidor; quién más la está recibiendo (Ariadna u otro Nesto) -->
            <TextBlock Text="{Binding TextoOtrosEquipos}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                       ToolTip="Lo que lee cada uno se suma y se ve en todos los equipos al momento" />
            <TextBlock Text="Lector:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="txtLectura" Width="220" Text="{Binding Lectura, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Lee el código de barras (o escribe la referencia) y pulsa Intro: suma una unidad. Si escribes el nombre, elige el producto en la lista: también suma una unidad. La etiqueta de un bulto (R81010-2) abre su reposición">
                <!-- Sugerencia 545: el buscador de productos de las líneas del pedido. Lo que entra seguido por el lector
                     llega al Intro antes de que el buscador pregunte (espera a que se deje de escribir) -->
                <i:Interaction.Behaviors>
                    <behaviors:AutocompleteBehavior Empresa="{Binding Empresa}" SiempreActivo="True" TipoBusqueda="Producto"
                                                    MinChars="3" DebounceMs="400" MaxResults="10"
                                                    PatronSinBusqueda="^R[0-9]+[^A-Za-z0-9]+[0-9]+$"
                                                    ItemSeleccionado="Lector_ProductoElegido" />
                <!-- Incidencia 787: la etiqueta de un bulto tecleada a mano (R81177-1) no abre la lista de productos -->
                </i:Interaction.Behaviors>
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding LeerLecturaCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Terminar" Command="{Binding TerminarCommand}" Padding="16,2" Margin="12,0,0,0"
                    ToolTip="Entra lo leído y se informa de las diferencias a quien hizo la reposición" />
            <!-- NestoAPI#673: la clienta que viene a recoger lo que pidió el mismo día que llega la reposición -->
            <Button Content="Dar de alta solo lo leído" Command="{Binding RecibirLoLeidoCommand}" Padding="12,2" Margin="12,0,0,0"
                    Visibility="{Binding PuedeRecibirEnParte, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Da de alta ya lo leído (nada que no viniera ni más de lo enviado). El resto de la reposición queda pendiente para recibirlo después: no cuenta como falta" />
            <!-- Sugerencia 564: lo que llega en papel, para comprobarlo a mano -->
            <Button Content="Imprimir" Command="{Binding ImprimirCommand}" Padding="12,2" Margin="12,0,0,0"
                    ToolTip="Abre un PDF con lo que llega para comprobarlo a mano: ubicación (si la hay), referencia, código de barras, descripción, cantidad y una casilla para marcar" />
            <!-- Nesto#534: cuántas etiquetas de producto saca el botón «Imprimir» de cada línea -->
            <TextBlock Text="Etiquetas por línea:" VerticalAlignment="Center" Margin="24,2,6,2" />
            <TextBox Width="40" Text="{Binding CopiasEtiqueta, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     ToolTip="Cuántas etiquetas de código de barras imprime el botón de la columna «Etiqueta» (de 1 a 100)" />
            <!-- Sugerencia 545: encontrar en la lista lo que no entra por el lector y teclear su cantidad en «Leído» -->
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="24,2,6,2" />
            <TextBox Width="200" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtra la lista por referencia o descripción (sin distinguir mayúsculas ni tildes). Vacío, la lista entera">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding LimpiarFiltroCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </WrapPanel>
        <!-- Nesto#530: hasta leer la etiqueta del bulto no se teclea en «Leído» -->
        <DataGrid Grid.Row="2" Grid.Column="2" ItemsSource="{Binding LineasVisibles}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="{Binding EsperandoEtiqueta}">
            <DataGrid.Columns>
                <!-- Sugerencia 599 (Paloma): doble clic en la referencia abre la ficha del producto -->
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doble clic: abre la ficha del producto" />
                            <EventSetter Event="MouseDoubleClick" Handler="Referencia_MouseDoubleClick" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Enviado" Binding="{Binding Enviado}" IsReadOnly="True" />
                <DataGridTextColumn Header="Leído" Binding="{Binding Leido, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Sugerencia 543: «Bien» en verde, faltas y sobras en ámbar, lo que no venía en rojo. Fondos
                     semitransparentes y el texto con su color de siempre: se leen en claro y en oscuro -->
                <DataGridTextColumn Header="" Binding="{Binding Estado}" IsReadOnly="True" MinWidth="80">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoEstado}" Value="Bien">
                                    <Setter Property="Background" Value="#5534A853" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TipoEstado}" Value="Faltan">
                                    <Setter Property="Background" Value="#66F4B400" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TipoEstado}" Value="Sobran">
                                    <Setter Property="Background" Value="#66F4B400" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TipoEstado}" Value="NoVenia">
                                    <Setter Property="Background" Value="#55EA4335" />
                                </DataTrigger>
                                <!-- Seleccionada se queda con su color de estado: el texto, el de siempre (no el blanco de la selección) -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <!-- Nesto#534 (sugerencia 546): la etiqueta de código de barras del producto, en la impresora de etiquetas -->
                <DataGridTemplateColumn Header="Etiqueta">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Imprimir" Padding="8,0" Margin="2,1"
                                    Command="{Binding DataContext.ImprimirEtiquetaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Imprime la etiqueta de código de barras del producto (30 × 20 mm) en su impresora de etiquetas, para pegarla en lo que no tiene un código que se pueda leer" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
