<UserControl x:Class="Nesto.Modules.Producto.Views.CambiarEstadoProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nesto.Modules.Producto.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:CambiarEstadoProductosViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Nesto#624 (NestoAPI#738, sugerencia 793 de Manuel): cambiar el estado de muchos productos a la vez. Toda la lógica está
         en la API: filtro + estado nuevo → vista previa (no cambia nada) → Aplicar -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Elija los productos (por proveedor, familia, grupo, subgrupo o con una lista de referencias; lo que rellene se cumple a la vez) y el estado nuevo. La vista previa no cambia nada: le enseña cómo están, sus avisos y qué pasará al aplicar." />
        </StackPanel>

        <!-- El filtro y el estado nuevo -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Proveedor:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Width="70" Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Número de proveedor" />
            <TextBlock Grid.Column="2" Text="Familia:" VerticalAlignment="Center" Margin="10,0,4,0" />
            <TextBox Grid.Column="3" Width="90" Text="{Binding Familia, UpdateSourceTrigger=PropertyChanged}" ToolTip="Código de la familia" />
            <TextBlock Grid.Column="4" Text="Grupo:" VerticalAlignment="Center" Margin="10,0,4,0" />
            <TextBox Grid.Column="5" Width="50" Text="{Binding Grupo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Código del grupo (p. ej. COS, ACP)" />
            <TextBlock Grid.Column="6" Text="Subgrupo:" VerticalAlignment="Center" Margin="10,0,4,0" />
            <TextBox Grid.Column="7" Width="60" Text="{Binding Subgrupo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Código del subgrupo" />
            <TextBlock Grid.Column="8" Text="Estado nuevo:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,4,0" />
            <ComboBox Grid.Column="9" Width="280" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoNuevo}" DisplayMemberPath="Texto"
                      ToolTip="El estado que tendrán los productos" />
        </Grid>

        <!-- La lista de referencias: se teclea (Intro añade) o se pega una columna de Excel -->
        <Grid Grid.Row="2" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="190">
                <TextBlock Text="Referencias:" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Añadir" Padding="8,0" Margin="4,0,0,0" Command="{Binding AnnadirReferenciasCommand}" />
                    <TextBox x:Name="txtReferencia" Text="{Binding ReferenciaNueva, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Teclee una referencia y pulse Intro, o pegue varias (una por línea, o separadas por espacios o comas)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AnnadirReferenciasCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding TextoReferencias}" Opacity="0.7" Margin="0,2,0,0" />
            </StackPanel>
            <ListBox Grid.Column="1" Width="140" Height="80" Margin="6,0,0,0" ItemsSource="{Binding Referencias}"
                     SelectedItem="{Binding ReferenciaSeleccionada}" ToolTip="Supr quita la referencia elegida">
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding QuitarReferenciaCommand}" />
                </ListBox.InputBindings>
            </ListBox>
            <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Top">
                <Button Content="Quitar" Padding="8,0" Margin="0,0,0,4" Command="{Binding QuitarReferenciaCommand}" />
                <Button Content="Vaciar" Padding="8,0" Command="{Binding VaciarReferenciasCommand}" />
            </StackPanel>
        </Grid>

        <!-- Los botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,4">
            <Button Content="Vista previa" Command="{Binding VistaPreviaCommand}" Padding="14,2" FontWeight="SemiBold" />
            <Button Content="Aplicar" Command="{Binding AplicarCommand}" Padding="14,2" Margin="8,0,0,0" FontWeight="SemiBold"
                    ToolTip="{Binding MotivoNoSePuedeAplicar}" ToolTipService.ShowOnDisabled="True" />
            <TextBlock Text="{Binding MotivoNoSePuedeAplicar}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Lo que falta, el error de la API, los avisos del lote y el resumen -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding Mensaje}" Foreground="DarkRed" TextWrapping="Wrap" FontWeight="SemiBold" />
            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" Padding="6,3" Margin="0,2"
                    Visibility="{Binding HayAvisosLote, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding AvisosLote}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding ResumenVistaPrevia}" FontWeight="SemiBold" Margin="0,2" />
        </StackPanel>

        <!-- La vista previa: las que no se cambian, en gris y con su motivo -->
        <DataGrid Grid.Row="5" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SeCambia}" Value="False">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="70" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                <DataGridTextColumn Header="Estado actual → nuevo" Binding="{Binding CambioEstado}" Width="1.5*" />
                <DataGridTextColumn Header="ALG" Binding="{Binding StockALG}" Width="45" />
                <DataGridTextColumn Header="REI" Binding="{Binding StockREI}" Width="45" />
                <DataGridTextColumn Header="ALC" Binding="{Binding StockALC}" Width="45" />
                <DataGridTextColumn Header="Pdte. recibir" Binding="{Binding PendienteRecibir}" Width="75" />
                <DataGridTemplateColumn Header="Pedidos pdtes." Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NumeroPedidosPendientes}" ToolTip="{Binding DetallePedidosPendientes}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Controles" Binding="{Binding Controles}" Width="85" />
                <DataGridTemplateColumn Header="Sugeridos (mín./máx.)" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sugeridos}" ToolTip="{Binding ExplicacionSugeridos}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Avisos" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Avisos}" ToolTip="{Binding AvisosDetalle}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="No se cambia porque" Binding="{Binding MotivoNoSeCambia}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Lo que ha pasado al aplicar (se puede copiar) -->
        <TextBox Grid.Row="6" Text="{Binding Resultado, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="0,6,0,0" />
    </Grid>
</UserControl>
