<UserControl x:Class="Nesto.Modulos.Producto.ProductoMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nesto.Modulos.Producto"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibilidadPropuestasStock" />
    </UserControl.Resources>
    <Ribbon x:Name="MainMenu" x:FieldModifier="protected internal">
        <RibbonTab x:Name="tabProductos"
                            Header="Productos">
            <RibbonGroup x:Name="grpMantenimiento"
                                Header="Mantenimiento">
                <RibbonButton Label="Ficha" LargeImageSource="Images/FichaProducto.png" Command="{Binding AbrirModuloFichaCommand}" />
            </RibbonGroup>
            <RibbonGroup x:Name="grpReposicion"
                                Header="Reposición">
                <RibbonButton Label="Diarios" LargeImageSource="Images/Diarios.png" Command="{Binding AbrirModuloReposicionCommand}" />
                <RibbonButton Label="Recibir" LargeImageSource="Images/RecibirReposicion.png" Command="{Binding AbrirRecibirReposicionCommand}" />
                <RibbonButton Label="Enviar" LargeImageSource="Images/EnviarReposicion.png" Command="{Binding AbrirEnviarReposicionCommand}" />
                <RibbonButton Label="Calendario" LargeImageSource="Images/Diarios.png" Command="{Binding AbrirCalendarioReposicionesCommand}" />
                <RibbonButton Label="{Binding EtiquetaDiferencias}" ToolTip="{Binding AyudaDiferencias}" LargeImageSource="Images/RecibirReposicion.png" Command="{Binding AbrirDiferenciasReposicionCommand}" />
            </RibbonGroup>
            <!-- Sugerencia 648 (NestoAPI#658): las cifras de la semana de cada tienda, en Excel -->
            <RibbonGroup x:Name="grpTienda"
                                Header="Tienda">
                <RibbonButton Label="Facturado en tienda" ToolTip="Lo facturado en la tienda (cursos incluidos): la semana anterior en Excel por correo, el acumulado del año o el comparativo con años anteriores"
                              LargeImageSource="Images/Diarios.png" Command="{Binding AbrirFacturacionTiendaCommand}" />
            </RibbonGroup>
            <RibbonGroup x:Name="grpAlmacen"
                                Header="Almacén">
                <RibbonButton Label="Etiquetas de hueco" LargeImageSource="Images/Imprimir.png" Command="{Binding AbrirEtiquetasHuecoCommand}" />
                <!-- Nesto#528 (NestoAPI#642): las calles del recorrido de preparación (solo lectura salvo Almacén y Dirección) -->
                <RibbonButton Label="Recorrido" ToolTip="El orden de calles y pasillos del recorrido de preparación del almacén, con su sentido y la vista previa de los tramos"
                              LargeImageSource="Images/Diarios.png" Command="{Binding AbrirRecorridoAlmacenCommand}" />
                <!-- Nesto#635 (NestoAPI#855): confirmar o rechazar las recogidas que piden los vendedores -->
                <RibbonButton Label="Recogidas solicitadas" ToolTip="Las recogidas que piden los vendedores: confirmarlas (se crea la nota de recogida), rechazarlas o anularlas"
                              LargeImageSource="Images/RecibirReposicion.png" Command="{Binding AbrirRecogidasSolicitadasCommand}" />
            </RibbonGroup>
            <!-- Nesto#529 (NestoAPI#631): solo Compras y Dirección ven las propuestas de stock -->
            <!-- Nesto#636: el grupo también para Informática (los envíos por asignar); Propuestas y Cambiar estado siguen solo para Compras y Dirección -->
            <RibbonGroup x:Name="grpCompras"
                                Header="Compras"
                                Visibility="{Binding PuedeVerGrupoCompras, Converter={StaticResource VisibilidadPropuestasStock}}">
                <RibbonButton Label="Propuestas de stock" LargeImageSource="Images/Diarios.png" Command="{Binding AbrirPropuestasStockCommand}" />
                <!-- Nesto#624 (NestoAPI#738): cambio de estado de muchos productos a la vez -->
                <RibbonButton Label="Cambiar estado" ToolTip="Cambiar el estado de muchos productos a la vez (por proveedor, familia, grupo, subgrupo o lista de referencias)"
                              LargeImageSource="Images/FichaProducto.png" Command="{Binding AbrirCambiarEstadoProductosCommand}" />
                <!-- Nesto#636 (NestoAPI#857): los avisos de agencias que la API no ha sabido asignar a un pedido de compra -->
                <RibbonButton Label="Envíos por asignar" ToolTip="Los avisos de las agencias que no se han podido asignar solos a un pedido de compra: asignarlos a su pedido o descartarlos"
                              LargeImageSource="Images/RecibirReposicion.png" Command="{Binding AbrirEnviosProveedorPorAsignarCommand}" />
            </RibbonGroup>
        </RibbonTab>
    </Ribbon>
</UserControl>
