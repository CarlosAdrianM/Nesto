<UserControl x:Class="ControlesUsuario.BultosPedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bultos="clr-namespace:ControlesUsuario.BultosPedido"
             d:DataContext="{d:DesignInstance Type=bultos:BultosPedidoViewModel}"
             mc:Ignorable="d">
    <!-- Nesto#522: los bultos del packing de Ariadna con su foto. Sin bultos no se ve nada. Colores del sistema (modo oscuro). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSi" />
    </UserControl.Resources>
    <StackPanel Margin="3,4,3,4" Visibility="{Binding HayBultos, Converter={StaticResource VisibleSi}, FallbackValue=Collapsed}">
        <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold"
                   ToolTip="Las fotos que hizo el mozo en Ariadna antes de cerrar cada bulto" />
        <ItemsControl ItemsSource="{Binding Grupos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock Text="{Binding Titulo}" FontStyle="Italic"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Visibility="{Binding DataContext.HayVariosEnvios, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleSi}}" />
                        <ItemsControl ItemsSource="{Binding Bultos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="8,1,0,1">
                                        <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="{Binding TieneFoto, Converter={StaticResource VisibleSi}}">
                                            <Hyperlink Command="{Binding VerFotoCommand}" ToolTip="Abre la foto con el visor de imágenes">Ver foto</Hyperlink>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="{Binding TieneFoto, Converter={StaticResource VisibleSi}}">
                                            <Hyperlink Command="{Binding DescargarCommand}" ToolTip="Guarda la foto como JPG donde elijas">Descargar</Hyperlink>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center"
                                                   Visibility="{Binding TieneEnlacePublico, Converter={StaticResource VisibleSi}}">
                                            <Hyperlink Command="{Binding CopiarEnlaceCommand}"
                                                       ToolTip="Copia un enlace para mandárselo al cliente o a la agencia. Cualquiera que tenga el enlace puede ver la foto.">Copiar enlace para el cliente</Hyperlink>
                                        </TextBlock>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2,0,0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Visibility="{Binding HayMensaje, Converter={StaticResource VisibleSi}}" />
    </StackPanel>
</UserControl>
