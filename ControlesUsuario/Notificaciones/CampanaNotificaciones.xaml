<UserControl x:Class="ControlesUsuario.Notificaciones.CampanaNotificaciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Nesto#477: campana del buzón de notificaciones (arriba a la derecha de la cinta) y su panel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisible" />
        <Style x:Key="BotonPlano" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="BotonCampana" IsChecked="{Binding PanelAbierto, Mode=TwoWay}" ToolTip="{Binding TextoToolTip}"
                      Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" Focusable="False">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Style.Triggers>
                        <!-- Con el panel abierto, el clic en la campana lo cierra el propio Popup (StaysOpen=False):
                             si la campana también lo recibiera, lo volvería a abrir. -->
                        <DataTrigger Binding="{Binding IsOpen, ElementName=Panel}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <Grid>
                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,6,0"
                           VerticalAlignment="Center" Foreground="#444444" />
                <Border Background="#D93025" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                        Visibility="{Binding HayNoLeidas, Converter={StaticResource BoolAVisible}}">
                    <TextBlock Text="{Binding TextoNoLeidas}" Foreground="White" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </ToggleButton>

        <Popup x:Name="Panel" IsOpen="{Binding PanelAbierto, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=BotonCampana}" Placement="Bottom" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#BBBBBB" BorderThickness="1" Width="400" Padding="0,0,0,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                        <Button DockPanel.Dock="Right" Content="Marcar todas como leídas" Command="{Binding MarcarTodasLeidasCommand}"
                                Padding="6,1" FontSize="11" />
                        <TextBlock Text="Notificaciones" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cargando…" Foreground="#777777" Margin="10,4"
                               Visibility="{Binding Cargando, Converter={StaticResource BoolAVisible}}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Mensaje}" Foreground="#777777" TextWrapping="Wrap" Margin="10,4"
                               Visibility="{Binding HayMensaje, Converter={StaticResource BoolAVisible}}" />
                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notificaciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Leida}" Value="False">
                                                        <Setter Property="Background" Value="#EEF5FD" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#888888" Padding="8,6"
                                                    VerticalAlignment="Top" ToolTip="Borrar la notificación"
                                                    Command="{Binding DataContext.BorrarNotificacionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotonPlano}" Padding="0"
                                                    Command="{Binding DataContext.AbrirNotificacionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel Margin="0,6,0,6">
                                                    <!-- Marca de no leída -->
                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="#1A73E8" Margin="8,5,6,0" VerticalAlignment="Top">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Leida}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FechaRelativa}" FontSize="11" Foreground="#888888"
                                                                       Margin="6,0,0,0" ToolTip="{Binding FechaCreacion}" />
                                                            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Leida}" Value="False">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Cuerpo}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <!-- Plegada: dos líneas; al pulsarla (si no lleva a otra ventana) se ve entera -->
                                                                    <Setter Property="MaxHeight" Value="34" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Desplegada}" Value="True">
                                                                            <Setter Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
