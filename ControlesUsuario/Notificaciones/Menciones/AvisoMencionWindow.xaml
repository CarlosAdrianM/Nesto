<Window x:Class="ControlesUsuario.Notificaciones.Menciones.AvisoMencionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nesto: le han mencionado" Width="372" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <!-- Sugerencia 1183: la ventanita discreta de «le han mencionado». Sin sonido, no se activa al abrirse (no roba el foco a quien
         escribe), se cierra sola (PresentadorAvisoMencionWpf) y al pulsarla abre la novedad, como la campana. Fondo blanco con la
         franja de acento de las menciones (el mismo naranja que la campana). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisible" />
    </Window.Resources>
    <Border x:Name="Marco" Margin="10" Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="6"
            Cursor="Hand" MouseLeftButtonUp="OnPulsada" ToolTip="Pulse para abrir la novedad">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E8710A" CornerRadius="6,0,0,6" />
            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="#FEF3E2" Margin="12,12,0,0" VerticalAlignment="Top">
                <TextBlock Text="@" FontSize="17" FontWeight="Bold" Foreground="#E8710A" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-2,0,0" />
            </Border>
            <StackPanel Grid.Column="2" Margin="10,10,4,10">
                <TextBlock Text="LE MENCIONAN EN NOVEDADES" FontSize="10" FontWeight="SemiBold" Foreground="#B45309" />
                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13" Foreground="#202124" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Cuerpo}" Foreground="#555555" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                           Margin="0,2,0,0" Visibility="{Binding HayCuerpo, Converter={StaticResource BoolAVisible}}" />
                <TextBlock Text="{Binding TextoOtras}" FontSize="11" Foreground="#777777" Margin="0,4,0,0"
                           Visibility="{Binding HayOtras, Converter={StaticResource BoolAVisible}}" />
                <TextBlock Text="Pulse aquí para abrirla" FontSize="11" Foreground="#1A73E8" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#888888"
                    Background="Transparent" BorderThickness="0" Padding="8" Margin="0,4,4,0" VerticalAlignment="Top"
                    Cursor="Hand" Focusable="False" ToolTip="Cerrar (la notificación sigue en la campana)" Click="OnCerrar" />
        </Grid>
    </Border>
</Window>
