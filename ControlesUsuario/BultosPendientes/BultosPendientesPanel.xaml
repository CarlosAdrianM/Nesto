<UserControl x:Class="ControlesUsuario.BultosPendientes.BultosPendientesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControlesUsuario.BultosPendientes"
             Background="White">
    <!-- NestoAPI#880 (corte 2): los bultos pendientes dentro de otra pantalla (Agencias, todos; pestaña «Entrega» del pedido, los suyos).
         Crea su ViewModel con los servicios del contenedor y lee la API al enseñarse y al cambiar de pedido. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid x:Name="Raiz" Visibility="{Binding SeVe, Converter={StaticResource BoolAVisibilidad}}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Encabezado, RelativeSource={RelativeSource AncestorType=local:BultosPendientesPanel}}"
                       FontWeight="Bold" Margin="3"/>
            <local:BultosPendientesContenido/>
        </DockPanel>
    </Grid>
</UserControl>
