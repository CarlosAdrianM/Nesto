<UserControl x:Class="ControlesUsuario.Dialogs.ParametrosUsuarioDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" Height="Auto" Background="White">
    <!-- Caso real 20/08/26: sustituye al MessageBox de solo lectura del menú Parámetros.
         Los parámetros EDITABLES los decide el servidor (catálogo en NestoAPI): esta ventana
         solo pinta lo que el endpoint declare, con su combo de valores permitidos.
         Nesto#556 (sugerencia 757, Laura): los parámetros llegan de la API después de pintarse la ventana y el
         botón Guardar quedaba cortado. La ventana (VentanaDialogo) ahora sigue creciendo con el contenido hasta
         su tope de alto; por si no cabe, lo variable va en un ScrollViewer (fila *) y los botones en su propia
         fila Auto, siempre a la vista. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Parámetros de usuario" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

        <ScrollViewer x:Name="ScrollContenido" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Información de solo lectura (usuario, máquina, delegación, almacenes...) -->
                <TextBlock Text="{Binding Informacion}" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,10" />

                <!-- Parámetros editables por el propio usuario (lo que declare el servidor) -->
                <ItemsControl ItemsSource="{Binding Editables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Opciones}"
                                              SelectedValue="{Binding ValorSeleccionado, Mode=TwoWay}"
                                              SelectedValuePath="Valor"
                                              DisplayMemberPath="TextoFormateado"
                                              Width="260" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TextoTitular}" FontSize="11" Foreground="#888888" Margin="0,2,0,0"
                                               Visibility="{Binding VisibilidadTitular}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#2E9E5B" FontWeight="SemiBold" Margin="0,6,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Width="90" Height="28" Margin="0,0,8,0" />
            <Button Content="Cerrar" Command="{Binding CloseDialogCommand}" Width="90" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
