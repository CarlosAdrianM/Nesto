<UserControl x:Class="ControlesUsuario.Dialogs.RevisionConceptoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:ControlesUsuario.Dialogs"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinWidth="420" MaxWidth="640">
    <!-- NestoAPI#609: «¿Quisiste decir…?» antes de crear el enlace de pago. Sin colores fijos: el resaltado usa
         los colores de selección del sistema (se leen en claro y en oscuro). -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Has escrito:" Opacity="0.75" Margin="0,0,0,2"/>
        <TextBlock Grid.Row="2" Text="{Binding Original}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="El cliente verá:" Opacity="0.75" Margin="0,0,0,2"/>
        <TextBlock Grid.Row="4" local:TextoConCambios.Tramos="{Binding Tramos}" TextWrapping="Wrap" FontSize="14"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="{Binding TextoCambios}" TextWrapping="Wrap" Opacity="0.75" FontSize="11"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BotonUsarCorreccion" Content="Usar la corrección" Command="{Binding UsarCorreccionCommand}"
                    Padding="10,2" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Dejar el mío" Command="{Binding DejarElMioCommand}" Padding="10,2" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
