<UserControl x:Class="ControlesUsuario.Dialogs.NovedadesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:ControlesUsuario.Dialogs"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="620" Height="660">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisible" />
        <local:BytesAImagenConverter x:Key="BytesAImagen" />
        <!-- NestoAPI#520: botón de voto sobrio; resaltado (fondo azul claro) cuando es el voto del usuario -->
        <Style x:Key="BotonVoto" TargetType="Button">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nesto#487: título y buscador (NestoAPI#527). Al elegir un resultado se salta a su versión o a Sugerencias. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding PuedeSugerir, Converter={StaticResource BoolAVisible}}">
                <TextBox Width="190" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         ToolTip="Busca en todas las novedades y sugerencias (todas las palabras, con o sin tildes)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Buscar" Command="{Binding BuscarCommand}" Padding="8,1" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="Qué hay de nuevo" FontSize="18" FontWeight="Bold" />
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding MensajeBusqueda}" Foreground="#B03A2E" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding HayMensajeBusqueda, Converter={StaticResource BoolAVisible}}" />
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,6"
                    Visibility="{Binding HayResultadosBusqueda, Converter={StaticResource BoolAVisible}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Background="#F3F3F3">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CerrarBusquedaCommand}" Padding="6,0"
                                BorderThickness="0" Background="Transparent" ToolTip="Cerrar la búsqueda" />
                        <TextBlock Text="Elige una para ir a ella:" FontSize="11" Foreground="#555555" Margin="6,2" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding ResultadosBusqueda}" SelectedItem="{Binding ResultadoSeleccionado}"
                             MaxHeight="130" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Donde}" Foreground="#4A90D9" Width="120" />
                                    <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Navegación entre versiones: solo se muestra una versión a la vez (la más nueva al abrir);
             las flechas permiten consultar las novedades de versiones anteriores/siguientes. -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀" Width="30" Height="24" FontSize="13"
                    Command="{Binding VersionAnteriorCommand}" ToolTip="Versión anterior" />
            <TextBlock Grid.Column="1" Text="{Binding VersionActual}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#4A90D9" />
            <Button Grid.Column="2" Content="▶" Width="30" Height="24" FontSize="13"
                    Command="{Binding VersionSiguienteCommand}" ToolTip="Versión siguiente (desde la más nueva, las sugerencias pendientes)" />
        </Grid>

        <!-- Nesto#487: cabecera de la página de sugerencias: avisos y cuadro para sugerir (mismo pegado de captura que los comentarios). -->
        <StackPanel Grid.Row="3" Visibility="{Binding EnSugerencias, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="Ideas de los usuarios que aún no están hechas. Vota las que te interesen y coméntalas; las más votadas salen arriba."
                       TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,4" />
            <TextBlock Text="Cargando sugerencias…" Foreground="#777777" Margin="0,0,0,4"
                       Visibility="{Binding CargandoSugerencias, Converter={StaticResource BoolAVisible}}" />
            <TextBlock Text="{Binding MensajeSugerencias}" Foreground="#2E6DA4" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding HayMensajeSugerencias, Converter={StaticResource BoolAVisible}}" />
            <Border Visibility="{Binding FormularioSugerenciaAbierto, Converter={StaticResource BoolAVisible}}"
                    Background="#F7F7F7" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="¿Qué echas en falta? Cuéntalo con tus palabras (puedes pegar una captura con Ctrl+V):" FontSize="11" Foreground="#555555" Margin="0,0,0,2" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TextoSugerencia, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="54" MaxLength="2000" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="CuadroSugerencia_PreviewKeyDown" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding TieneImagenSugerencia, Converter={StaticResource BoolAVisible}}">
                        <Image Source="{Binding ImagenSugerencia, Converter={StaticResource BytesAImagen}}" MaxHeight="90" Stretch="Uniform" />
                        <Button Content="Quitar imagen" Command="{Binding QuitarImagenSugerenciaCommand}" Margin="8,0,0,0"
                                VerticalAlignment="Top" Padding="6,1" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Pegar imagen" Command="{Binding PegarImagenSugerenciaCommand}" Padding="8,2" Margin="0,0,6,0"
                                ToolTip="Adjunta la imagen que tengas copiada (por ejemplo, un recorte de pantalla)" />
                        <Button Content="Enviar sugerencia" Command="{Binding EnviarSugerenciaCommand}" Padding="12,2" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaNovedades" ItemsSource="{Binding Novedades}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Nesto#487: la elegida en el buscador (o la sugerencia recién creada) se resalta. -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,8,4,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Destacada}" Value="True">
                                            <Setter Property="Background" Value="#FFF6D5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="3" Padding="6,1,6,1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4A90D9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Categoria}" Value="Nuevo">
                                                        <Setter Property="Background" Value="#2E9E5B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Categoria}" Value="Corregido">
                                                        <Setter Property="Background" Value="#C9762B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Categoria}" Foreground="White" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Nesto#487: en una sugerencia, quién/cuándo, lo que escribió el usuario tal cual y su captura;
                                     la descripción (ampliada, nuestra) solo si la hay. -->
                                <TextBlock Text="{Binding SugeridaPor}" FontSize="11" Foreground="#777777" Margin="0,3,0,0"
                                           Visibility="{Binding EsSugerencia, Converter={StaticResource BoolAVisible}}" />
                                <Border BorderBrush="#C9D9EC" BorderThickness="3,0,0,0" Padding="6,0,0,0" Margin="0,4,0,0"
                                        Visibility="{Binding TieneTextoOriginal, Converter={StaticResource BoolAVisible}}">
                                    <TextBlock Text="{Binding TextoOriginal}" TextWrapping="Wrap" FontStyle="Italic" Foreground="#333333" />
                                </Border>
                                <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#444444"
                                           Visibility="{Binding TieneDescripcion, Converter={StaticResource BoolAVisible}}" />
                                <Image Source="{Binding ImagenNovedad, Converter={StaticResource BytesAImagen}}" MaxHeight="160"
                                       HorizontalAlignment="Left" Stretch="Uniform" Margin="0,4,0,0"
                                       Visibility="{Binding TieneImagenNovedad, Converter={StaticResource BoolAVisible}}">
                                    <Image.ToolTip>
                                        <Image Source="{Binding ImagenNovedad, Converter={StaticResource BytesAImagen}}" MaxWidth="900" MaxHeight="700" />
                                    </Image.ToolTip>
                                </Image>
                                <TextBlock Text="(no se pudo cargar la captura)" FontSize="11" Foreground="#999999"
                                           Visibility="{Binding ImagenNovedadNoDisponible, Converter={StaticResource BoolAVisible}}" />

                                <!-- NestoAPI#520: feedback. Solo si la API trae los contadores (si no, la ventana como siempre). -->
                                <StackPanel Visibility="{Binding TieneFeedback, Converter={StaticResource BoolAVisible}}" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding MeGustaCommand}" ToolTip="Me gusta (pulsa otra vez para quitarlo)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotonVoto}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsMeGusta}" Value="True">
                                                            <Setter Property="Background" Value="#DCEBFA" />
                                                            <Setter Property="BorderBrush" Value="#4A90D9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👍" FontFamily="Segoe UI Emoji" />
                                                <TextBlock Text="{Binding VotosPositivos}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NoMeGustaCommand}" ToolTip="No me gusta (pulsa otra vez para quitarlo)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotonVoto}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsNoMeGusta}" Value="True">
                                                            <Setter Property="Background" Value="#FBE3D6" />
                                                            <Setter Property="BorderBrush" Value="#C9762B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👎" FontFamily="Segoe UI Emoji" />
                                                <TextBlock Text="{Binding VotosNegativos}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BotonVoto}" Content="{Binding TextoComentarios}"
                                                Command="{Binding AbrirComentariosCommand}" ToolTip="Ver los comentarios y dejar el tuyo" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Mensaje}" Foreground="#B03A2E" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HayMensaje, Converter={StaticResource BoolAVisible}}" />

                                    <!-- Comentarios desplegados -->
                                    <Border Visibility="{Binding ComentariosAbiertos, Converter={StaticResource BoolAVisible}}"
                                            Background="#F7F7F7" CornerRadius="3" Padding="8" Margin="0,6,0,0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Comentarios}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Nesto#477: el comentario al que lleva la notificación de la campana, resaltado -->
                                                        <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="0,4,0,6">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Destacado}" Value="True">
                                                                            <Setter Property="Background" Value="#FFF6D5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Content="Borrar" FontSize="11" Padding="6,0"
                                                                            Visibility="{Binding EsMio, Converter={StaticResource BoolAVisible}}"
                                                                            Command="{Binding DataContext.BorrarComentarioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="Borrar tu comentario" />
                                                                    <TextBlock Text="{Binding Cabecera}" FontSize="11" Foreground="#777777" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                <Image Source="{Binding Imagen, Converter={StaticResource BytesAImagen}}" MaxHeight="140"
                                                                       HorizontalAlignment="Left" Stretch="Uniform" Margin="0,4,0,0">
                                                                    <Image.ToolTip>
                                                                        <Image Source="{Binding Imagen, Converter={StaticResource BytesAImagen}}" MaxWidth="900" MaxHeight="700" />
                                                                    </Image.ToolTip>
                                                                </Image>
                                                                <TextBlock Text="(no se pudo cargar la imagen)" FontSize="11" Foreground="#999999"
                                                                           Visibility="{Binding ImagenNoDisponible, Converter={StaticResource BoolAVisible}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Tu comentario (puedes pegar una captura con Ctrl+V):" FontSize="11" Foreground="#555555" Margin="0,6,0,2" />
                                            <TextBox Text="{Binding NuevoTexto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MinHeight="44" MaxLength="2000" VerticalScrollBarVisibility="Auto"
                                                     PreviewKeyDown="CuadroComentario_PreviewKeyDown" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                        Visibility="{Binding TieneImagenAdjunta, Converter={StaticResource BoolAVisible}}">
                                                <Image Source="{Binding ImagenAdjunta, Converter={StaticResource BytesAImagen}}" MaxHeight="90" Stretch="Uniform" />
                                                <Button Content="Quitar imagen" Command="{Binding QuitarImagenCommand}" Margin="8,0,0,0"
                                                        VerticalAlignment="Top" Padding="6,1" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button Content="Pegar imagen" Command="{Binding PegarImagenCommand}" Padding="8,2" Margin="0,0,6,0"
                                                        ToolTip="Adjunta la imagen que tengas copiada (por ejemplo, un recorte de pantalla)" />
                                                <Button Content="Enviar" Command="{Binding EnviarComentarioCommand}" Padding="12,2" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Sugerir nueva característica" Command="{Binding AbrirSugerenciaCommand}"
                    Height="28" Padding="10,0" ToolTip="¿Echas algo en falta en Nesto? Cuéntanoslo y los demás podrán votarlo"
                    Visibility="{Binding PuedeSugerir, Converter={StaticResource BoolAVisible}}" />
            <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding CloseDialogCommand}"
                    Width="90" Height="28" IsCancel="True" />
        </DockPanel>
    </Grid>
</UserControl>
