<UserControl x:Class="ControlesUsuario.Dialogs.MotivoCambioEstadoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420" MaxWidth="600">
    <!-- Nesto#558 (NestoAPI#716): motivo y comentario del cambio de estado del cliente. Los dos opcionales; con el
         teclado: la combo sale enfocada, Intro = Aceptar, Esc = Sin motivo. Sin colores fijos (claro y oscuro). -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Motivo:" Opacity="0.75" Margin="0,0,0,2"/>
        <ComboBox Grid.Row="3" x:Name="ComboMotivo" ItemsSource="{Binding Motivos}" DisplayMemberPath="Nombre"
                  SelectedValuePath="Codigo" SelectedValue="{Binding Motivo, Mode=TwoWay}" SelectedIndex="0"
                  HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Comentario (opcional, 200 caracteres):" Opacity="0.75" Margin="0,0,0,2"/>
        <TextBox Grid.Row="5" Text="{Binding Comentario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding LongitudComentario, Mode=OneTime}" TextWrapping="Wrap" AcceptsReturn="False"
                 MinHeight="48" SpellCheck.IsEnabled="True"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Aceptar" Command="{Binding AceptarCommand}" Width="90" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Sin motivo" Command="{Binding SinMotivoCommand}" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
