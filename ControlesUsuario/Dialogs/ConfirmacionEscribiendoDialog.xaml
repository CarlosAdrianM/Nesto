<UserControl x:Class="ControlesUsuario.Dialogs.ConfirmacionEscribiendoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420" MaxWidth="600" Background="White">
    <!-- Inventario (Paloma, 25/11/26): para hacer algo que no se hace por inercia hay que ESCRIBIR lo que se pide (el nombre o
         el código del almacén). «Cancelar» es el botón por defecto: Intro y Esc cancelan; el otro solo se activa con el texto. -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="{Binding Instruccion}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" x:Name="TextoConfirmacion" Padding="5" FontSize="13"
                 Text="{Binding Texto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" MaxLength="100"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding TextoAceptar}" Command="{Binding AceptarCommand}" MinWidth="90" Padding="10,2" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" MinWidth="90" Padding="10,2" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
