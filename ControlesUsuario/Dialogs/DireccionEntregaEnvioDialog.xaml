<UserControl x:Class="ControlesUsuario.Dialogs.DireccionEntregaEnvioDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="460" MaxWidth="620" Background="White">
    <!-- Nesto#625 (NestoAPI#726): la dirección nueva de un envío que ya viaja (CTT). Conserva el código y el reembolso.
         Teléfono y correo son obligatorios para CTT. -->
    <UserControl.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,5,12,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Cabecera}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="La agencia entregará el envío en esta dirección. Conserva el mismo número de envío y el mismo reembolso. El teléfono y el correo son obligatorios."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Destinatario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dirección:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Código postal:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CodPostal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Width="120" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Población:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Poblacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="País:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Pais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Width="50" HorizontalAlignment="Left"
                     ToolTip="Código de dos letras (ES, PT...)"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Width="160" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Correo:" Style="{StaticResource Etiqueta}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Correo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Aviso}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cambiar dirección" Command="{Binding AceptarCommand}" MinWidth="120" Padding="8,3" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" MinWidth="90" Padding="8,3" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
