<UserControl x:Class="ControlesUsuario.CintaSugerenciasProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sugerencias="clr-namespace:ControlesUsuario.SugerenciasProductos"
             d:DataContext="{d:DesignInstance Type=sugerencias:CintaSugerenciasProductosViewModel}"
             mc:Ignorable="d" Background="White">
    <!-- Nesto#537 (épica NestoAPI#669; segunda vuelta) y Nesto#544: «Puede ofrecer». 3 tarjetas (4 como máximo): la foto de la
         tienda a la izquierda y, a la derecha, el nombre con el tamaño, el código con la familia, la frase del motivo y los
         botones «✓ Añadir» (solo donde se puede vender: la plantilla), «✗ No le interesa» y «🚫 Quitar». Todo lo decide la API;
         sin sugerencias (o si la API falla) no se ve nada. Colores del sistema (modo claro y oscuro). Alt+O pliega o despliega
         (se recuerda). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSiCinta" />
        <ItemsPanelTemplate x:Key="FichasEnFila">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FichasEnColumna">
            <UniformGrid Columns="1"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Border Padding="3,2" BorderThickness="1" CornerRadius="3"
            Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            TextElement.Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
            Visibility="{Binding HaySugerencias, Converter={StaticResource VisibleSiCinta}, FallbackValue=Collapsed}">
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="2,0" Margin="0,0,0,1"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                    Command="{Binding PlegarCommand}"
                    ToolTip="Productos que puede ofrecer a este cliente. Pulse para plegar o desplegar (Alt+O); se recuerda para su usuario.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TextoPlegar}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="💡" FontFamily="Segoe UI Emoji" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <AccessText Text="Puede _ofrecer:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Sugerencias}" Focusable="False"
                          Visibility="{Binding Desplegadas, Converter={StaticResource VisibleSiCinta}}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel" Value="{StaticResource FichasEnFila}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnColumna, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="ItemsPanel" Value="{StaticResource FichasEnColumna}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,3,2" Padding="4" BorderThickness="1" CornerRadius="4" Height="84"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                ToolTip="{Binding Ayuda}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- La foto de la tienda; sin foto, el icono del motivo en grande -->
                                <Border Grid.Column="0" Width="74" Height="74" Margin="0,0,6,0" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <Grid>
                                        <TextBlock Text="{Binding Icono}" FontFamily="Segoe UI Emoji" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneFoto}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding UrlFoto, TargetNullValue={x:Null}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding TieneFoto, Converter={StaticResource VisibleSiCinta}}"/>
                                    </Grid>
                                </Border>
                                <!-- Novedad 714: los botones van en la misma fila que el motivo (a la derecha). En una fila
                                     aparte, con el nombre en dos líneas no cabía en los 84 de alto y el motivo quedaba
                                     cortado por la mitad detrás de los botones. -->
                                <Grid Grid.Column="1" ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding NombreMostrar}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="32"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding ProductoYFamilia}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    <DockPanel Grid.Row="2" VerticalAlignment="Bottom" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                            <Button Content="✓" MinWidth="24" Padding="3,0" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.AnadirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.PuedeAnadir, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource VisibleSiCinta}}"
                                                    ToolTip="Añadir al pedido (1 unidad; luego puede cambiar la cantidad)"/>
                                            <Button Content="✗" MinWidth="24" Padding="3,0" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.RechazarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Se lo he ofrecido y no le interesa (no se le vuelve a sugerir en un tiempo y sale otra en su lugar)"/>
                                            <Button MinWidth="24" Padding="3,0"
                                                    Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="No se lo ofrezco: quitar y mostrar otro">
                                                <TextBlock Text="🚫" FontFamily="Segoe UI Emoji"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <Run Text="{Binding Icono, Mode=OneWay}" FontFamily="Segoe UI Emoji"/>
                                            <Run Text="{Binding Texto, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
