<UserControl x:Class="DiferenciasInventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="White">
    <!-- Nesto#597 (NestoAPI#790): las diferencias del inventario, valoradas como diga la API (PVP o coste). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="Derecha" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TextoValoracion}" FontSize="16" FontWeight="SemiBold" Foreground="DarkBlue"
                       VerticalAlignment="Center" Margin="24,0,0,0" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Almacén:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Almacen, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalContentAlignment="Center" />
            <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <DatePicker SelectedDate="{Binding Fecha}" Width="120"
                        ToolTip="Las filas pendientes de contabilizar de ese día" />
            <TextBlock Text="o traspasos:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox Text="{Binding TextoTraspasos, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalContentAlignment="Center"
                     ToolTip="Números de traspaso separados por comas: si hay alguno, se usan en vez de la fecha" />
            <Button Content="Ver diferencias" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" />
            <TextBlock Text="Importe mínimo (€):" VerticalAlignment="Center" Margin="24,0,6,0" />
            <TextBox Text="{Binding ImporteMinimo, UpdateSourceTrigger=PropertyChanged}" Width="70"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                     ToolTip="Solo las diferencias de este importe o más (en valor absoluto)" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Cabecera}" FontWeight="SemiBold" Margin="0,0,0,6" />

        <DataGrid Grid.Row="3" Grid.Column="0" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" />
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                <DataGridTextColumn Header="Grupo" Binding="{Binding Grupo}" />
                <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" />
                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" />
                <DataGridTextColumn Header="Calculado" Binding="{Binding StockCalculado}" ElementStyle="{StaticResource Derecha}" />
                <DataGridTextColumn Header="Real" Binding="{Binding StockReal}" ElementStyle="{StaticResource Derecha}" />
                <DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia}" ElementStyle="{StaticResource Derecha}" />
                <DataGridTextColumn Header="Valor unitario" Binding="{Binding ValorUnitario, StringFormat=C2, ConverterCulture=es-ES}" ElementStyle="{StaticResource Derecha}" />
                <DataGridTextColumn Header="Valor diferencia" Binding="{Binding ValorDiferencia, StringFormat=C2, ConverterCulture=es-ES}" ElementStyle="{StaticResource Derecha}" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" Width="340">
            <TextBlock Text="Por grupo" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding PorGrupo}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding Grupo}" Width="*" />
                    <DataGridTextColumn Header="Filas" Binding="{Binding Filas}" ElementStyle="{StaticResource Derecha}" />
                    <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" ElementStyle="{StaticResource Derecha}" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C2, ConverterCulture=es-ES}" ElementStyle="{StaticResource Derecha}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Por familia" FontWeight="SemiBold" Margin="0,12,0,4" />
            <DataGrid ItemsSource="{Binding PorFamilia}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" Width="*" />
                    <DataGridTextColumn Header="Filas" Binding="{Binding Filas}" ElementStyle="{StaticResource Derecha}" />
                    <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" ElementStyle="{StaticResource Derecha}" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C2, ConverterCulture=es-ES}" ElementStyle="{StaticResource Derecha}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding TextoTotales, StringFormat=Total: {0}}" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
    </Grid>
</UserControl>
