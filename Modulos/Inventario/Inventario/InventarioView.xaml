<UserControl x:Class="InventarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nesto.Modulos.Inventario"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:xcdg="http://schemas.xceed.com/wpf/xaml/datagrid"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:escaner="clr-namespace:ControlesUsuario.EscanerRemoto;assembly=ControlesUsuario"
        xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
        mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Las columnas de la rejilla no están en el árbol visual: la del hueco ve el ViewModel por el proxy. -->
        <controles:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="VisibleSiVerdadero"/>
    </UserControl.Resources>


    <Grid Name="grdEntradaDatos" FocusManager.FocusedElement="{Binding ElementName=txtFecha}" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="48" />
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="FontSize" Value="48" />
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Almacén: "></TextBlock>
            <TextBox Name="txtAlmacen" Grid.Row="0" Grid.Column="1" Text="{Binding almacen}"></TextBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha: "></TextBlock>
            <TextBox Name="txtFecha" Grid.Row="1" Grid.Column="1" Text="{Binding fechaSeleccionada, StringFormat=d}"></TextBox>

            <!-- Algete (12/11/26): se cuenta EN un hueco; se queda puesto de un producto al siguiente. En las tiendas no se ve. -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hueco: " VerticalAlignment="Center"
                       Visibility="{Binding AlmacenConUbicaciones, Converter={StaticResource BooleanToVisibilityConverter}}"></TextBlock>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding AlmacenConUbicaciones, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtPasillo" Width="130" MaxLength="3" Text="{Binding Pasillo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pasillo (3 cifras: 1 es 001)"></TextBox>
                    <TextBlock Text="Pasillo" FontSize="14" HorizontalAlignment="Center"></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtFila" Width="130" MaxLength="3" Text="{Binding Fila, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fila (3 cifras: 1 es 001)"></TextBox>
                    <TextBlock Text="Fila" FontSize="14" HorizontalAlignment="Center"></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtColumna" Width="130" MaxLength="3" Text="{Binding Columna, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Columna (3 cifras: 1 es 001)"></TextBox>
                    <TextBlock Text="Columna" FontSize="14" HorizontalAlignment="Center"></TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Producto: "></TextBlock>
            <TextBox Name="txtProducto" Grid.Row="3" Grid.Column="1" Text="{Binding numeroProducto, Mode=TwoWay}" escaner:LectorCodigoBarras.AceptaCodigoBarras="True"></TextBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cantidad: "></TextBlock>
            <TextBox Name="txtCantidad" Grid.Row="4" Grid.Column="1" Text="{Binding cantidad, Mode=TwoWay}" IsEnabled="{Binding estaCantidadActiva}"></TextBox>

            <CheckBox Name="chkCantidad" Grid.Row="5" Grid.Column="1" Content="Activar Cantidad" IsChecked="{Binding estaCantidadActiva}"></CheckBox>

            <!-- Nesto#597 (NestoAPI#790): contabilizar desde aquí (con las comprobaciones) y ver las diferencias valoradas. -->
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Contabilizar inventario" Command="{Binding cmdContabilizarInventario}" FontSize="16" Padding="14,6" Margin="0,0,12,0"
                        Visibility="{Binding PuedeContabilizar, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Comprueba el inventario del almacén y la fecha y, si no hay nada que lo impida, lo contabiliza"/>
                <Button Content="Ver diferencias" Command="{Binding cmdVerDiferencias}" FontSize="16" Padding="14,6" Margin="0,0,12,0"
                        Visibility="{Binding PuedeVerDiferencias, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Las diferencias valoradas del inventario de esta fecha (lo pendiente) o de los traspasos que indique"/>
                <!-- Sugerencia 1185: el producto de «Producto» a cero en todas sus ubicaciones (filas de hoy; luego se contabiliza). -->
                <Button Content="Dejar a cero en todas sus ubicaciones" Command="{Binding cmdDejarACero}" FontSize="16" Padding="14,6"
                        Visibility="{Binding PuedeDejarACero, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Pone a 0 el producto escrito en «Producto» en todas sus ubicaciones de este almacén (inventario de hoy). Después hay que contabilizar el inventario."/>
            </StackPanel>
        </Grid>
        <TabControl Name="tclMovimientos" Grid.Column="1" TabStripPlacement="Bottom">
            <TabItem Name="tabRecientes" Header="Recientes">
                <DataGrid Name="dgrRecientes" ItemsSource="{Binding movimientosDia}" AutoGenerateColumns="False" IsReadOnly="True" SelectedItem="{Binding movimientoActual, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="Auto"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                        <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" Width="Auto"/>
                        <DataGridTextColumn Header="Hueco" Binding="{Binding Hueco}" Width="Auto"
                                            Visibility="{Binding Data.AlmacenConUbicaciones, Source={StaticResource ViewModelProxy}, Converter={StaticResource VisibleSiVerdadero}}"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Cantidad}" Width="Auto"/>
                        <DataGridTextColumn Header="Leído" Binding="{Binding Lectura}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Name="tabCompleto" Header="Completo">
                <xctk:BusyIndicator IsBusy="{Binding estaOcupado}" BusyContent="Cargando datos...">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Command="{Binding cmdActualizarMovimientos}">Actualizar</Button>
                        <DataGrid DockPanel.Dock="Bottom" Name="dgrCompleto" ItemsSource="{Binding movimientosTotal}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="Auto"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                                <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" Width="Auto"/>
                                <DataGridTextColumn Header="Hueco" Binding="{Binding Hueco}" Width="Auto"
                                                    Visibility="{Binding Data.AlmacenConUbicaciones, Source={StaticResource ViewModelProxy}, Converter={StaticResource VisibleSiVerdadero}}"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockReal}" Width="Auto"/>
                                <DataGridTextColumn Header="Leído" Binding="{Binding Lectura}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </xctk:BusyIndicator>

            </TabItem>
        </TabControl>
        
    </Grid>
</UserControl>
