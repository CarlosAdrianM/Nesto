<UserControl x:Class="ComprobacionesInventarioDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="900" Height="620">
    <!-- Nesto#597 (NestoAPI#790): las comprobaciones de antes de contabilizar el inventario. Bloqueantes en rojo (no dejan
         seguir); avisos en ámbar («Continuar de todos modos»); recuento por usuario. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="FilasComprobacion">
            <DataGrid ItemsSource="{Binding Filas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" MaxHeight="220" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº orden" Binding="{Binding NumOrden}"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="Calculado" Binding="{Binding StockCalculado}"/>
                    <DataGridTextColumn Header="Real" Binding="{Binding StockReal}"/>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Cabecera}" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="{Binding Explicacion}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Visibility="{Binding HayBloqueantes, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Bloqueantes" FontWeight="Bold" Foreground="DarkRed" FontSize="14" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Bloqueantes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Firebrick" Background="#FFFDECEC" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cabecera}" FontWeight="SemiBold" Foreground="DarkRed" TextWrapping="Wrap"/>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FilasComprobacion}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HayAvisos, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Avisos" FontWeight="Bold" Foreground="DarkGoldenrod" FontSize="14" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding Avisos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Orange" Background="#FFFFF6E0" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cabecera}" FontWeight="SemiBold" Foreground="DarkGoldenrod" TextWrapping="Wrap"/>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FilasComprobacion}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Recuento por usuario" FontWeight="Bold" FontSize="14" Margin="0,4,0,4"/>
                <DataGrid ItemsSource="{Binding Recuento}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" HorizontalAlignment="Left" MinWidth="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/>
                        <DataGridTextColumn Header="Filas" Binding="{Binding Filas}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding TextoContinuar}" Command="{Binding ContinuarCommand}" Padding="12,3" Margin="0,0,8,0"
                    Visibility="{Binding PuedeContinuar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Cerrar" Command="{Binding CancelarCommand}" Padding="12,3" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
