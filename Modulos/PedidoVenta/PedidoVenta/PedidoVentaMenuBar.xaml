<UserControl x:Class="PedidoVentaMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Nesto.Modulos.PedidoVenta"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <Ribbon x:Name="MainMenu" x:FieldModifier="Protected Friend">
        <RibbonTab x:Name="tabClientes"
                              Header="Clientes">
            <RibbonGroup x:Name="grpVentas"
                                    Header="Ventas">
                <RibbonButton Label="Pedidos" LargeImageSource="Images/PedidoVenta.png" Command="{Binding cmdAbrirModulo}" />
                <!-- Nesto#552: listado de solo lectura de las líneas pendientes de entregar de todos los almacenes -->
                <RibbonButton Label="Pendientes de entregar" LargeImageSource="Images/PedidoVenta.png" Command="{Binding cmdAbrirPendientesEntregar}" />
                <!-- Nesto#546 (NestoAPI#693): pedidos cuya fecha de entrega prometida al cliente ya no se cumple (la pantalla vive en el módulo Cliente) -->
                <RibbonButton Label="Fecha en riesgo" ToolTip="Pedidos con la fecha de entrega prometida al cliente en riesgo: se retrasan o se quedan sin fecha"
                              LargeImageSource="Images/PedidoVenta.png" Command="{Binding cmdAbrirPromesaRiesgo}" />
            </RibbonGroup>
        </RibbonTab>
    </Ribbon>

</UserControl>