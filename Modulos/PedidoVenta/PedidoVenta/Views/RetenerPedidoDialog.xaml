<UserControl x:Class="RetenerPedidoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="460">
    <!-- NestoAPI#698: retener el pedido hasta nuevo aviso. Motivo obligatorio; fecha opcional (en blanco = hasta nuevo aviso).
         Con el teclado: el motivo sale enfocado, Intro = Retener (si hay motivo), Esc = Cancelar. -->
    <Grid Margin="15" FocusManager.FocusedElement="{Binding ElementName=TextoMotivo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Motivo (obligatorio):" Opacity="0.75" Margin="0,0,0,2"/>
        <TextBox Grid.Row="3" x:Name="TextoMotivo" Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="48" MaxLength="250" SpellCheck.IsEnabled="True" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Hasta el (opcional):" Opacity="0.75" Margin="0,0,0,2"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding HastaFecha, Mode=TwoWay}" DisplayDateStart="{Binding FechaMinima, Mode=OneTime}" Width="150"/>
            <Button Content="Sin fecha" Command="{Binding QuitarFechaCommand}" Padding="8,1" Margin="8,0,0,0"
                    ToolTip="Dejarlo retenido hasta nuevo aviso"/>
        </StackPanel>
        <TextBlock Grid.Row="6" Text="{Binding TextoHasta}" Opacity="0.75" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Retener" Command="{Binding RetenerCommand}" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
