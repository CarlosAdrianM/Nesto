<UserControl x:Class="BotoneraDetallePedido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Nesto.Modulos.PedidoVenta"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=local:DetallePedidoViewModel}">
    <!-- Nesto#631 (prueba): la botonera de DetallePedidoView con WPF-UI (lepoco), la misma librería y versión que el panel
         lateral. Sus recursos (tema claro + estilos) se fusionan SOLO en este control y en su menú «Más» desde el código
         (RecursosWpfUi), nunca en Application.Resources: el resto de la vista y de Nesto conserva su aspecto. Mismos comandos
         y visibilidades que la rejilla de botones de antes; el DataContext es el DetallePedidoViewModel heredado de la vista. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSi"/>
        <Style x:Key="BotonBarra" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Acción delicada, aparte (a la derecha, lejos de las de cada día) y en la apariencia «Caution» de WPF-UI. La
             confirmación es el diálogo de siempre (RetenerPedidoAsync). Sin atajo de teclado a propósito. -->
        <StackPanel x:Name="GrupoRetener" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
            <ui:Button x:Name="BotonLiberar" Content="Liberar" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon PlayCircle24}"
                       Command="{Binding CmdLiberarPedido}"
                       Visibility="{Binding EstaRetenido, Converter={StaticResource VisibleSi}}"
                       ToolTip="Quitar la retención: el pedido vuelve a su modo de servicio anterior y entra en el picking"/>
            <ui:Button x:Name="BotonRetener" Content="Retener…" Appearance="Caution" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon PauseCircle24}"
                       Command="{Binding CmdRetenerPedido}"
                       ToolTip="Que el pedido no salga hasta nuevo aviso (o hasta una fecha), sin tocar la fecha de entrega"/>
        </StackPanel>

        <WrapPanel x:Name="BarraComandos" Orientation="Horizontal">
            <!-- A la vista: las de cada día -->
            <ui:Button x:Name="BotonSacarPicking" Content="Sacar picking" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon BoxCheckmark24}"
                       Command="{Binding cmdAbrirPicking}"
                       ToolTip="Sacar el picking de este pedido (Ctrl+Mayús+P)"/>
            <ui:Button x:Name="BotonDescargarPdf" Content="Descargar PDF" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding DescargarPresupuestoCommand}"
                       ToolTip="Descargar el PDF del pedido (Ctrl+Mayús+D)"/>
            <!-- Nesto#563 (NestoAPI#724) -->
            <ui:Button x:Name="BotonEnviarCorreo" Content="Enviar por correo…" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon Mail24}"
                       Command="{Binding EnviarPedidoPorCorreoCommand}"
                       ToolTip="Mandar el PDF del pedido por correo al cliente (se proponen sus personas de contacto). Ctrl+Mayús+E"/>
            <ui:Button x:Name="BotonFacturarRutas" Content="Facturar rutas" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon VehicleTruckProfile24}"
                       Command="{Binding AbrirFacturarRutasCommand}"
                       Visibility="{Binding EsGrupoQuePuedeFacturar, Converter={StaticResource VisibleSi}}"
                       ToolTip="Facturar las rutas (Ctrl+Mayús+F)"/>
            <!-- Solo con presupuesto: estaba en la rejilla y no conviene esconderlo en «Más» -->
            <ui:Button x:Name="BotonAceptarPresupuesto" Content="Aceptar presupuesto" Style="{StaticResource BotonBarra}"
                       Icon="{ui:SymbolIcon CheckmarkCircle24}"
                       Command="{Binding AceptarPresupuestoCommand}"
                       Visibility="{Binding mostrarAceptarPresupuesto, Converter={StaticResource VisibleSi}}"/>

            <!-- «Más»: Documentos · Facturación · Notas. El menú es un popup: no hereda recursos ni DataContext de la botonera,
                 así que el código le fusiona los recursos y aquí toma el DataContext del botón que lo abre. -->
            <ui:DropDownButton x:Name="BotonMas" Content="Más" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,4,4"
                               ToolTip="Más acciones del pedido">
                <ui:DropDownButton.Flyout>
                    <ContextMenu x:Name="MenuMas" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <!-- Nesto#570 (NestoAPI#737) -->
                        <ui:MenuItem x:Name="BotonEnviarWhatsApp" Header="Enviar por WhatsApp…" Icon="{ui:SymbolIcon Chat24}"
                                     Command="{Binding EnviarPedidoPorWhatsAppCommand}"
                                     ToolTip="Abrir WhatsApp Web con el mensaje para el cliente y el enlace de descarga del PDF del pedido; solo tiene que pulsar «Enviar»"/>
                        <ui:MenuItem x:Name="BotonCopiarFactura" Header="Copiar factura" Icon="{ui:SymbolIcon Copy24}"
                                     Command="{Binding CopiarFacturaCommand}"
                                     Visibility="{Binding MostrarCopiarFactura, Converter={StaticResource VisibleSi}}"
                                     ToolTip="Copiar líneas de una factura existente para crear rectificativa o duplicar"/>
                        <Separator/>
                        <!-- NestoAPI#727 -->
                        <ui:MenuItem x:Name="BotonFacturarFinDeMes" Header="Facturar fin de mes" Icon="{ui:SymbolIcon CalendarLtr24}"
                                     Command="{Binding AbrirFacturarFinDeMesCommand}"
                                     Visibility="{Binding PuedeFacturarFinDeMes, Converter={StaticResource VisibleSi}}"
                                     ToolTip="Reunir y facturar los albaranes de fin de mes (los pedidos con P.O. no entran)"/>
                        <ui:MenuItem x:Name="BotonPasarAPresupuesto" Header="Pasar a presupuesto" Icon="{ui:SymbolIcon DocumentArrowLeft24}"
                                     Command="{Binding PasarAPresupuestoCommand}"/>
                        <Separator/>
                        <!-- Nesto#618 (NestoAPI#786) -->
                        <ui:MenuItem x:Name="BotonNuevaNotaCobro" Header="Nueva nota de cobro…" Icon="{ui:SymbolIcon Money24}"
                                     Command="{Binding NuevaNotaCobroCommand}"
                                     Visibility="{Binding EsGrupoQuePuedeCrearNotas, Converter={StaticResource VisibleSi}}"
                                     ToolTip="Crear una nota de solo cobro para este cliente: el repartidor pasa a cobrar los efectos que marque (o un importe) sin llevar nada"/>
                        <!-- Nesto#579 -->
                        <ui:MenuItem x:Name="BotonNuevaNotaRecogida" Header="Nueva nota de recogida" Icon="{ui:SymbolIcon BoxArrowLeft24}"
                                     Command="{Binding NuevaNotaRecogidaCommand}"
                                     Visibility="{Binding EsGrupoQuePuedeCrearNotas, Converter={StaticResource VisibleSi}}"
                                     ToolTip="Crear una nota de recogida para este cliente (1 bulto) con una línea de texto para escribir qué hay que recoger"/>
                        <!-- Nesto#581 (NestoAPI#760) -->
                        <ui:MenuItem x:Name="BotonLeerEtiquetaRecogida" Header="Leer etiqueta de recogida…" Icon="{ui:SymbolIcon BarcodeScanner24}"
                                     InputGestureText="Ctrl+Mayús+R"
                                     Command="{Binding LeerEtiquetaRecogidaCommand}"
                                     Visibility="{Binding PuedeLeerEtiquetaRecogida, Converter={StaticResource VisibleSi}}"
                                     ToolTip="Leer la etiqueta de recogida (NR…) del bulto que trae el repartidor: se crea el pedido de abono del cliente y se abre con cantidad −1 para ir leyendo los productos"/>
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </WrapPanel>
    </DockPanel>
</UserControl>
