<UserControl x:Class="ConsultaReembolsoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
             Background="White" Width="560">
    <!-- Nesto#568 (NestoAPI#734): «Sale con reembolso» (+ anular el enlace pendiente) o «Sale sin reembolso» (+ forma de pago
         y plazos pactados). Lo que no vale lo dice la API y se enseña en rojo, tal cual. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding TextoConsulta}" TextWrapping="Wrap"/>
            <TextBlock Text="Enlaces de pago pendientes:" Opacity="0.75" Margin="0,8,0,2"
                       Visibility="{Binding HayConsultaAbierta, Converter={StaticResource BoolAVisibilidad}}"/>
            <ItemsControl ItemsSource="{Binding Enlaces}" Margin="10,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Texto, StringFormat='• {0}'}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding HayConsultaAbierta}">
            <RadioButton Content="Sale con reembolso" IsChecked="{Binding SaleConReembolso}" GroupName="Reembolso" FontWeight="Bold"/>
            <CheckBox Content="Anular el enlace pendiente" IsChecked="{Binding AnularEnlaces}" Margin="22,4,0,0"
                      IsEnabled="{Binding SaleConReembolso}"
                      ToolTip="Solo si el enlace es de este pedido: el cliente ya no podrá pagar con él"/>

            <RadioButton Content="Sale sin reembolso" IsChecked="{Binding SaleSinReembolso}" GroupName="Reembolso" FontWeight="Bold" Margin="0,10,0,0"/>
            <StackPanel Margin="22,4,0,0" IsEnabled="{Binding SaleSinReembolso}">
                <TextBlock Text="Forma de pago y plazos pactados con el cliente (nunca tarjeta ni prepago si no está pagado):" TextWrapping="Wrap" Opacity="0.75"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <controles:SelectorFormaPago Configuracion="{Binding Configuracion}" Empresa="{Binding Empresa}" Cliente="{Binding Cliente}"
                                                 Seleccionada="{Binding FormaPago, Mode=TwoWay}" Width="230"/>
                    <controles:SelectorPlazosPago Configuracion="{Binding Configuracion}" Empresa="{Binding Empresa}" Cliente="{Binding Cliente}"
                                                  Seleccionada="{Binding PlazosPago, Mode=TwoWay}" Width="230" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Comentario para quien preguntó (opcional):" Opacity="0.75" Margin="0,12,0,2"/>
            <TextBox Text="{Binding Comentario, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" MinHeight="40"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="8" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                Visibility="{Binding HayResultado, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="{Binding TextoResultado}" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="5" Text="Trabajando..." Opacity="0.6" Margin="0,6,0,0"
                   Visibility="{Binding EstaOcupado, Converter={StaticResource BoolAVisibilidad}}"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Responder" Command="{Binding ResponderCommand}" Width="100" Height="28" Margin="0,0,8,0" IsDefault="True" FontWeight="Bold"/>
            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
