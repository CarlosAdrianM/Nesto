<UserControl x:Class="PagoAPlazosDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="500">
    <!-- Nesto#640 (NestoAPI#864): pago a plazos de un pedido ya creado. Primero se elige el canal (la app del cliente, solo si
         la tiene, o un enlace); tras «Solicitar» se ve el resultado y, si hay enlace, «Copiar enlace». Esc = Cancelar / Cerrar. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisible"/>
    </UserControl.Resources>
    <StackPanel Margin="15">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding TextoOferta}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding TextoPruebas}" TextWrapping="Wrap" FontStyle="Italic" Foreground="#7A4F01" Margin="0,0,0,8"
                   Visibility="{Binding EsPruebas, Converter={StaticResource BoolAVisible}}"/>

        <!-- Antes de pedirlo: el aviso de la API y el canal -->
        <StackPanel Visibility="{Binding Eligiendo, Converter={StaticResource BoolAVisible}}">
            <Border Background="#FFF3CD" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,10"
                    Visibility="{Binding HayAviso, Converter={StaticResource BoolAVisible}}">
                <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" Foreground="#7A4F01"/>
            </Border>

            <TextBlock Text="¿Cómo termina el pago el cliente?" Opacity="0.75" Margin="0,0,0,4"/>
            <RadioButton GroupName="CanalPagoAPlazos" Content="Mandar a la app del cliente" Margin="0,0,0,4"
                         IsChecked="{Binding EsPorApp, Mode=TwoWay}"
                         Visibility="{Binding ClienteTieneApp, Converter={StaticResource BoolAVisible}}"
                         ToolTip="El cliente recibe un aviso en su app y termina el pago ahí, sin enlaces"/>
            <RadioButton GroupName="CanalPagoAPlazos" Content="Enlace" Margin="0,0,0,4"
                         IsChecked="{Binding EsPorEnlace, Mode=TwoWay}"
                         ToolTip="Se crea un enlace para que usted se lo mande al cliente"/>

            <TextBlock Text="Correo del cliente (opcional; en blanco, el de su ficha):" Opacity="0.75" Margin="0,8,0,2"/>
            <TextBox Text="{Binding Correo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
        </StackPanel>

        <!-- El mensaje de la API si no ha dejado abrirla -->
        <TextBlock Text="{Binding TextoError}" TextWrapping="Wrap" Foreground="#C62828" FontWeight="SemiBold" Margin="0,10,0,0"
                   Visibility="{Binding HayError, Converter={StaticResource BoolAVisible}}"/>

        <!-- Ya pedido: qué se ha hecho, el aviso y el enlace -->
        <StackPanel Visibility="{Binding Solicitada, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding TextoResultado}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="#FFF3CD" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,8"
                    Visibility="{Binding HayAvisoResultado, Converter={StaticResource BoolAVisible}}">
                <TextBlock Text="{Binding AvisoResultado}" TextWrapping="Wrap" Foreground="#7A4F01"/>
            </Border>
            <StackPanel Visibility="{Binding HayEnlace, Converter={StaticResource BoolAVisible}}">
                <TextBlock Text="Enlace para el cliente:" Opacity="0.75" Margin="0,0,0,2"/>
                <TextBox Text="{Binding UrlPago, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70"
                         VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Copiar enlace" Command="{Binding CopiarEnlaceCommand}" Padding="10,3"
                            ToolTip="Copia el mensaje para el cliente: el enlace de pago y, si no tiene la app, la invitación a instalarla"/>
                    <TextBlock Text="{Binding TextoCopiado}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#2E7D32"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- La invitación a instalar la app (solo si la API la trae: el cliente no tiene la app). Discreta: antes y después de pedirlo -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding HayInvitacionApp, Converter={StaticResource BoolAVisible}}">
            <Button Content="{Binding TextoCopiarInvitacion}" Command="{Binding CopiarInvitacionCommand}" Padding="8,2" FontSize="11"
                    ToolTip="{Binding AyudaCopiarInvitacion}"/>
            <TextBlock Text="{Binding TextoInvitacionCopiada}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#2E7D32"
                       TextWrapping="Wrap" MaxWidth="300"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Solicitar" Command="{Binding SolicitarCommand}" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Visibility="{Binding Eligiendo, Converter={StaticResource BoolAVisible}}"/>
            <Button Content="{Binding TextoBotonCerrar}" Command="{Binding CerrarCommand}" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
