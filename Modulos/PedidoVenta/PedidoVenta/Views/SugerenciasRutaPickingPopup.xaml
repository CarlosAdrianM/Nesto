<UserControl x:Class="SugerenciasRutaPickingPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="900" MaxHeight="620">
    <!-- Sugerencia 575 (Alfredo, almacén): antes de sacar el picking, los pedidos que van por OnTime y que seguramente
         saldrán por nuestra ruta (AT/16). Solo lo ve almacén; nada se cambia sin marcarlo. Sin colores fijos (modo claro y
         oscuro): los grises salen de los colores del sistema. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Cabecera}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Sugerencias}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="120">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Cambiar" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Pedido" Binding="{Binding Pedido}" IsReadOnly="True" Width="65" />
                <DataGridTextColumn Header="Emp." Binding="{Binding Empresa}" IsReadOnly="True" Width="40" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=dd/MM/yy}" IsReadOnly="True" Width="65" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteTexto}" IsReadOnly="True" Width="230" />
                <DataGridTextColumn Header="Base" Binding="{Binding BaseImponible, StringFormat=c, ConverterCulture=es-ES}" IsReadOnly="True" Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ahora" Binding="{Binding RutaActual}" IsReadOnly="True" Width="45" />
                <DataGridTemplateColumn Header="Pasar a" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.RutasPropias, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding RutaNueva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Por qué" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MotivosTexto}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cambiar la ruta de los marcados y sacar el picking" Command="{Binding CambiarYSacarCommand}"
                    Padding="10,0" Height="28" Margin="0,0,8,0" />
            <Button Content="Sacar el picking sin cambiar nada" Command="{Binding SacarSinCambiarCommand}"
                    Padding="10,0" Height="28" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="90" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
