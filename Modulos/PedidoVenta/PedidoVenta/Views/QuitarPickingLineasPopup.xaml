<UserControl x:Class="QuitarPickingLineasPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760" MaxHeight="600" Background="White">
    <!-- Novedad 1146 (Alfredo, almacén): elegir a qué líneas del pedido se quita el picking (lo más común, los portes).
         Todas las que se pueden quitar salen marcadas (= el pedido entero, como antes). -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Cabecera}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="120">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Quitar" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding SePuedeQuitar}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nº Orden" Binding="{Binding Linea}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True" Width="85" />
                <DataGridTextColumn Header="Texto" Binding="{Binding Texto}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" IsReadOnly="True" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Picking" Binding="{Binding Picking}" IsReadOnly="True" Width="65" />
                <DataGridTemplateColumn Header="No se puede porque" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="Gray" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Quitar picking de las líneas marcadas" Command="{Binding QuitarCommand}"
                    Padding="10,0" Height="28" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="90" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
