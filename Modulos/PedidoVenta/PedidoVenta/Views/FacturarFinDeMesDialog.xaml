<UserControl x:Class="FacturarFinDeMesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="760" Height="560">
    <!-- NestoAPI#727: facturar el fin de mes por la API (sustituye al paso del «Nesto viejo»). Solo Administración,
         Dirección e Informática. Pide confirmación y enseña el resultado por cliente en la propia ventana. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Reúne en un pedido del contacto principal los albaranes (hasta la fecha de corte incluida) de los pedidos de fin de mes sin P.O. de cada cliente y los factura. Los pedidos con P.O. no entran: se facturan por P.O. cuando están completos. Deje el cliente en blanco para facturar todos."/>

        <!-- Filtros -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Fecha de corte:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding FechaCorte}" DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}" Width="130"/>
            <TextBlock Text="Cliente:" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalContentAlignment="Center"
                     ToolTip="Opcional: en blanco, todos los clientes"/>
            <TextBlock Text="Contacto:" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <TextBox Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalContentAlignment="Center"
                     IsEnabled="{Binding HayCliente}" ToolTip="Opcional, solo con un cliente: en blanco, todos sus contactos"/>
            <Button Content="Facturar fin de mes" Margin="20,0,0,0" Padding="12,3"
                    Command="{Binding FacturarFinDeMesCommand}"
                    Visibility="{Binding PuedeFacturarFinDeMes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Solo pueden facturar el fin de mes Administración, Dirección e Informática.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PuedeFacturarFinDeMes}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ProgressBar Grid.Row="4" Height="16" IsIndeterminate="True" Margin="0,0,0,10"
                     Visibility="{Binding EstaProcesando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HayMensajeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Resultado por cliente -->
        <TabControl Grid.Row="6">
            <TabItem Header="Facturas creadas">
                <DataGrid ItemsSource="{Binding Facturas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="70"/>
                        <DataGridTextColumn Header="Pedido destino" Binding="{Binding PedidoDestino}" Width="95"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding NumeroFactura}" Width="100"/>
                        <DataGridTextColumn Header="Pedidos reunidos" Binding="{Binding TextoPedidosReunidos}" Width="150"/>
                        <DataGridTextColumn Header="Líneas" Binding="{Binding LineasMovidas}" Width="55"/>
                        <DataGridTextColumn Header="Aviso" Binding="{Binding Aviso}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Clientes saltados">
                <DataGrid ItemsSource="{Binding Saltados}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="70"/>
                        <DataGridTextColumn Header="Pedidos" Binding="{Binding TextoPedidos}" Width="150"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Errores">
                <DataGrid ItemsSource="{Binding Errores}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="70"/>
                        <DataGridTextColumn Header="Pedido destino" Binding="{Binding PedidoDestino}" Width="95"/>
                        <DataGridTextColumn Header="Error" Binding="{Binding Mensaje}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="7" Content="Cerrar" Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0"
                Command="{Binding CerrarCommand}" IsCancel="True"/>
    </Grid>
</UserControl>
