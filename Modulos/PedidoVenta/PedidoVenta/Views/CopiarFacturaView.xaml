<UserControl x:Class="CopiarFacturaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
        Width="680" MinHeight="400" Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" x:Key="CheckBoxStyle">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Incidencia 435 (30/09/26): en un portátil la ventana no cabía y el cliente destino y
         «Ejecutar» quedaban fuera de la pantalla, sin forma de llegar a ellos. El contenido va en
         un ScrollViewer y los botones quedan siempre a la vista; el alto máximo lo pone el
         code-behind según la pantalla. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <TextBlock Grid.Row="0" Text="Copiar Factura / Crear Rectificativa"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Datos de origen -->
        <GroupBox Grid.Row="1" Header="Factura Origen" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <!-- Entrada rapida por numero -->
                <TextBlock Text="Número de factura o pedido:" Style="{StaticResource LabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NumeroFactura, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             ToolTip="Introduzca el número de factura (ej: NV26/001234) o de pedido"/>
                    <Button Grid.Column="1" Content="Buscar" Command="{Binding BuscarClienteCommand}"
                            Width="60" Height="28" Margin="5,0,0,0" VerticalAlignment="Center"
                            ToolTip="Buscar cliente por número de factura o pedido"/>
                </Grid>

                <!-- Separador -->
                <TextBlock Text="─── O buscar por cliente ───"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,10,0,5"/>

                <!-- Selector de cliente -->
                <TextBlock Text="Cliente:" Style="{StaticResource LabelStyle}"/>
                <controles:SelectorCliente
                    Empresa="{Binding DataContext.Empresa, ElementName=rootGrid, Mode=TwoWay}"
                    Cliente="{Binding DataContext.Cliente, ElementName=rootGrid, Mode=TwoWay}"
                    Contacto="{Binding DataContext.Contacto, ElementName=rootGrid, Mode=TwoWay}"
                    ClienteCompleto="{Binding DataContext.ClienteCompleto, ElementName=rootGrid, Mode=TwoWay}"
                    Margin="0,5,0,10"/>

                <!-- Selector de facturas -->
                <TextBlock Text="Facturas del cliente:" Style="{StaticResource LabelStyle}"
                           Visibility="{Binding DataContext.TieneCliente, ElementName=rootGrid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <controles:SelectorFacturas
                    Empresa="{Binding DataContext.Empresa, ElementName=rootGrid}"
                    Cliente="{Binding DataContext.Cliente, ElementName=rootGrid}"
                    Contacto="{Binding DataContext.Contacto, ElementName=rootGrid}"
                    FacturasSeleccionadas="{Binding DataContext.FacturasSeleccionadas, ElementName=rootGrid, Mode=TwoWay}"
                    FacturaSeleccionada="{Binding DataContext.FacturaSeleccionadaEnLista, ElementName=rootGrid, Mode=TwoWay}"
                    MostrarBusqueda="False"
                    MostrarResumenSeleccion="True"
                    MostrarSeleccionarTodas="True"
                    AlturaMaxima="150"
                    Margin="0,5,0,0"
                    Visibility="{Binding DataContext.TieneCliente, ElementName=rootGrid, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Opcion agrupar facturas (visible cuando hay mas de una seleccionada) -->
                <CheckBox Content="Agrupar facturas en una sola rectificativa"
                          IsChecked="{Binding AgruparFacturas}"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="Si no se marca, se creará una rectificativa por cada factura seleccionada"
                          Visibility="{Binding TieneMultiplesFacturasSeleccionadas, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Nesto#638 (NestoAPI#899/#863): copiar o abonar solo unos albaranes o unas líneas -->
                <CheckBox Content="Solo unas líneas o albaranes…"
                          IsChecked="{Binding SoloUnaParte}"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="Marque los albaranes enteros o las líneas que se copian o se abonan, con su cantidad. Sin marcar, la factura entera, como siempre."/>
                <StackPanel Visibility="{Binding SoloUnaParte, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" Foreground="Gray" VerticalAlignment="Center"
                                   Text="Los portes y las cuentas contables solo van si se marcan. Por defecto, lo que queda por abonar."/>
                        <Button Grid.Column="1" Content="Cargar líneas" Command="{Binding CargarLineasCommand}"
                                Height="26" Padding="8,0" Margin="5,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AlbaranesParaElegir}" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Descripcion}" IsChecked="{Binding Marcado}" Margin="0,2,12,2"
                                          ToolTip="Marca o desmarca todas las líneas de este albarán (sin portes ni cuentas contables)"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid ItemsSource="{Binding LineasParaElegir}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="260" Margin="0,5,0,0"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F7F7F7"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcada, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SePuedeMarcar}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Albarán" Binding="{Binding Albaran}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Texto" Binding="{Binding Texto}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Fact." Binding="{Binding Facturadas}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ya abonadas" Binding="{Binding YaAbonadas, StringFormat=0.##}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Quedan" Binding="{Binding Quedan, StringFormat=0.##}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Cantidad" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Marcada}"
                                                 HorizontalContentAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="No vendible">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding NoVendible, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Marcada}"
                                                  HorizontalAlignment="Center" ToolTip="Vuelve estropeado: queda anotado en el abono para regularizar el stock a mano"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Base" Binding="{Binding Importe, StringFormat=N2}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding ResumenSeleccion}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Opciones -->
        <GroupBox Grid.Row="2" Header="Opciones" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <CheckBox Content="Invertir cantidades (crear rectificativa/abono)"
                          IsChecked="{Binding InvertirCantidades}"
                          Style="{StaticResource CheckBoxStyle}"/>

                <CheckBox Content="Añadir al pedido original (en lugar de crear uno nuevo)"
                          IsChecked="{Binding AnadirAPedidoOriginal}"
                          Style="{StaticResource CheckBoxStyle}"/>

                <CheckBox Content="Crear albarán y factura automáticamente"
                          IsChecked="{Binding CrearAlbaranYFactura}"
                          Style="{StaticResource CheckBoxStyle}"/>

                <CheckBox Content="Crear abono y cargo (rectificativa al origen + factura al destino)"
                          IsChecked="{Binding CrearAbonoYCargo}"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="Crea una rectificativa al cliente origen y una factura nueva al cliente destino en un solo clic. Útil para corregir errores de dirección."/>

                <!-- NestoAPI#699: pedido devuelto por la agencia que el cliente sigue queriendo -->
                <CheckBox Content="El cliente lo sigue queriendo: rehacer el pedido"
                          IsChecked="{Binding RehacerPedido}"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="Hace el abono de la factura y, en el mismo paso, un pedido nuevo para el mismo cliente con las mismas líneas, precios, forma de pago y dirección de entrega. El pedido nuevo queda pendiente de servir y sale por el picking normal."/>
                <CheckBox Content="Cobrar otra vez los portes al cliente"
                          IsChecked="{Binding IncluirPortes}"
                          Style="{StaticResource CheckBoxStyle}"
                          Margin="20,0,0,8"
                          Visibility="{Binding RehacerPedido, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Si no se marca, los portes del reenvío no se cobran: la línea de portes pasa al pedido nuevo con un 100 % de descuento."/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                           Text="¿El abono ya está hecho y ahora el cliente lo quiere? Desmarque «Invertir cantidades» y deje el cliente destino vacío: se crea un pedido nuevo con las mismas líneas, pendiente de servir, sin albarán ni factura."/>

                <CheckBox Content="Mantener condiciones originales (precios, descuentos)"
                          IsChecked="{Binding MantenerCondicionesOriginales}"
                          Style="{StaticResource CheckBoxStyle}"/>

                <CheckBox Content="Usar vendedor de la factura original"
                          IsChecked="{Binding UsarVendedorFacturaOriginal}"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="Si se desmarca, cada documento usará el vendedor de la ficha del cliente correspondiente"/>

                <TextBlock Text="Comentarios:" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Comentarios, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="50"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Comentarios que se añadirán al pedido creado"/>
            </StackPanel>
        </GroupBox>

        <!-- Cliente destino -->
        <GroupBox Grid.Row="3" Header="Cliente Destino (opcional - dejar vacío para mismo cliente)" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Cliente:" Style="{StaticResource LabelStyle}"/>
                <controles:SelectorCliente
                    Empresa="{Binding DataContext.Empresa, ElementName=rootGrid, Mode=TwoWay}"
                    Cliente="{Binding DataContext.ClienteDestino, ElementName=rootGrid, Mode=TwoWay}"
                    Contacto="{Binding DataContext.ContactoDestino, ElementName=rootGrid, Mode=TwoWay}"
                    ClienteCompleto="{Binding DataContext.ClienteCompletoDestino, ElementName=rootGrid, Mode=TwoWay}"
                    Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Resultado -->
        <GroupBox Grid.Row="4" Header="Resultado" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <!-- TextBox de solo lectura para que se pueda copiar el mensaje -->
                <TextBox Text="{Binding Mensaje, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="0,0,0,10"
                         ToolTip="Seleccione el texto y pulse Ctrl+C para copiar"/>

                <StackPanel Orientation="Horizontal" Visibility="{Binding MostrarResultado, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="Pedido: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Resultado.NumeroPedido}"/>

                    <TextBlock Text="  |  Albaran: " FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneAlbaran}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Resultado.NumeroAlbaran}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneAlbaran}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  |  Factura: " FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneFactura}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Resultado.NumeroFactura}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneFactura}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Progress -->
        <ProgressBar Grid.Row="5" IsIndeterminate="True" Height="5" Margin="0,10"
                     Visibility="{Binding EstaProcesando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

    </Grid>
    </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Abrir Pedido" Command="{Binding AbrirPedidoCommand}"
                    Width="100" Height="35" Margin="0,0,10,0"
                    Visibility="{Binding MostrarResultado, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

            <Button Content="Ejecutar" Command="{Binding EjecutarCommand}"
                    Width="100" Height="35" Margin="0,0,10,0"/>

            <Button Content="Cerrar" Command="{Binding CancelarCommand}"
                    Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</UserControl>
