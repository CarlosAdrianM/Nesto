<UserControl x:Class="Nesto.Modulos.Cajas.CajasMenuBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Nesto.Modulos.Cajas"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Ribbon x:Name="MainMenu" x:FieldModifier="protected internal">
        <RibbonTab x:Name="tabContabilidad"
                        Header="Contabilidad">
            <RibbonGroup x:Name="grpCajas"
                            Header="Cajas">
                <RibbonButton Label="Cajas" LargeImageSource="Images/Cajas.png"  Command="{Binding AbrirModuloCajasCommand}" />
                <RibbonButton Label="Bancos" LargeImageSource="Images/Bancos.png"  Command="{Binding AbrirModuloBancosCommand}" />
                <RibbonButton Label="Mayor Cuenta" LargeImageSource="Images/MayorCuenta.png"  Command="{Binding AbrirModuloMayorCuentaCommand}" />
            </RibbonGroup>
            <!-- NestoAPI#522: facturas pendientes de Verifactu (sin registrar o incorrectas en la AEAT) -->
            <RibbonGroup x:Name="grpVerifactu"
                            Header="Verifactu">
                <RibbonButton Label="Facturas Verifactu" LargeImageSource="Images/FacturasVerifactu.png"  Command="{Binding AbrirFacturasVerifactuCommand}" />
            </RibbonGroup>
            <!-- Nesto#261: auditoría de enlaces de pago (quién y cuándo creó cada enlace y adónde se envió) -->
            <RibbonGroup x:Name="grpCobros"
                            Header="Cobros">
                <RibbonButton Label="Enlaces de pago" LargeImageSource="Images/Bancos.png"  Command="{Binding AbrirAuditoriaEnlacesPagoCommand}" />
            </RibbonGroup>
        </RibbonTab>
    </Ribbon>
</UserControl>
