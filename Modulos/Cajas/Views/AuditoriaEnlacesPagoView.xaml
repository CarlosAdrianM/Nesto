<UserControl x:Class="Nesto.Modulos.Cajas.Views.AuditoriaEnlacesPagoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <!-- Nesto#261: auditoría de enlaces de pago (solo lectura): quién y cuándo creó cada enlace, para qué
         cliente, por cuánto y adónde se envió. Solo Administración y Dirección. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSiVerdadero"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
    </UserControl.InputBindings>

    <xctk:BusyIndicator IsBusy="{Binding EstaOcupado}" BusyContent="Buscando...">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Enlaces de pago" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Identificador del enlace"/>
                    <TextBox Text="{Binding NumeroOrden, UpdateSourceTrigger=PropertyChanged}" Width="140" CharacterCasing="Upper"
                             ToolTip="El código que ve el cliente, p. ej. B9BC22C32366. Si se rellena, las fechas no cuentan."/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Desde"/>
                    <DatePicker SelectedDate="{Binding FechaDesde}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Hasta"/>
                    <DatePicker SelectedDate="{Binding FechaHasta}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Cliente"/>
                    <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Usuario"/>
                    <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Width="120"
                             ToolTip="Basta con una parte del nombre (con o sin el dominio)"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Estado"/>
                    <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" Width="110"/>
                </StackPanel>
                <Button Content="Consultar" Command="{Binding BuscarCommand}" Padding="12,2" FontWeight="Bold"
                        VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                <Button Content="Limpiar filtros" Command="{Binding LimpiarFiltrosCommand}" Padding="10,2"
                        VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </WrapPanel>

            <TextBlock Grid.Row="2" Text="{Binding Resumen}" FontWeight="Bold" Margin="0,0,0,6"/>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Enlaces}" AutoGenerateColumns="False"
                      SelectedItem="{Binding EnlaceSeleccionado}"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}"/>
                    <DataGridTextColumn Header="Identificador" Binding="{Binding NumeroOrden}"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCliente}" Width="180"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}"/>
                    <DataGridTextColumn Header="Correo" Binding="{Binding Correo}"/>
                    <DataGridTextColumn Header="Móvil (SMS)" Binding="{Binding Movil}"/>
                    <DataGridTextColumn Header="Documentos" Binding="{Binding Documentos}"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBox Grid.Row="4" Margin="0,10,0,0" Text="{Binding DetalleSeleccionado, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" BorderThickness="0" FontSize="13"
                     Visibility="{Binding HayEnlaceSeleccionado, Converter={StaticResource VisibleSiVerdadero}}"/>
        </Grid>
    </xctk:BusyIndicator>
</UserControl>
