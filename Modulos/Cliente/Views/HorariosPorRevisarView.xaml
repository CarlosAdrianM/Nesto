<UserControl x:Class="Nesto.Modulos.Cliente.HorariosPorRevisarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1000"
             Background="White">
    <!-- Nesto#584 (NestoAPI#763, corte 3): horarios preferibles sacados de los comentarios de las fichas, por revisar. -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

        <Border Grid.Row="1" Background="#FFF4E5" BorderBrush="#E0A040" BorderThickness="1" Padding="6,3" Margin="0,0,0,4">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Aviso, Mode=OneWay}" FontWeight="SemiBold"/>
                <LineBreak/>
                <Run Text="Revise cada propuesta con los comentarios de la ficha, corrija el horario si hace falta (formato «L-V 10:00-14:00, 17:00-20:00; S 10:00-13:00») y pulse «Aceptar». Si los comentarios no dicen un horario que valga, pulse «Descartar»."/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Aceptar" Command="{Binding AceptarCommand}" Padding="12,1" Margin="0,0,6,0"
                    ToolTip="Guarda como horario preferible del contacto lo que pone en «Horario a guardar»."/>
            <Button Content="Descartar" Command="{Binding DescartarCommand}" Padding="12,1" Margin="0,0,6,0"
                    ToolTip="Los comentarios no dicen un horario que valga: la propuesta deja de salir aquí."/>
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="8,1"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Propuestas}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Población" Binding="{Binding Poblacion}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Ruta" Binding="{Binding Ruta}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Comentarios" Binding="{Binding TextoOrigen}" IsReadOnly="True" Width="4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Horario a guardar" Binding="{Binding HorarioAGuardar, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding Mensaje}" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
