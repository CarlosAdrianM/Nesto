<UserControl x:Class="Nesto.Modulos.Cliente.CrearClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
             xmlns:local="clr-namespace:Nesto.Modulos.Cliente"
             mc:Ignorable="d"  Loaded="UserControl_Loaded"
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid FocusManager.FocusedElement="{Binding ElementName=txtNif}">
        <xctk:BusyIndicator IsBusy="{Binding EstaOcupado}" BusyContent="Cargando datos...">
            <Grid>
                <xctk:Wizard Name="WizardCrearCliente" 
                             CurrentPage="{Binding PaginaActual, Mode=TwoWay}"
                         CancelButtonVisibility="Hidden"
                         HelpButtonVisibility="Hidden"
                         CancelButtonClosesWindow="False"
                         FinishButtonClosesWindow="False" 
                         BackButtonContent="&lt; Anterior"
                         NextButtonContent="Siguiente &gt;"
                         FinishButtonContent="Finalizar">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Finish">
                            <i:InvokeCommandAction Command="{Binding CrearClienteCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <xctk:WizardPage x:Name="DatosFiscales" 
                                       Title="Datos Identificación Fiscal"
                                       Description="Introduzca los datos fiscales del cliente para poder comprobar su validez contra el servidor de Hacienda"
                                       CanSelectNextPage="{Binding SePuedeAvanzarADatosGenerales}"
                                     BackButtonVisibility="Hidden" Enter="DatosFiscales_Enter">

                        <Grid>
                            <!-- Nesto#431: el País va en su propia fila Auto con separadores de 3
                                 (como NIF/Nombre), en vez de pegado al NIF colgando de la fila
                                 elástica superior con VerticalAlignment=Bottom. -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!-- NestoAPI#355: país del cliente. Si no es ES, el NIF es un NIF-IVA
                                 extranjero y NO se valida contra la AEAT. -->
                            <TextBlock Grid.Column="1" Grid.Row="1" TextAlignment="Right" VerticalAlignment="Center">País</TextBlock>
                            <controles:SelectorPais Grid.Column="3" Grid.Row="1"
                                                    Seleccionado="{Binding ClientePais, Mode=TwoWay}"
                                                    VisibilidadEtiqueta="Collapsed"/>
                            <TextBlock Grid.Column="1" Grid.Row="3" TextAlignment="Right" VerticalAlignment="Center">NIF</TextBlock>
                            <TextBox Name="txtNif" Grid.Column="3" Grid.Row="3" Text="{Binding ClienteNif, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NifSinValidar}" KeyUp="TxtNif_KeyUp" GotFocus="TxtNif_GotFocus" PreviewMouseUp="TxtNif_PreviewMouseUp"></TextBox>
                            <TextBlock Grid.Column="1" Grid.Row="5" Visibility="{Binding NombreIsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" TextAlignment="Right" VerticalAlignment="Center">Nombre Fiscal</TextBlock>
                            <TextBox Name="txtNombre" Grid.Column="3" Grid.Row="5" Text="{Binding ClienteNombre, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NombreIsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" KeyUp="TxtNombre_KeyUp" GotFocus="TxtNombre_GotFocus" PreviewMouseUp="TxtNombre_PreviewMouseUp"></TextBox>
                            <!-- Nesto#523 (NestoAPI#623): origen del cliente (campaña), opcional. Para los leads de Meta de Harmonia la
                                 oficina elige el origen antes de pasarlo al vendedor. Sin catálogo en la API no se ve. -->
                            <TextBlock Grid.Column="1" Grid.Row="7" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Visibility="{Binding HayOrigenes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTip="Cómo nos conoció el cliente: nuestro primer contacto con él, no quién abre la ficha. Si ya nos conocía (cambio de datos, ficha nueva de un cliente de antes), deje el origen que tenía. Si no lo sabe, déjelo en «(ninguno)».">Origen</TextBlock>
                            <ComboBox Name="cmbOrigen" Grid.Column="3" Grid.Row="7" ItemsSource="{Binding Origenes}" DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding OrigenSeleccionado, Mode=TwoWay}"
                                      Visibility="{Binding HayOrigenes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="Cómo nos conoció el cliente: nuestro primer contacto con él, no quién abre la ficha. Si ya nos conocía (cambio de datos, ficha nueva de un cliente de antes), deje el origen que tenía. Si no lo sabe, déjelo en «(ninguno)»."/>
                        </Grid>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="DatosGenerales"
                                       Title="Datos Generales"
                                       Description="Introduzca los datos básicos de dirección, código postal y teléfono para poder localizar el centro"
                                     CanSelectPreviousPage="True"
                                     CanSelectNextPage="True"
                                     Enter="DatosGenerales_Enter">

                        <!-- 19/11/26: con la dirección de entrega la página crece; se desplaza en vez de cortarse. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- La dirección fiscal (la de siempre): el mismo bloque que la de entrega (BloqueDireccionAlta). -->
                            <local:BloqueDireccionAltaView x:Name="bloqueDireccionFiscal" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="1"
                                                           DataContext="{Binding DireccionFiscal}"/>
                            <!-- Nesto#523: al modificar se entra aquí directamente, así que el origen también se ve en este paso -->
                            <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3"
                                  Visibility="{Binding MostrarOrigenEnDatosGenerales, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" TextAlignment="Right" VerticalAlignment="Center">Origen</TextBlock>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Origenes}" DisplayMemberPath="Nombre"
                                          SelectedItem="{Binding OrigenSeleccionado, Mode=TwoWay}"
                                          ToolTip="Cómo nos conoció el cliente: nuestro primer contacto con él, no quién abre la ficha. Si ya nos conocía (cambio de datos, ficha nueva de un cliente de antes), deje el origen que tenía. Si no lo sabe, déjelo en «(ninguno)»."/>
                            </Grid>
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="7" Text="{Binding ClienteNumero,StringFormat='Creando contacto (ya existe el cliente {0})'}"  FontSize="24" Visibility="{Binding EsCreandoContacto,Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Foreground="Red"></TextBlock>
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="7" Text="{Binding ClienteNumero,StringFormat='Modificando el cliente {0}'}"  FontSize="24" Visibility="{Binding EsUnaModificacion,Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Foreground="Red"></TextBlock>
                            <Border Grid.Column="5" Grid.Row="0" BorderBrush="LightGreen" BorderThickness="3" CornerRadius="15" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteNombre}" FontWeight="ExtraBold"></TextBlock>
                                    <TextBlock Text="{Binding ClienteDireccionCalleNumero}"></TextBlock>
                                    <TextBlock Text="{Binding ClienteNumeroCalle, StringFormat='Número: {0}'}" Visibility="{Binding NumeroSinDarPorGoogle, Converter={StaticResource BooleanToVisibilityConverter}}"></TextBlock>
                                    <TextBlock Text="{Binding Direccion2Compuesta}"></TextBlock>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} ({2})">
                                                <Binding Path="ClienteCodigoPostal"/>
                                                <Binding Path="ClientePoblacion"/>
                                                <Binding Path="ClienteProvincia"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📞 "></TextBlock>
                                        <TextBlock Text="{Binding ClienteTelefono}"></TextBlock>
                                    </StackPanel>
                                    <TextBlock></TextBlock>
                                    <TextBlock Text="{Binding ClienteNif}"></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="DatosComisiones" 
                                       Title="Datos Comisiones"
                                       Description="Dependiendo del tipo de centro que sea, se le asignará vendedor de estética, de peluquería o ambos. Las alumnas y el público final no llevan vendedor."
                                     CanSelectPreviousPage="True"
                                       CanSelectNextPage="{Binding SePuedeAvanzarADatosPago}" Enter="DatosComisiones_Enter">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ClienteVendedorEstetica}" Visibility="{Binding ClienteTieneEstetica,Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="Green" HorizontalAlignment="Right"></TextBlock>
                            <CheckBox Name="chkTieneEstetica" Grid.Column="3" Grid.Row="1" IsChecked="{Binding ClienteTieneEstetica}">¿Tiene Estética?</CheckBox>
                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding VendedorPeluqueriaMostrar}" Visibility="{Binding ClienteTienePeluqueria,Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="Green" HorizontalAlignment="Right"></TextBlock>
                            <CheckBox Name="chkTienePeluqueria" Grid.Column="3" Grid.Row="3" IsChecked="{Binding ClienteTienePeluqueria}">¿Tiene Peluquería?</CheckBox>
                            <!-- Nesto#555 (sugerencia 770): sin vendedor; el estado (10 alumna, 8 público) lo pone la API -->
                            <CheckBox Name="chkEsAlumna" Grid.Column="3" Grid.Row="5" Grid.ColumnSpan="2" IsChecked="{Binding ClienteEsAlumna}" ToolTip="Alumna de cursos y eventos: queda con estado Alumna y sin vendedor (NV)">¿Es alumna? (cursos y eventos)</CheckBox>
                            <CheckBox Name="chkEsPublico" Grid.Column="3" Grid.Row="7" Grid.ColumnSpan="2" IsChecked="{Binding ClienteEsPublico}" ToolTip="Profesional de otro sector que pide factura: queda como público final y sin vendedor (NV)">¿Es público final? (otro sector, pide factura)</CheckBox>

                            <Border Grid.Column="5" Grid.Row="0" BorderBrush="Green" BorderThickness="3" CornerRadius="15" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteNombre}" FontWeight="ExtraBold"></TextBlock>
                                    <TextBlock Text="{Binding ClienteDireccion}" TextWrapping="Wrap"></TextBlock>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} ({2})">
                                                <Binding Path="ClienteCodigoPostal"/>
                                                <Binding Path="ClientePoblacion"/>
                                                <Binding Path="ClienteProvincia"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📞 "></TextBlock>
                                        <TextBlock Text="{Binding ClienteTelefono}"></TextBlock>
                                    </StackPanel>
                                    <TextBlock></TextBlock>
                                    <TextBlock Text="{Binding ClienteNif}"></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="DatosPago" 
                                       Title="Datos de Pago"
                                       Description="Aquí especificamos las formas de pago por defecto e informos el IBAN en caso de tenerlo."
                                       CanSelectPreviousPage="True"
                                       CanSelectNextPage="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <RadioButton Name="optEfectivo" Grid.Row="1" Grid.Column="3" IsChecked="{Binding FormaPagoEfectivo}">Efectivo</RadioButton>
                            <RadioButton Name="optTarjeta" Grid.Row="3" Grid.Column="3" IsChecked="{Binding FormaPagoTarjeta}">Tarjeta</RadioButton>
                            <RadioButton Name="optRecibo" Grid.Row="5" Grid.Column="3" IsChecked="{Binding FormaPagoRecibo}" Checked="OptRecibo_Checked">Recibo banco</RadioButton>
                            <TextBox Name="txtIban" Grid.Row="7" Grid.Column="3" Text="{Binding ClienteIban}" Visibility="{Binding FormaPagoRecibo, Converter={StaticResource BooleanToVisibilityConverter}}"></TextBox>
                            
                            
                            <Border Grid.Column="5" Grid.Row="0" BorderBrush="Green" BorderThickness="3" CornerRadius="15" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteNombre}" FontWeight="ExtraBold"></TextBlock>
                                    <TextBlock Text="{Binding ClienteDireccion}"  TextWrapping="Wrap"></TextBlock>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} ({2})">
                                                <Binding Path="ClienteCodigoPostal"/>
                                                <Binding Path="ClientePoblacion"/>
                                                <Binding Path="ClienteProvincia"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📞 "></TextBlock>
                                        <TextBlock Text="{Binding ClienteTelefono}"></TextBlock>
                                    </StackPanel>
                                    <TextBlock></TextBlock>
                                    <TextBlock Text="{Binding ClienteNif}"></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="DatosContacto" 
                                       Title="Datos de Contacto"
                                       Description="Aquí especificamos las personas de contacto."
                                       CanSelectPreviousPage="True"
                                       CanSelectNextPage="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" HorizontalContentAlignment="Stretch" ItemsSource="{Binding PersonasContacto}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="3,0" VerticalAlignment="Center">Nombre:</TextBlock>
                                            <TextBox Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding Nombre}"></TextBox>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="3,0">Correo-e:</TextBlock>
                                            <TextBox Grid.Column="3" VerticalContentAlignment="Center" Text="{Binding CorreoElectronico}"></TextBox>
                                            <CheckBox Grid.Column="4" VerticalContentAlignment="Center" IsChecked="{Binding FacturacionElectronica}">Facturación Electrónica</CheckBox>
                                            <Button Grid.Column="5" Margin="3" Command="{Binding RelativeSource={RelativeSource FindAncestor, 
                                                    AncestorType={x:Type UserControl}}, Path=DataContext.BorrarPersonaContactoCommand}" 
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center">🗑</Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Command="{Binding AnnadirPersonaContactoCommand}">Añadir Nueva Persona de Contacto</Button>


                            <Border Grid.Column="5" Grid.Row="0" BorderBrush="Green" BorderThickness="3" CornerRadius="15" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteNombre}" FontWeight="ExtraBold"></TextBlock>
                                    <TextBlock Text="{Binding ClienteDireccion}"  TextWrapping="Wrap"></TextBlock>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} ({2})">
                                                <Binding Path="ClienteCodigoPostal"/>
                                                <Binding Path="ClientePoblacion"/>
                                                <Binding Path="ClienteProvincia"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📞 "></TextBlock>
                                        <TextBlock Text="{Binding ClienteTelefono}"></TextBlock>
                                    </StackPanel>
                                    <TextBlock></TextBlock>
                                    <TextBlock Text="{Binding ClienteNif}"></TextBlock>
                                </StackPanel>
                            </Border>
                            <GroupBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Días que sirve (el picking no saca pedidos cuya entrega caiga en un día cerrado)" Margin="3" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <CheckBox Margin="3" IsChecked="{Binding SirveLunes}">Lunes</CheckBox>
                                    <CheckBox Margin="3" IsChecked="{Binding SirveMartes}">Martes</CheckBox>
                                    <CheckBox Margin="3" IsChecked="{Binding SirveMiercoles}">Miércoles</CheckBox>
                                    <CheckBox Margin="3" IsChecked="{Binding SirveJueves}">Jueves</CheckBox>
                                    <CheckBox Margin="3" IsChecked="{Binding SirveViernes}">Viernes</CheckBox>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock Grid.Row="7" Grid.Column="3" Margin="3">Comentarios</TextBlock>
                            <TextBox Grid.Row="8" Grid.Column="3" Background="LightYellow" Text="{Binding ClienteComentarios, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" AcceptsReturn="True" SpellCheck.IsEnabled="True"></TextBox>
                            <TextBlock Grid.Row="7" Grid.Column="4" Margin="3">Comentarios Picking</TextBlock>
                            <TextBox Grid.Row="8" Grid.Column="4" Background="LightYellow" Text="{Binding ClienteComentariosPicking, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" AcceptsReturn="True" SpellCheck.IsEnabled="True"></TextBox>
                            <TextBlock Grid.Row="7" Grid.Column="5" Margin="3">Comentarios Ruta</TextBlock>
                            <TextBox Grid.Row="8" Grid.Column="5" Background="LightYellow" Text="{Binding ClienteComentariosRuta, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" AcceptsReturn="True" SpellCheck.IsEnabled="True"></TextBox>
                        </Grid>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="Finalizar" PageType="Interior"
                                       Title="Finalizar"
                                       Description="Ya tenemos toda la información necesaria. Pulse el botón finalizar para crear el cliente en Nesto."
                                       CanFinish="{Binding SePuedeCrearCliente}">

                        <StackPanel>
                            <!-- Nesto#480: sin dirección elegida de Google no se crea el cliente. -->
                            <TextBlock Text="{Binding MotivoNoSePuedeCrearCliente}" TextWrapping="Wrap"
                                       Foreground="Red" FontWeight="Bold" Margin="10"
                                       Visibility="{Binding NoSePuedeCrearCliente, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                    </xctk:WizardPage>
                </xctk:Wizard>
            </Grid>
        </xctk:BusyIndicator>
    </Grid>
</UserControl>
