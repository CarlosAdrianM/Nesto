<UserControl x:Class="Nesto.Modulos.Cliente.ExtractoClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>

    <xctk:BusyIndicator IsBusy="{Binding EstaOcupado}" BusyContent="Trabajando...">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Extracto de Cliente" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Cliente:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <controles:SelectorCliente Name="txtSelectorCliente"
                                           Empresa="1"
                                           MinWidth="300"
                                           Cliente="{Binding Path=DataContext.ClienteSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="Cargar pendientes" Command="{Binding CargarCommand}" Margin="10,0,0,0" Padding="10,2"/>
                <Button Content="Liquidar seleccionados" Command="{Binding LiquidarCommand}" Margin="10,0,0,0" Padding="10,2" FontWeight="Bold"/>
                <!-- NestoAPI#591: marcar un cobro a favor como señal de un evento (solo Administración) -->
                <Button Content="Es la señal del evento…" Command="{Binding MarcarSenalCommand}" Margin="20,0,0,0" Padding="10,2"
                        ToolTip="El apunte seleccionado (un cobro a favor) es la señal de un curso o evento"
                        Visibility="{Binding PuedeMarcarSenales, Converter={StaticResource BoolAVisibilidad}}"/>
                <Button Content="Quitar señal" Command="{Binding QuitarSenalCommand}" Margin="10,0,0,0" Padding="10,2"
                        Visibility="{Binding PuedeMarcarSenales, Converter={StaticResource BoolAVisibilidad}}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False"
                      SelectedItem="{Binding MovimientoSeleccionado}"
                      CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" ColumnWidth="Auto">
                <DataGrid.ContextMenu>
                    <ContextMenu Visibility="{Binding PuedeMarcarSenales, Converter={StaticResource BoolAVisibilidad}}">
                        <MenuItem Header="Es la señal del evento…" Command="{Binding MarcarSenalCommand}"/>
                        <MenuItem Header="Quitar señal" Command="{Binding QuitarSenalCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsSenal}" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Liquidar" Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Nº Orden" Binding="{Binding Id}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Emp." Binding="{Binding Empresa}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=d}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True"/>
                    <!-- Nesto#478: doble clic en el documento o el botón de la derecha abren la factura;
                         el botón solo se activa cuando el servidor dice que ese documento es una factura. -->
                    <DataGridTemplateColumn Header="Documento" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Documento}" VerticalAlignment="Center" Margin="2,0,6,0">
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.AbrirFacturaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <Button Content="Ver factura" Padding="4,0" FontSize="10"
                                            ToolTip="Abrir la factura (solo si el documento es una factura)"
                                            Command="{Binding DataContext.AbrirFacturaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Efecto" Binding="{Binding Efecto}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Señal" Binding="{Binding SenalTexto}" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=c}" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style>
                                <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Pendiente" Binding="{Binding ImportePendiente, StringFormat=c}" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style>
                                <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding Vencimiento, StringFormat=d}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="F. Pago" Binding="{Binding FormaPago}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="CCC" Binding="{Binding Ccc}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding AvisoSenales}" Foreground="DarkRed" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="0,8,0,0"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock Text="Total pendiente: " FontWeight="Bold"/>
                <TextBlock Text="{Binding TotalPendiente, StringFormat=c}" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </xctk:BusyIndicator>
</UserControl>
