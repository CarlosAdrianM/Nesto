<UserControl x:Class="Nesto.Modulos.Cliente.OrigenClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="800"
             Background="White">
    <!-- Nesto#523 (NestoAPI#623): origen del cliente (campaña) en la ficha. «Origen: Lead de Meta · campaña Harmonia (05/11/26, Paloma)».
         Dirección, Administración, Vendedores y Tiendas lo cambian con el desplegable y «Guardar origen»; el resto lo ve en texto. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="Raiz" Visibility="{Binding Disponible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Origen:" VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="Campaña de la que viene el cliente (por ejemplo, un lead de Meta)"/>
            <TextBlock Text="{Binding TextoOrigen}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <!-- Quien puede cambiarlo -->
            <ComboBox ItemsSource="{Binding Opciones}" DisplayMemberPath="Nombre" SelectedItem="{Binding OpcionSeleccionada, Mode=TwoWay}"
                      MinWidth="200" VerticalAlignment="Center" IsEnabled="{Binding SePuedeElegir}"
                      Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ToolTip="Elija el origen y pulse «Guardar origen»"/>
            <Button Content="Guardar origen" Command="{Binding GuardarCommand}" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkGreen" TextWrapping="Wrap"
                       Visibility="{Binding HayMensaje, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
