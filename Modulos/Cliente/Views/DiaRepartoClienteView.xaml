<UserControl x:Class="Nesto.Modulos.Cliente.DiaRepartoClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="800"
             Background="White">
    <!-- Nesto#606 (NestoAPI#799): «Día de reparto propio» del contacto, excepción al día de su código postal. Se guarda al
         elegir el día; el motivo cambiado, con «Guardar motivo». Solo Dirección, Almacén y Administración lo cambian. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="Raiz" Visibility="{Binding Disponible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Día de reparto propio:" VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="Excepción al día de reparto que le toca por su código postal (solo esta dirección de entrega)"/>
            <!-- Quien puede cambiarlo -->
            <ComboBox ItemsSource="{Binding Opciones}" DisplayMemberPath="Nombre" SelectedItem="{Binding OpcionSeleccionada, Mode=TwoWay}"
                      MinWidth="140" VerticalAlignment="Center" IsEnabled="{Binding SePuedeElegir}"
                      Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ToolTip="Se guarda al elegirlo y se recalculan los pedidos pendientes de esta dirección"/>
            <TextBlock Text="Motivo:" VerticalAlignment="Center" Margin="8,0,4,0"
                       Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" VerticalAlignment="Center"
                     IsEnabled="{Binding SePuedeElegir}"
                     Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"
                     ToolTip="Por ejemplo: «Solo abre los miércoles». Escríbalo antes de elegir el día o pulse «Guardar motivo»"/>
            <Button Content="Guardar motivo" Command="{Binding GuardarMotivoCommand}" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding PuedeCambiar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <!-- Solo lectura para el resto -->
            <TextBlock Text="{Binding TextoDia}" VerticalAlignment="Center" FontWeight="SemiBold"
                       Visibility="{Binding SoloLectura, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Detalle}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontStyle="Italic"/>
            <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkGreen" TextWrapping="Wrap"
                       Visibility="{Binding HayMensaje, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
