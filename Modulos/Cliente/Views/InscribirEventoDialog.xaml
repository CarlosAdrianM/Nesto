<UserControl x:Class="Nesto.Modulos.Cliente.InscribirEventoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
             x:Name="raizDialogo"
             MinWidth="560" MinHeight="360"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Evento:" Width="110" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Eventos}" SelectedItem="{Binding Evento}" DisplayMemberPath="Descripcion" Width="360"
                          IsEnabled="{Binding SinInscribir}"/>
            </StackPanel>
            <TextBlock Text="{Binding TextoEvento}" Foreground="DimGray" Margin="110,2,0,0"/>

            <!-- Carlos 29/10/26: desde la ficha el cliente viene dado; desde el mantenimiento se busca con el selector de Nesto
                 (por nombre, número, NIF…) y el contacto se elige pinchando en la dirección. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ClienteFijo, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="Cliente:" Width="110" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TextoClienteFijo}" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="400"/>
            </StackPanel>
            <Grid Margin="0,8,0,0" Visibility="{Binding ClienteElegible, Converter={StaticResource BoolAVisibilidad}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cliente:" VerticalAlignment="Top" Margin="0,3,0,0"/>
                <controles:SelectorCliente Grid.Column="1" Etiqueta="" Width="360" MaxHeight="260" HorizontalAlignment="Left"
                                           IsEnabled="{Binding DataContext.SinInscribir, ElementName=raizDialogo}"
                                           Empresa="{Binding DataContext.Empresa, ElementName=raizDialogo, Mode=TwoWay}"
                                           Cliente="{Binding DataContext.Cliente, ElementName=raizDialogo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Contacto="{Binding DataContext.Contacto, ElementName=raizDialogo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           ToolTip="Busque al cliente por nombre, número, NIF o teléfono. Pinche en la dirección para elegir otro contacto"/>
            </Grid>

            <!-- Nesto#566 (NestoAPI#731): la persona de contacto que asiste (opcional) -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Asiste:" Width="110" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Personas}" SelectedItem="{Binding PersonaAsiste}" DisplayMemberPath="Texto" Width="360"
                          IsEnabled="{Binding SinInscribir}"
                          ToolTip="Opcional: la persona de contacto del cliente que va a asistir. Si no está, dé de alta a la persona en la ficha del cliente"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Se inscribe por:" Width="110" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Origenes}" SelectedItem="{Binding Origen}" Width="240"/>
            </StackPanel>

            <!-- NestoAPI#690: reembolsable (con cupón), no reembolsable (sin cupón) o gratuita -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HayVariasModalidades, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="Modalidad:" Width="110" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding Modalidad}" Width="360"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HayQuePagar, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="Va a pagar con:" Width="110" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPago}" Width="240"/>
            </StackPanel>
            <StackPanel Margin="110,6,0,0" Visibility="{Binding EsTarjeta, Converter={StaticResource BoolAVisibilidad}}">
                <CheckBox Content="Generar el enlace de pago" IsChecked="{Binding GenerarEnlacePago}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Mandarlo al correo:" VerticalAlignment="Top" Margin="0,3,5,0"/>
                    <!-- Carlos 29/10/26: los correos de las personas de contacto del cliente, o uno nuevo -->
                    <controles:SelectorCorreo Correos="{Binding Correos}" Correo="{Binding Correo, Mode=TwoWay}" Width="270"
                                              AyudaCorreo="Opcional: elija uno de los correos del cliente o escriba otro; se le manda el enlace de pago. Vacío: no se manda"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding AvisoFormaPago}" Foreground="DimGray" TextWrapping="Wrap" Margin="110,6,0,0" MaxWidth="400" HorizontalAlignment="Left"/>

            <!-- Tras inscribir: el estado y el enlace para copiarlo -->
            <Border Margin="0,12,0,0" Padding="8" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                    Visibility="{Binding Inscrito, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel MaxWidth="500">
                    <TextBlock Text="{Binding TextoInscrito}" TextWrapping="Wrap"/>
                    <!-- Carlos 29/10/26: el enlace se copia solo; aquí se ve y se puede volver a copiar -->
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding TieneEnlace, Converter={StaticResource BoolAVisibilidad}}">
                        <Button DockPanel.Dock="Right" Content="Copiar enlace" Command="{Binding CopiarEnlaceCommand}" Padding="10,2"
                                Margin="6,0,0,0" FontWeight="Bold"/>
                        <TextBox Text="{Binding Inscripcion.UrlPago, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TextoEnlace}" FontWeight="Bold" Foreground="#1B5E20" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding TieneEnlace, Converter={StaticResource BoolAVisibilidad}}"/>
                </StackPanel>
            </Border>

            <!-- Sugerencia 776: avisos de la API (p. ej. a la ficha le falta el teléfono o el correo); no impiden nada -->
            <Border Margin="0,8,0,0" Padding="8" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                    Visibility="{Binding HayAvisos, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="{Binding TextoAvisos}" TextWrapping="Wrap" Foreground="#5D4037"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Inscribir" Command="{Binding InscribirCommand}" Width="90" Margin="0,0,10,0" IsDefault="True" FontWeight="Bold"/>
            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
