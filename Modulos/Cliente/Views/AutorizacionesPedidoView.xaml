<UserControl x:Class="Nesto.Modulos.Cliente.AutorizacionesPedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Nesto.Modulos.Cliente"
             d:DataContext="{d:DesignInstance Type=local:AutorizacionesPedidoViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
    </UserControl.Resources>
    <!-- Novedades 1258: solicitudes de autorización de pedidos que no pasan la validación de ofertas y descuentos. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="12,2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Vuelve a leer las solicitudes" />
            <TextBlock Text="Un momento…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding EstaOcupado, Converter={StaticResource BoolAVisibilidad}}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Ayuda}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Ver también las resueltas" IsChecked="{Binding VerResueltas}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Solicitudes}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstaPendiente}" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding TextoFecha}" />
                <DataGridTextColumn Header="Vendedor" Binding="{Binding Vendedor}" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="1.5*" />
                <DataGridTextColumn Header="Importe" Binding="{Binding TextoImporte}" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                <DataGridTextColumn Header="Motivos" Binding="{Binding TextoMotivos}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- La solicitud elegida: el borrador con las líneas que no pasan marcadas, y las acciones -->
        <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="12" Margin="0,8,0,0"
                Visibility="{Binding HaySeleccionada, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
                <TextBlock Text="{Binding Seleccionada.Cliente}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="Comentario de quien la pide: " FontWeight="SemiBold" /><Run Text="{Binding Comentario, Mode=OneWay, TargetNullValue='—'}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Text="{Binding Seleccionada.TextoResolucion}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Visibility="{Binding Seleccionada.HayResolucion, Converter={StaticResource BoolAVisibilidad}, FallbackValue=Collapsed}" />

                <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" Margin="0,8,0,0" MaxHeight="260">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConError}" Value="True">
                                    <Setter Property="Background" Value="#FFFDE2E2" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding TextoPrecio}" />
                        <DataGridTextColumn Header="Descuento" Binding="{Binding TextoDescuento}" />
                        <DataGridTextColumn Header="Oferta" Binding="{Binding TextoOferta}" />
                        <DataGridTextColumn Header="Por qué no pasa" Binding="{Binding MotivoError}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Foreground" Value="DarkRed" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Autorizar y crear el pedido" Padding="12,2" Margin="0,0,8,4" Command="{Binding AutorizarCommand}"
                            Visibility="{Binding PuedeAutorizar, Converter={StaticResource BoolAVisibilidad}}"
                            ToolTip="Crea el pedido tal cual lo mandó el vendedor, sin pasar la validación" />
                    <Button Content="Denegar" Padding="12,2" Margin="0,0,8,4" Command="{Binding DenegarCommand}"
                            Visibility="{Binding PuedeAutorizar, Converter={StaticResource BoolAVisibilidad}}"
                            ToolTip="Pide el motivo, que le llega a quien la pidió" />
                    <Button Content="Anular mi solicitud" Padding="12,2" Margin="0,0,8,4" Command="{Binding AnularCommand}"
                            Visibility="{Binding PuedeAnularSeleccionada, Converter={StaticResource BoolAVisibilidad}}" />
                    <Button Content="Abrir el pedido creado" Padding="12,2" Margin="0,0,8,4" Command="{Binding AbrirPedidoCreadoCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
