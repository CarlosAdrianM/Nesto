<UserControl x:Class="Nesto.Modulos.Cliente.CuponesClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="900"
             Background="White">
    <!-- Nesto#518 (NestoAPI#613): los cupones del cliente en su ficha. Dirección emite cupones manuales (con motivo) y
         Administración o Dirección anulan los que no se han usado. Las reglas y los permisos los comprueba la API. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="Raiz" Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
            <Button Content="Actualizar" Command="{Binding RecargarCommand}" Padding="8,1" Margin="0,0,6,0"
                    ToolTip="Vuelve a leer los cupones del cliente."/>
            <Button Content="Emitir cupón manual…" Command="{Binding EmitirManualCommand}" Padding="8,1" Margin="0,0,6,0"
                    Visibility="{Binding PuedeEmitirManual, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Cupón sin evento, solo Dirección: importe con el IVA incluido y motivo obligatorio. Pedido mínimo el doble; caduca a los 6 meses."/>
            <Button Content="Anular cupón…" Command="{Binding AnularCommand}" Padding="8,1"
                    Visibility="{Binding PuedeAnular, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Anula el cupón seleccionado si no se ha usado (por ejemplo, por la devolución del curso)."/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" FontStyle="Italic" Margin="0,2"
                   Visibility="{Binding HayMensaje, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Cupones}" SelectedItem="{Binding CuponSeleccionado}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="Auto"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto"/>
                <DataGridTextColumn Header="Importe (IVA incl.)" Binding="{Binding Importe, StringFormat=c}" Width="Auto">
                    <DataGridTextColumn.CellStyle>
                        <Style>
                            <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Pedido mínimo" Binding="{Binding PedidoMinimo, StringFormat=c}" Width="Auto">
                    <DataGridTextColumn.CellStyle>
                        <Style>
                            <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Válido desde" Binding="{Binding ValidoDesde, StringFormat=d}" Width="Auto"/>
                <DataGridTextColumn Header="Caduca" Binding="{Binding Caducidad, StringFormat=d}" Width="Auto"/>
                <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="2*"/>
                <DataGridTextColumn Header="Situación" Binding="{Binding Situacion}" Width="3*"/>
                <DataGridTextColumn Header="Factura del curso" Binding="{Binding FacturaOrigen}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
