<UserControl x:Class="Nesto.Modulos.Cliente.AnunciarEventoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="480" MinHeight="220"
             Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="{Binding UltimoAnuncio}" Foreground="DimGray" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Reclamo del aviso (elija uno o escríbalo; obligatorio):" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Reclamos}" IsEditable="True" IsTextSearchEnabled="False"
                      Text="{Binding Reclamo, UpdateSourceTrigger=PropertyChanged}" Width="440" HorizontalAlignment="Left"/>
            <DockPanel Width="440" HorizontalAlignment="Left" Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TextoCaracteres}" Foreground="DimGray" FontSize="11"/>
                <TextBlock Text="{Binding Aviso}" Foreground="Firebrick" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anunciar" Command="{Binding AnunciarCommand}" IsDefault="True" Padding="15,3" FontWeight="Bold"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" IsCancel="True" Padding="15,3" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
