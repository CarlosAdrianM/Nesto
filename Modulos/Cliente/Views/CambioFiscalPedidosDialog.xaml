<UserControl x:Class="Nesto.Modulos.Cliente.CambioFiscalPedidosDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nesto.Modulos.Cliente"
             MinWidth="640" MinHeight="360"
             Background="White">
    <!-- NestoAPI#876 (corte nuevo): tras el alta de un cliente que cambia de forma fiscal, ¿se pasan al nuevo los pedidos pendientes del anterior? -->
    <DockPanel Margin="15">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Texto}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Padding="14,3" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <local:PedidosCambioFiscalPanel DataContext="{Binding Paso}"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
