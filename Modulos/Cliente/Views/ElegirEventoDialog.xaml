<UserControl x:Class="Nesto.Modulos.Cliente.ElegirEventoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="460" MinHeight="320"
             Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Elige el evento del que es la señal el apunte"/>
            <Run Text="{Binding Apunte, Mode=OneWay}" FontWeight="Bold"/><Run Text="."/>
            <LineBreak/>
            <Run Text="Hasta la fecha del evento la señal queda reservada; desde ese día se descuenta de la primera compra." Foreground="DimGray"/>
        </TextBlock>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Eventos}"
                 SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                 MouseDoubleClick="ListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Fecha, StringFormat=dd/MM/yyyy}" FontWeight="Bold" Width="85"/>
                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" MinWidth="220"/>
                        <TextBlock Text="{Binding ImporteSenal, StringFormat=c}" Foreground="DimGray" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Aceptar" Command="{Binding AceptarCommand}" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
