<UserControl x:Class="Nesto.Modulos.Cliente.MantenimientoEventosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>

    <xctk:BusyIndicator IsBusy="{Binding EstaOcupado}" BusyContent="Trabajando...">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Eventos" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Nuevo evento" Command="{Binding NuevoCommand}" Padding="15,2" FontWeight="Bold"/>
                <Button Content="Recargar" Command="{Binding CargarCommand}" Margin="10,0,0,0" Padding="15,2"/>
                <TextBlock Text="Cursos y masterclass de cada tienda. Se inscribe al cliente sin pedido; con la señal pagada tiene la plaza."
                           Foreground="DimGray" VerticalAlignment="Center" Margin="15,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Eventos}" AutoGenerateColumns="False"
                      SelectedItem="{Binding Seleccionado}"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" ColumnWidth="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"/>
                    <DataGridTextColumn Header="Horario" Binding="{Binding TextoHorario}"/>
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                    <DataGridTextColumn Header="Tienda" Binding="{Binding NombreTienda}"/>
                    <DataGridTextColumn Header="Curso" Binding="{Binding ProductoCurso}"/>
                    <DataGridTextColumn Header="Señal (reemb. / no reemb.)" Binding="{Binding TextoSenales}"/>
                    <DataGridTextColumn Header="Ponente" Binding="{Binding Ponente}"/>
                    <DataGridTextColumn Header="Plazas" Binding="{Binding TextoPlazas}"/>
                    <DataGridTextColumn Header="Lugar" Binding="{Binding Lugar}"/>
                    <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}"/>
                    <DataGridTextColumn Header="Lista pasada" Binding="{Binding FechaListaAsistencia, StringFormat=g}"/>
                    <DataGridTextColumn Header="Modificado por" Binding="{Binding Usuario}"/>
                    <DataGridTextColumn Header="El" Binding="{Binding FechaModificacion, StringFormat=g}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ficha del evento -->
                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,1,1,0" Padding="0,10,10,0"
                        IsEnabled="{Binding Editando}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Nuevo evento" FontWeight="Bold" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Título:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding TituloEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Fecha:" VerticalAlignment="Center" Width="110"/>
                                <DatePicker SelectedDate="{Binding FechaEdicion}" Width="140"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Tienda:" VerticalAlignment="Center" Width="110"/>
                                <ComboBox ItemsSource="{Binding Tiendas}" SelectedItem="{Binding TiendaEdicion}" Width="200"
                                          ToolTip="La tienda donde es el evento: la mantiene esa tienda, Administración y Dirección"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Horario:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding HoraInicioEdicion, UpdateSourceTrigger=PropertyChanged}" Width="55" VerticalContentAlignment="Center"
                                         ToolTip="Hora de inicio, como 10:00"/>
                                <TextBlock Text="a" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Text="{Binding HoraFinEdicion, UpdateSourceTrigger=PropertyChanged}" Width="55" VerticalContentAlignment="Center"
                                         ToolTip="Hora de fin, como 13:00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Ponente:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding PonenteEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Señal reembolsable:" VerticalAlignment="Center" Width="110" ToolTip="Factura el curso exento y emite un cupón por el mismo importe"/>
                                <xctk:DecimalUpDown Value="{Binding ImporteSenalEdicion}" FormatString="C2" Minimum="0" Increment="5" Width="110"
                                                    ToolTip="Con cupón por el mismo importe (IVA incluido)"/>
                                <TextBlock Text="No reembolsable:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <xctk:DecimalUpDown Value="{Binding ImporteSenalNoReembolsableEdicion}" FormatString="C2" Minimum="0" Increment="5" Width="110"
                                                    ToolTip="Factura el curso exento, sin cupón. Las dos a 0: evento gratuito"/>
                            </StackPanel>
                            <TextBlock Text="Las dos señales a 0: el evento es gratuito (se apunta quien quiera, sin pagar)." Foreground="DimGray"
                                       TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Margin="110,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Referencia curso:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding ProductoCursoEdicion, UpdateSourceTrigger=PropertyChanged}" Width="140" MaxLength="15"
                                         VerticalContentAlignment="Center"
                                         ToolTip="El producto del curso (uno por curso, exento de IVA), con el que se factura"/>
                                <Button Content="Comprobar" Command="{Binding ComprobarProductoCommand}" Margin="6,0,0,0" Padding="8,1"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NombreProductoCurso}" Foreground="DimGray" TextWrapping="Wrap" MaxWidth="320"
                                       HorizontalAlignment="Left" Margin="110,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Plazas:" VerticalAlignment="Center" Width="110"/>
                                <xctk:IntegerUpDown Value="{Binding PlazasEdicion}" Minimum="1" Width="80"
                                                    ToolTip="Vacío: sin límite de plazas"/>
                                <TextBlock Text="(vacío = sin límite)" Foreground="DimGray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Lugar:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding LugarEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Descripción:" VerticalAlignment="Top" Width="110"/>
                                <TextBox Text="{Binding DescripcionLargaEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="70"
                                         MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Imagen:" VerticalAlignment="Top" Width="110"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Width="160" Height="90">
                                    <Grid>
                                        <TextBlock Text="Sin imagen" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ImagenUrl, TargetNullValue={x:Null}}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="6,0,0,0">
                                    <Button Content="Subir imagen…" Command="{Binding SubirImagenCommand}" Padding="8,1"
                                            ToolTip="PNG, JPEG, GIF o WebP de hasta 10 MB. Pueden subirla la tienda del evento, Tienda online y Dirección"/>
                                    <Button Content="Quitar" Command="{Binding QuitarImagenCommand}" Padding="8,1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="Activo (admite inscripciones y sale al marcar señales)" IsChecked="{Binding ActivoEdicion}" Margin="110,8,0,0"/>
                            <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="110,12,0,0" Padding="20,3"
                                    FontWeight="Bold" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Nesto#517: inscritos del evento seleccionado -->
                <Grid Grid.Column="1" Margin="10,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Inscritos" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ResumenInscripciones}" Foreground="DimGray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Content="Inscribir cliente…" Command="{Binding InscribirCommand}" Margin="15,0,0,0" Padding="10,1" FontWeight="Bold"/>
                        <Button Content="Recargar" Command="{Binding RecargarInscripcionesCommand}" Margin="6,0,0,0" Padding="10,1"/>
                        <Button Content="Anular" Command="{Binding AnularInscripcionCommand}" Margin="6,0,0,0" Padding="10,1"
                                ToolTip="Anula la inscripción sin pagar (o la gratuita) y libera la plaza"/>
                        <Button Content="Confirma asistencia" Command="{Binding ConfirmaAsistenciaCommand}" Margin="6,0,0,0" Padding="10,1"
                                ToolTip="Apunta que el cliente le ha dicho que viene"/>
                        <Button Content="No podrá ir" Command="{Binding NoPodraIrCommand}" Margin="6,0,0,0" Padding="10,1"
                                ToolTip="Apunta que el cliente le ha dicho que no puede ir (no anula la inscripción)"/>
                        <Button Content="Facturar curso" Command="{Binding FacturarCommand}" Margin="6,0,0,0" Padding="10,1"
                                ToolTip="Relanza la facturación del curso (pedido, factura exenta y liquidación) desde donde se quedó"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Inscripciones}" AutoGenerateColumns="False"
                              SelectedItem="{Binding InscripcionSeleccionada}"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" ColumnWidth="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="Caducada">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Facturacion.Estado}" Value="Error">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Facturacion.Estado}" Value="NoAutomatizable">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Vino">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Asistio, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding EntraEnListaAsistencia}"
                                                  ToolTip="Marque a los que han venido al evento"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteContacto}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Asistencia" Binding="{Binding TextoAsistencia}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Base imponible del día" Binding="{Binding BaseImponibleDia, StringFormat=c}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Modalidad" Binding="{Binding TextoModalidad}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pagar hasta" Binding="{Binding FechaLimitePago, StringFormat=dd/MM/yyyy}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pagado" Binding="{Binding ImportePagado, StringFormat=c}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="El" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Factura" Binding="{Binding TextoFacturacion}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding TextoOrigen}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Inscrito por" Binding="{Binding UsuarioCreacion}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Enlace de pago" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UrlPago, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 ToolTip="Seleccione y copie el enlace para mandárselo al cliente"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding MensajeFacturacion}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Marcar pagada a mano: la API no contabiliza nada (el efectivo, a la caja de la tienda) -->
                        <GroupBox Grid.Column="0" Header="Marcar pagada" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPagoPago}" Width="110"/>
                                <xctk:DecimalUpDown Value="{Binding ImportePago}" FormatString="C2" Minimum="0" Width="90" Margin="6,0,0,0"
                                                    ToolTip="Lo que ha pagado (vacío: la señal del evento)"/>
                                <DatePicker SelectedDate="{Binding FechaPagoEdicion}" Width="115" Margin="6,0,0,0"/>
                                <Button Content="Marcar pagada" Command="{Binding MarcarPagadaCommand}" Margin="6,0,0,0" Padding="10,1"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Lista de asistencia" Padding="6" Margin="10,0,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Guardar lista" Command="{Binding GuardarAsistenciaCommand}" Padding="10,1"
                                        FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AvisoListaAsistencia}" TextWrapping="Wrap" Foreground="DimGray" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </xctk:BusyIndicator>
</UserControl>
