<UserControl x:Class="Nesto.Modulos.Cliente.MantenimientoEventosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>

    <xctk:BusyIndicator IsBusy="{Binding EstaOcupado}" BusyContent="Trabajando...">
        <!-- Sugerencia 871 (Pilar, 29/10/26): con ventanas pequeñas el título salía de 2 letras, «Marcar pagada» se descolocaba
             y la lista de inscritos desaparecía. El contenido ocupa la ventana, pero nunca menos de 1000x600: por debajo salen
             barras de desplazamiento en vez de aplastar las columnas y filas en estrella (Width/Height = el hueco visible;
             MinWidth/MinHeight mandan cuando el hueco es menor). -->
        <ScrollViewer x:Name="desplazamiento" Margin="10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="980" MinHeight="580"
              Width="{Binding ViewportWidth, ElementName=desplazamiento}" Height="{Binding ViewportHeight, ElementName=desplazamiento}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="2*" MinHeight="300"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Eventos" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="Nuevo evento" Command="{Binding NuevoCommand}" Padding="15,2" FontWeight="Bold"/>
                <Button DockPanel.Dock="Left" Content="Recargar" Command="{Binding CargarCommand}" Margin="10,0,0,0" Padding="15,2"/>
                <TextBlock Text="Cursos y masterclass de cada tienda. Se inscribe al cliente sin pedido; con la señal pagada tiene la plaza."
                           Foreground="DimGray" VerticalAlignment="Center" Margin="15,0,0,0" TextWrapping="Wrap"/>
            </DockPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Eventos}" AutoGenerateColumns="False"
                      SelectedItem="{Binding Seleccionado}" FrozenColumnCount="2"
                      HorizontalScrollBarVisibility="Auto" MinColumnWidth="40"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="80"/>
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*" MinWidth="220"/>
                    <DataGridTextColumn Header="Horario" Binding="{Binding TextoHorario}" Width="95"/>
                    <DataGridTextColumn Header="Tienda" Binding="{Binding NombreTienda}" Width="90"/>
                    <DataGridTextColumn Header="Plazas" Binding="{Binding TextoPlazas}" Width="60"/>
                    <DataGridTextColumn Header="Señal (reemb. / no reemb.)" Binding="{Binding TextoSenales}" Width="150"/>
                    <DataGridTextColumn Header="Curso" Binding="{Binding ProductoCurso}" Width="100"/>
                    <DataGridTextColumn Header="Ponente" Binding="{Binding Ponente}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Lugar" Binding="{Binding Lugar}" Width="*" MinWidth="110"/>
                    <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="50"/>
                    <DataGridTextColumn Header="Lista pasada" Binding="{Binding FechaListaAsistencia, StringFormat=g}" Width="110"/>
                    <DataGridTextColumn Header="Modificado por" Binding="{Binding Usuario}" Width="130"/>
                    <DataGridTextColumn Header="El" Binding="{Binding FechaModificacion, StringFormat=g}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="480"/>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- Ficha del evento -->
                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,1,1,0" Padding="0,10,10,0"
                        IsEnabled="{Binding Editando}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Nuevo evento" FontWeight="Bold" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Título:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding TituloEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Fecha:" VerticalAlignment="Center" Width="110"/>
                                <DatePicker SelectedDate="{Binding FechaEdicion}" Width="140"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Tienda:" VerticalAlignment="Center" Width="110"/>
                                <ComboBox ItemsSource="{Binding Tiendas}" SelectedItem="{Binding TiendaEdicion}" Width="200"
                                          ToolTip="Obligatoria, también en los online (el ponente emite desde la tienda y la factura lleva su almacén). La mantiene esa tienda, Administración y Dirección"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Formato:" VerticalAlignment="Center" Width="110"/>
                                <ComboBox ItemsSource="{Binding Formatos}" SelectedItem="{Binding FormatoEdicion}" Width="200"
                                          ToolTip="Presencial u online (webinar). Los online también son de una tienda"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Horario:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding HoraInicioEdicion, UpdateSourceTrigger=PropertyChanged}" Width="55" VerticalContentAlignment="Center"
                                         ToolTip="Hora de inicio, como 10:00"/>
                                <TextBlock Text="a" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Text="{Binding HoraFinEdicion, UpdateSourceTrigger=PropertyChanged}" Width="55" VerticalContentAlignment="Center"
                                         ToolTip="Hora de fin, como 13:00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Ponente:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding PonenteEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Señal reembolsable:" VerticalAlignment="Center" Width="110" ToolTip="Factura el curso exento y emite un cupón por el mismo importe"/>
                                <xctk:DecimalUpDown Value="{Binding ImporteSenalEdicion}" FormatString="C2" Minimum="0" Increment="5" Width="110"
                                                    ToolTip="Con cupón por el mismo importe (IVA incluido)"/>
                                <TextBlock Text="No reembolsable:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <xctk:DecimalUpDown Value="{Binding ImporteSenalNoReembolsableEdicion}" FormatString="C2" Minimum="0" Increment="5" Width="110"
                                                    ToolTip="Factura el curso exento, sin cupón. Las dos a 0: evento gratuito"/>
                            </StackPanel>
                            <TextBlock Text="Las dos señales a 0: el evento es gratuito (se apunta quien quiera, sin pagar)." Foreground="DimGray"
                                       TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Margin="110,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Pedido mínimo para usar el cupón (€):" VerticalAlignment="Center" Margin="0,0,5,0"
                                           ToolTip="Importe mínimo de productos (IVA incluido, sin cursos ni portes) del pedido en el que se use el cupón de la señal reembolsable"/>
                                <xctk:DecimalUpDown Value="{Binding PedidoMinimoCuponEdicion}" FormatString="C2" Minimum="0" Increment="50" Width="110"
                                                    ToolTip="0 = con cualquier importe. Se aplica a los cupones que se emitan a partir de ahora"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Referencia curso:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding ProductoCursoEdicion, UpdateSourceTrigger=PropertyChanged}" Width="140" MaxLength="15"
                                         VerticalContentAlignment="Center"
                                         ToolTip="El producto del curso (uno por curso, exento de IVA), con el que se factura"/>
                                <Button Content="Comprobar" Command="{Binding ComprobarProductoCommand}" Margin="6,0,0,0" Padding="8,1"/>
                                <Button Content="Crear referencia" Command="{Binding CrearProductoCursoCommand}" Margin="6,0,0,0" Padding="8,1" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Crea la referencia propia del evento para cada modalidad con importe (EVENTO + número del evento; con NR, la no reembolsable). Primero hay que guardar el evento; si hay escrita otra referencia, bórrela antes."/>
                            </StackPanel>
                            <TextBlock Foreground="DimGray" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="110,2,0,0"
                                       Text="Dos formas: escriba una referencia de curso que ya exista (grupo CUR; varios eventos pueden compartirla) y pulse «Comprobar», o guarde el evento y pulse «Crear referencia» para crear la suya (EVENTO y el número del evento; con «NR», la no reembolsable). Con una referencia escrita, esa sirve para todas las modalidades."/>
                            <TextBlock Text="{Binding NombreProductoCurso}" Foreground="DimGray" TextWrapping="Wrap" MaxWidth="420"
                                       HorizontalAlignment="Left" Margin="110,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Plazas:" VerticalAlignment="Center" Width="110"/>
                                <xctk:IntegerUpDown Value="{Binding PlazasEdicion}" Minimum="1" Width="80"
                                                    ToolTip="Vacío: sin límite de plazas"/>
                                <TextBlock Text="(vacío = sin límite)" Foreground="DimGray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Lugar:" VerticalAlignment="Center" Width="110"/>
                                <TextBox Text="{Binding LugarEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" MaxLength="100"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Descripción:" VerticalAlignment="Top" Width="110"/>
                                <TextBox Text="{Binding DescripcionLargaEdicion, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="70"
                                         MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Imagen:" VerticalAlignment="Top" Width="110"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Width="160" Height="90">
                                    <Grid>
                                        <TextBlock Text="Sin imagen" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ImagenUrl, TargetNullValue={x:Null}}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="6,0,0,0">
                                    <Button Content="Subir imagen…" Command="{Binding SubirImagenCommand}" Padding="8,1"
                                            ToolTip="PNG, JPEG, GIF o WebP de hasta 10 MB. Pueden subirla Tienda online y Dirección"/>
                                    <Button Content="Quitar" Command="{Binding QuitarImagenCommand}" Padding="8,1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Nesto#567 (NestoAPI#732): gratuitos por compra -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Hay que comprar:" VerticalAlignment="Top" Width="110"
                                           ToolTip="Para apuntarse, el cliente tiene que haber comprado o pedido estos productos"/>
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding ProductosRequeridosEdicion}" SelectedItem="{Binding ProductoRequeridoSeleccionado}"
                                             DisplayMemberPath="Texto" Width="320" Height="60"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Text="{Binding ProductoRequeridoNuevo, UpdateSourceTrigger=PropertyChanged}" Width="110" MaxLength="15"
                                                 VerticalContentAlignment="Center" ToolTip="Referencia del producto"/>
                                        <Button Content="Añadir" Command="{Binding AnadirProductoRequeridoCommand}" Margin="6,0,0,0" Padding="8,1"/>
                                        <Button Content="Quitar" Command="{Binding QuitarProductoRequeridoCommand}" Margin="6,0,0,0" Padding="8,1"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding ModosProductosRequeridos}" SelectedItem="{Binding ModoProductosEdicion}" Width="320"
                                              HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Vacía: no exige compra. Con productos, solo se puede apuntar quien los haya comprado o pedido; si se borra el pedido o se le quita la línea, se pregunta y se anula la inscripción. Se guarda con «Guardar»."
                                       Foreground="DimGray" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Margin="110,2,0,0"/>
                            <CheckBox Content="Activo (admite inscripciones y sale al marcar señales)" IsChecked="{Binding ActivoEdicion}" Margin="110,8,0,0"/>
                            <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="110,12,0,0" Padding="20,3"
                                    FontWeight="Bold" HorizontalAlignment="Left"/>
                            <!-- Nesto#545 (NestoAPI#692): qué falta para anunciarlo en las apps (no impide guardar) y anunciar otra vez -->
                            <TextBlock Text="{Binding TextoQueFalta}" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                       Margin="110,6,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                       Visibility="{Binding HayQueFalta, Converter={StaticResource BoolAVisibilidad}}"/>
                            <StackPanel Orientation="Horizontal" Margin="110,8,0,0"
                                        Visibility="{Binding PuedeAnunciarOtraVez, Converter={StaticResource BoolAVisibilidad}}">
                                <Button Content="Anunciar otra vez…" Command="{Binding AnunciarOtraVezCommand}" Padding="8,1"
                                        ToolTip="Vuelve a avisar del evento en NestoApp y en la tienda online, con un reclamo"/>
                                <TextBlock Text="{Binding TextoUltimoAnuncio}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Nesto#517: inscritos del evento seleccionado -->
                <Grid Grid.Column="1" Margin="10,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Inscritos" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding ResumenInscripciones}" Foreground="DimGray" VerticalAlignment="Center" Margin="10,2,15,2"/>
                        <Button Content="Inscribir cliente…" Command="{Binding InscribirCommand}" Margin="0,2,6,2" Padding="10,1" FontWeight="Bold"/>
                        <Button Content="Recargar" Command="{Binding RecargarInscripcionesCommand}" Margin="0,2,6,2" Padding="10,1"/>
                        <Button Content="Anular" Command="{Binding AnularInscripcionCommand}" Margin="0,2,6,2" Padding="10,1"
                                ToolTip="Anula la inscripción sin pagar (o la gratuita) y libera la plaza"/>
                        <Button Content="Confirma asistencia" Command="{Binding ConfirmaAsistenciaCommand}" Margin="0,2,6,2" Padding="10,1"
                                ToolTip="Apunta que el cliente le ha dicho que viene"/>
                        <Button Content="No podrá ir" Command="{Binding NoPodraIrCommand}" Margin="0,2,6,2" Padding="10,1"
                                ToolTip="Apunta que el cliente le ha dicho que no puede ir (no anula la inscripción)"/>
                        <Button Content="Facturar curso" Command="{Binding FacturarCommand}" Margin="0,2,6,2" Padding="10,1"
                                ToolTip="Relanza la facturación del curso (pedido, factura exenta y liquidación) desde donde se quedó"/>
                        <Button Content="Copiar enlace" Command="{Binding CopiarEnlaceCommand}" Margin="0,2,6,2" Padding="10,1"
                                ToolTip="Copia el enlace de pago de la inscripción seleccionada para reenviárselo al cliente"/>
                    </WrapPanel>

                    <!-- Nesto#572 (sugerencias 902 de Pilar y 862 de Reina): antes era una rejilla de ~20 columnas que salían
                         estrechísimas. Ahora cada inscrito es una tarjeta con lo básico; la seleccionada se despliega con todo el
                         detalle (el detalle solo se crea al desplegar, como antes la edición de la celda «Asiste»). -->
                    <ListBox x:Name="listaInscritos" Grid.Row="1" ItemsSource="{Binding Inscripciones}"
                             SelectedItem="{Binding InscripcionSeleccionada}" SelectionMode="Single" MinHeight="90"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False" BorderBrush="LightGray" Padding="4">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar enlace de pago" Command="{Binding CopiarEnlaceCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="Caducada">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Facturacion.Estado}" Value="Error">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Facturacion.Estado}" Value="NoAutomatizable">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Lo básico: siempre a la vista -->
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Left" Content="Vino" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  IsChecked="{Binding Asistio, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding EntraEnListaAsistencia}"
                                                  ToolTip="Marque a los que han venido al evento (se guarda con «Guardar lista»)"/>
                                        <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Content="Copiar enlace" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.CopiarEnlaceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding UrlPago}"
                                                Visibility="{Binding TieneEnlacePago, Converter={StaticResource BoolAVisibilidad}}"/>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Nombre, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding ClienteContacto, Mode=OneWay}" Foreground="DimGray"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Desplegada}" Padding="6,0" Margin="8,0,0,0"
                                                      VerticalAlignment="Top">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="Ver detalle"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="Ocultar detalle"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <TextBlock Text="{Binding TextoResumen}" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- El detalle: solo en la tarjeta desplegada -->
                                    <ContentControl Content="{Binding}" Focusable="False">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Desplegada}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                                                        <Grid>
                                                                            <Grid.Resources>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Margin" Value="0,2,0,2"/>
                                                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                                </Style>
                                                                                <!-- Para poder seleccionar y copiar (el correo, la dirección...) -->
                                                                                <Style x:Key="TextoCopiable" TargetType="TextBox">
                                                                                    <Setter Property="IsReadOnly" Value="True"/>
                                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                    <Setter Property="Padding" Value="0"/>
                                                                                    <Setter Property="Margin" Value="-2,2,0,2"/>
                                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                                </Style>
                                                                            </Grid.Resources>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <!-- Contacto: lo que Reina usa para encontrar a la clienta cuando viene en persona -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Correo:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Correo, Mode=OneWay}" Style="{StaticResource TextoCopiable}"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dirección:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Direccion, Mode=OneWay}" Style="{StaticResource TextoCopiable}"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Asiste:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <!-- Nesto#566 (NestoAPI#731): la persona que asiste se elige entre las personas de contacto -->
                                                                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PersonasDisponibles}" DisplayMemberPath="Texto"
                                                                                      SelectedValuePath="Numero" Margin="0,2,8,2" MaxWidth="320" HorizontalAlignment="Left" MinWidth="180"
                                                                                      SelectedValue="{Binding NumeroPersonaAsiste, UpdateSourceTrigger=PropertyChanged}"
                                                                                      ToolTip="La persona de contacto que asiste (se guarda al elegirla)"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Teléfono:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding TelefonoPersona, Mode=OneWay}" Style="{StaticResource TextoCopiable}"/>

                                                                            <!-- Inscripción y pago -->
                                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Modalidad:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TextoModalidad}"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Forma de pago:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding FormaPago}"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pagar hasta:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FechaLimitePago, StringFormat=dd/MM/yyyy}"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Pagado:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="3">
                                                                                <Run Text="{Binding ImportePagado, StringFormat=c, Mode=OneWay}"/>
                                                                                <Run Text="{Binding FechaPago, StringFormat='el {0:dd/MM/yyyy}', Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Factura:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TextoFacturacion}"/>
                                                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Base imponible del día:" Foreground="DimGray" Margin="0,2,8,2"
                                                                                       ToolTip="Lo que ha comprado el cliente el día del evento en Reina o Alcobendas (sin el curso)"/>
                                                                            <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding BaseImponibleDia, StringFormat=c}"/>

                                                                            <!-- De dónde viene -->
                                                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Origen:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TextoOrigen}"/>
                                                                            <TextBlock Grid.Row="6" Grid.Column="2" Text="Inscrito por:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding TextoInscritoPor}"/>
                                                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pedido que lo justifica:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PedidoJustificante}"/>
                                                                            <TextBlock Grid.Row="7" Grid.Column="2" Text="Enlace de pago:" Foreground="DimGray" Margin="0,2,8,2"/>
                                                                            <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding UrlPago, Mode=OneWay}" Style="{StaticResource TextoCopiable}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock Text="{Binding MensajeFacturacion}" Foreground="#C62828" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AvisoEnlace}" Foreground="#1B5E20" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Sugerencia 871: antes iban lado a lado y, en ventanas pequeñas, el texto de la lista de asistencia se
                         partía letra a letra y estiraba «Marcar pagada» hasta tapar la lista de inscritos. Ahora uno debajo
                         de otro y con los controles centrados (no se estiran). -->
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <!-- Marcar pagada a mano: la API no contabiliza nada (el efectivo, a la caja de la tienda) -->
                        <GroupBox Header="Marcar pagada" Padding="6,3">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPagoPago}" Width="120"
                                          VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <xctk:DecimalUpDown Value="{Binding ImportePago}" FormatString="C2" Minimum="0" Width="95"
                                                    VerticalAlignment="Center" Margin="0,2,6,2"
                                                    ToolTip="Lo que ha pagado (vacío: la señal del evento)"/>
                                <DatePicker SelectedDate="{Binding FechaPagoEdicion}" Width="120" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <Button Content="Marcar pagada" Command="{Binding MarcarPagadaCommand}" Padding="10,1"
                                        VerticalAlignment="Center" Margin="0,2,6,2"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="Lista de asistencia" Padding="6,3" Margin="0,6,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Guardar lista" Command="{Binding GuardarAsistenciaCommand}" Padding="10,1"
                                        FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AvisoListaAsistencia}" TextWrapping="Wrap" Foreground="DimGray" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        </ScrollViewer>
    </xctk:BusyIndicator>
</UserControl>
