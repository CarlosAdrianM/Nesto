<UserControl x:Class="Nesto.Modulos.Cliente.NotaCobroDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             MinWidth="820" MinHeight="520"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="El repartidor pasa por el cliente solo a cobrar: la nota no lleva bultos, no pasa por picking ni packing y no se imprime en Facturar rutas."/>

        <!-- Cliente y contacto (propuestos del pedido o de la ficha) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding SinCrear}">
            <TextBlock Text="Cliente:" Width="70" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalContentAlignment="Center"/>
            <TextBlock Text="Contacto:" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalContentAlignment="Center"
                     ToolTip="La dirección a la que va el repartidor. Vacío: la del primer efecto marcado"/>
            <TextBlock Text="{Binding NombreCliente}" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Recargar" Command="{Binding RecargarCommand}" Margin="12,0,0,0" Padding="8,1"
                    ToolTip="Volver a leer lo pendiente del cliente"/>
        </StackPanel>

        <!-- Extracto pendiente (empresas 1 y 3): se marcan los efectos en el orden en que se cobran -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Efectos}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" MinHeight="180"
                  IsEnabled="{Binding SinCrear}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Cobrar">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcado, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Orden" Binding="{Binding TextoOrden}" IsReadOnly="True" FontWeight="Bold"/>
                <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=d}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Efecto" Binding="{Binding Efecto}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding Vencimiento, StringFormat=d}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=c}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Pendiente" Binding="{Binding ImportePendiente, StringFormat=c}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="F. Pago" Binding="{Binding FormaPago}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding TextoMarcados}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <!-- Importe, día y comentario -->
        <StackPanel Grid.Row="5" IsEnabled="{Binding SinCrear}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Importe:" Width="70" VerticalAlignment="Center"/>
                <xctk:DecimalUpDown x:Name="txtImporte" Value="{Binding Importe, UpdateSourceTrigger=PropertyChanged}" FormatString="N2"
                                    CultureInfo="es-ES" Width="120" TextAlignment="Right" Minimum="0"
                                    PreviewTextInput="Importe_PreviewTextInput"
                                    ToolTip="Lo que tiene que cobrar el repartidor. Se propone lo pendiente de los efectos marcados; si pone más, lo que sobre va a cuenta"/>
                <TextBlock Text="€" Margin="4,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Día del cobro:" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding Fecha}" DisplayDateStart="{Binding Hoy, Mode=OneWay}" Width="130"
                            ToolTip="El día en que el repartidor pasa a cobrar (desde ese día sale en el reparto)"/>
                <TextBlock Text="Repartidor:" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Repartidores}" SelectedItem="{Binding Repartidor}" DisplayMemberPath="Nombre" Width="140"
                          ToolTip="Quién va a cobrarla: solo a él le sale en «Mis envíos» de Ariadna"/>
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Comentario:" Width="70" VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBox Text="{Binding Comentario, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap"
                         AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto"
                         ToolTip="Para el repartidor (p. ej. «Pasar por la tarde»)"/>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding MotivoNoCrear}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding SinCrear, Converter={StaticResource BoolAVisibilidad}}"/>

        <!-- Tras crear: el resultado -->
        <Border Grid.Row="7" Margin="0,8,0,0" Padding="8" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                Visibility="{Binding Creada, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
                <TextBlock Text="{Binding TextoCreada}" FontWeight="Bold" Foreground="#1B5E20" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NotaCreada.Texto}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="8" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- El error de la API, tal cual -->
            <TextBlock Grid.Column="0" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Crear" Command="{Binding CrearCommand}" Width="90" Margin="0,0,10,0" IsDefault="True" FontWeight="Bold"/>
                <Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="90" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
