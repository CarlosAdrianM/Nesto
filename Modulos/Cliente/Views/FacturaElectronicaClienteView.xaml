<UserControl x:Class="Nesto.Modulos.Cliente.FacturaElectronicaClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="800"
             Background="White">
    <!-- Nesto#652 (NestoAPI#903): los códigos DIR3 del organismo (cliente y contacto) para la factura electrónica de FACe.
         Solo Administración, Dirección e Informática. Lee la API al enseñarse y al cambiar de cliente. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <GroupBox x:Name="Raiz" Header="Factura electrónica (FACe): códigos DIR3 del organismo" Margin="3" Padding="6"
              Visibility="{Binding PuedeVer, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
            <TextBlock Text="{Binding Ayuda, Mode=OneTime}" TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Oficina contable:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OficinaContable, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" Margin="0,1"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Nombre:" Style="{StaticResource Etiqueta}" Margin="10,2,8,2"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding NombreOficinaContable, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,1"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Órgano gestor:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OrganoGestor, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" Margin="0,1"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Nombre:" Style="{StaticResource Etiqueta}" Margin="10,2,8,2"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NombreOrganoGestor, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,1"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unidad tramitadora:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UnidadTramitadora, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" Margin="0,1"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Nombre:" Style="{StaticResource Etiqueta}" Margin="10,2,8,2"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding NombreUnidadTramitadora, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,1"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Órgano proponente:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OrganoProponente, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" Margin="0,1"
                         ToolTip="Opcional"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Nombre:" Style="{StaticResource Etiqueta}" Margin="10,2,8,2"/>
                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding NombreOrganoProponente, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,1"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="12,2" Margin="0,0,8,0"/>
                <Button Content="Quitar" Command="{Binding QuitarCommand}" Padding="12,2"
                        ToolTip="Quita los códigos DIR3 de este cliente y contacto"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="#B71C1C" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HayError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Mensaje}" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HayMensaje, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
