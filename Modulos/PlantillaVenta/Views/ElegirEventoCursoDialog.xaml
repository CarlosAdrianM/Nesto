<UserControl x:Class="ElegirEventoCursoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" MinHeight="320"
             Background="White">
    <!-- Nesto#543: al meter un curso se elige el evento (si hay varios) y siempre la modalidad. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSi" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Producto}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Elija el evento al que se apunta la clienta:"
                   Visibility="{Binding HayVariosEventos, Converter={StaticResource VisibleSi}}"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding Eventos}"
                 SelectedItem="{Binding EventoSeleccionado, Mode=TwoWay}"
                 MinHeight="60">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding TextoFechaHora}" FontWeight="Bold" Width="120"/>
                        <TextBlock Text="{Binding NombreTienda}" Width="90"/>
                        <TextBlock Text="{Binding TextoFormato}" Width="80"/>
                        <TextBlock Text="{Binding TextoPlazas}" Foreground="DimGray" Width="100"/>
                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="Elija la modalidad:" Margin="0,12,0,6"/>

        <ListBox Grid.Row="4" ItemsSource="{Binding Modalidades}"
                 SelectedItem="{Binding ModalidadSeleccionada, Mode=TwoWay}"
                 DisplayMemberPath="Texto" MinHeight="50"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Aceptar" Command="{Binding AceptarCommand}" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
