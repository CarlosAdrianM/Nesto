<UserControl x:Class="CopiarSeguimientosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:ControlesUsuario;assembly=ControlesUsuario"
        Width="450" MinHeight="300" Background="White">
    <!-- Novedad 732 (Sancho, 22/10/26): sin maximizar no se veía el botón Copiar. La ventana nace ajustada al
         contenido con un tope de alto (VentanaDialogo); cuando el contenido no cabía, todas las filas eran Auto y los
         botones se quedaban fuera. Ahora el contenido variable va en un ScrollViewer (fila *) y los botones en su
         propia fila Auto, siempre visibles. Cada selector de cliente lleva tope de alto (como en RapportView) para que
         su lista de resultados se desplace dentro en vez de estirar la ventana. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="rootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Copiar seguimientos a otro cliente"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <!-- Cliente origen -->
        <GroupBox Header="Cliente origen" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Cliente:" Style="{StaticResource LabelStyle}"/>
                <controles:SelectorCliente
                    Empresa="{Binding DataContext.Empresa, ElementName=rootGrid, Mode=TwoWay}"
                    Cliente="{Binding DataContext.ClienteOrigen, ElementName=rootGrid, Mode=TwoWay}"
                    Contacto="{Binding DataContext.ContactoOrigen, ElementName=rootGrid, Mode=TwoWay}"
                    ClienteCompleto="{Binding DataContext.ClienteCompletoOrigen, ElementName=rootGrid, Mode=TwoWay}"
                    MaxHeight="260" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Cliente destino -->
        <GroupBox Header="Cliente destino" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Cliente:" Style="{StaticResource LabelStyle}"/>
                <controles:SelectorCliente
                    Empresa="{Binding DataContext.Empresa, ElementName=rootGrid, Mode=TwoWay}"
                    Cliente="{Binding DataContext.ClienteDestino, ElementName=rootGrid, Mode=TwoWay}"
                    Contacto="{Binding DataContext.ContactoDestino, ElementName=rootGrid, Mode=TwoWay}"
                    ClienteCompleto="{Binding DataContext.ClienteCompletoDestino, ElementName=rootGrid, Mode=TwoWay}"
                    MaxHeight="260" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Opciones -->
        <GroupBox Header="Opciones" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <CheckBox Content="Mover seguimientos (eliminar del origen tras copiar)"
                          IsChecked="{Binding EliminarOrigen}"
                          VerticalContentAlignment="Center"
                          ToolTip="Si se marca, los seguimientos se eliminan del origen después de copiarlos al destino"/>
            </StackPanel>
        </GroupBox>

        <!-- Resultado -->
        <GroupBox Header="Resultado" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBox Text="{Binding Mensaje, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         ToolTip="Seleccione el texto y pulse Ctrl+C para copiar"/>
            </StackPanel>
        </GroupBox>

        </StackPanel>
        </ScrollViewer>

        <!-- Progreso -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="5" Margin="0,10,0,0"
                     Visibility="{Binding EstaProcesando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Botones: fuera del ScrollViewer, siempre a la vista -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Copiar" Command="{Binding EjecutarCommand}"
                    Width="100" Height="35" Margin="0,0,10,0"/>

            <Button Content="Cerrar" Command="{Binding CerrarCommand}"
                    Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</UserControl>
